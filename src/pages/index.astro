---
import { getMaps } from '../lib/maps';
import { getNewMaps, getUpdatedMaps, getHotMaps } from '../lib/map-dates';
import { getUpdateFeed } from '../lib/update-feed';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapCard from '../components/MapCard.astro';
import MapListRow from '../components/MapListRow.astro';
import ListExpiry from '../components/ListExpiry.astro';
import UpdateFeed from '../components/UpdateFeed.astro';

const maps = await getMaps();
/* 最近改动：全量拿回来，组件只渲染前 8 条，剩下的靠「加载更多」按需拉 */
const feed = await getUpdateFeed();

const featured = maps.filter((m) => m.data.featured);

const totalEntities = maps.reduce((a, m) => a + (m.data.entityCount ?? 0), 0);
const previewable = maps.filter((m) => m.data.entitySlug).length;

/*
 * 三个版块各取前 6 条做预览，完整名单在各自的标签页里（/new/、/updates/、/hot/）。
 * 注意「新增地图」和「最新更新」是两件事：
 *   新增地图 —— 工坊最近 30 天**发布**的图
 *   最新更新 —— 本站**资料**最近 30 天被改过的图（来自 git 提交）
 * 改动前这里只有一个「最新更新」，用的还是工坊的 lastUpdated（工坊更新），名不副实。
 */
const HOME_ROWS = 6;
const newMaps = (await getNewMaps()).slice(0, HOME_ROWS);
const updatedMaps = (await getUpdatedMaps()).slice(0, HOME_ROWS);
const popular = await getHotMaps(HOME_ROWS);

// 热门标签统计
const tagCount: Record<string, number> = {};
for (const m of maps) {
  for (const t of m.data.tags) {
    tagCount[t] = (tagCount[t] ?? 0) + 1;
  }
}
const hotTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);
---

<BaseLayout>
  <section class="hero hero-bg">
    <div class="hero-bg-layer"></div>
    <div class="hero-bg-overlay"></div>
    <div class="container hero-content">
      <div class="hero-badge">Community · Zombie Escape</div>
      <h1 class="hero-title">
        <span class="gradient-text">ZE 地图</span>资料站
      </h1>
      <p class="hero-sub">
        僵尸逃跑地图中文资料库 · 背景故事 · 通关流程 · 神器攻略
      </p>
      <div class="hero-stats">
        <div class="stat">
          <strong data-count={maps.length}>{maps.length}</strong>
          <span>地图收录</span>
        </div>
        <div class="stat">
          <strong data-count={totalEntities}>{totalEntities.toLocaleString('en-US')}</strong>
          <span>实体点位</span>
        </div>
        <div class="stat">
          <strong data-count={hotTags.length}>{hotTags.length}</strong>
          <span>热门标签</span>
        </div>
      </div>
    </div>
    {/* 本页内跳转：target="_self" 覆盖 <base target="_blank">，否则会新开一个同样的首页 */}
    <a href="#featured" class="hero-scroll" target="_self">向下滚动 ↓</a>
  </section>

  <div class="container">
    <section id="entity-preview">
      <div class="section-head">
        <h2>实体预览</h2>
        <a href="/preview/">打开预览工具 →</a>
      </div>
      <a class="entity-cta" href="/preview/" target="_blank" rel="noopener" title="在新标签页打开实体预览">
        <span class="ec-t">🧊 3D / 平面双视图查看地图实体（含真实碰撞地形）</span>
        <span class="ec-d">
          收录 {previewable} 张 CS2 地图的实体数据：传送门、可破坏物、机关、危险区、路径点与关卡分层，
          支持按高度着色、剖切、关卡过滤与单点详情（属性 / 触发连线）；3D 视图可叠加从创意工坊地图包解析出的
          <b>真实碰撞地形</b>，看清地图的墙与地面。
        </span>
        <span class="ec-go">进入实体预览 ↗</span>
      </a>
    </section>

    {featured.length > 0 && (
      <section id="featured">
        <div class="section-head">
          <h2>精选地图</h2>
          <a href="/maps/">查看全部 →</a>
        </div>
        <div class="map-grid">
          {featured.map((map) => <MapCard map={map} />)}
        </div>
      </section>
    )}

    {hotTags.length > 0 && (
      <section>
        <div class="section-head">
          <h2>热门标签</h2>
          <a href="/tags/">全部标签 →</a>
        </div>
        {/* data-pagefind-ignore：这一排是标签名清单，忽略后搜某张图不会被首页截胡
            （精选地图那排卡片由 MapCard 自己忽略）。 */}
        <div class="hot-tags" data-pagefind-ignore>
          {hotTags.map(([tag, count]) => (
            <a class="hot-tag" href={`/tags/${tag}/`}>
              <span class="hot-tag-name">{tag}</span>
              <span class="hot-tag-count">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {newMaps.length > 0 && (
      <section>
        <div class="section-head">
          <h2>新增地图</h2>
          <a href="/new/">查看全部 →</a>
        </div>
        <div class="list-rows">
          {newMaps.map((it) => <MapListRow map={it.map} date={it.date} dateLabel="发布" />)}
        </div>
      </section>
    )}

    {updatedMaps.length > 0 && (
      <section>
        <div class="section-head">
          <h2>最新更新</h2>
          <a href="/updates/">查看全部 →</a>
        </div>
        <div class="list-rows">
          {updatedMaps.map((it) => <MapListRow map={it.map} date={it.date} dateLabel="改动" />)}
        </div>
      </section>
    )}

    {popular.length > 0 && (
      <section>
        <div class="section-head">
          <h2>工坊热门</h2>
          <a href="/hot/">查看全部 →</a>
        </div>
        <div class="list-rows">
          {
            popular.map((m, i) => (
              <MapListRow
                map={m}
                rank={i + 1}
                note={`订阅 ${(m.data.workshopSubs ?? 0).toLocaleString('en-US')}`}
              />
            ))
          }
        </div>
      </section>
    )}

    {maps.length === 0 && (
      <div class="empty-state">
        <p>还没有地图。去 <code>src/content/maps/</code> 里添加第一张吧。</p>
      </div>
    )}

    {/*
      最近改动（逐条）：哪张图的哪一部分被改过 —— 社区投稿来自 data/community 的 log，
      本站整理的资料来自 git 历史（见 src/lib/update-feed.ts）。
      放最后一块（页脚之上）：它是「流水账」，来看地图的人不必先翻过它。
      「加载更多」按需拉 /updates/feed.json，不占首屏体积。
    */}
    <UpdateFeed
      items={feed}
      pageSize={8}
      heading="最近改动"
      lede="哪张图的哪一部分被改过：社区投稿逐条署名，本站整理的资料按 git 历史列出。改完要等下一次构建上线（通常几分钟）。"
    />
  </div>

  <script>
    // 数字滚动动画
    function animateCount(el: HTMLElement, target: number, duration = 1200) {
      const start = performance.now();
      function tick(now: number) {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const counters = document.querySelectorAll('[data-count]');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count ?? 0);
            animateCount(el, target);
            io.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((el) => io.observe(el));
  </script>

  {/* 主页也要按访问者本机时间再筛一次：否则站点两个月没重新部署的话，
      主页还挂着已经过期的条目，而 /new/ 页早已空了。 */}
  <ListExpiry />
</BaseLayout>
