---
import BaseLayout from '../layouts/BaseLayout.astro';
import QqGroup from '../components/QqGroup.astro';
import { FIELD_RULES } from '../../shared/submission-fields.mjs';

/*
 * 字段表直接从 shared/submission-fields.mjs 生成 —— 那份定义同时驱动
 * 投稿表单、Worker 的服务端校验和这里。手抄一张表迟早会跟实际能填的对不上。
 */
const R = FIELD_RULES as Record<
  string,
  {
    kind: string;
    label: string;
    hint?: string;
    values?: string[];
    max?: number;
    maxLen?: number;
    min?: number;
    append?: boolean;
  }
>;

const canFill = (r: (typeof R)[string]) => {
  switch (r.kind) {
    case 'enum':
      return (r.values ?? []).join(' / ');
    case 'tags':
      return `每行一个，最多 ${r.max} 个，每个最多 ${r.maxLen} 字`;
    case 'urlList':
      return `每行一个 https 链接，最多 ${r.max} 条`;
    case 'int':
      return `${r.min} ~ ${r.max} 的整数`;
    case 'image':
      return '一张图：浏览器里自动裁成 16:9、压成 webp（上限 700 KB）再上传，不用自己处理';
    case 'gallery':
      return '可一次选多张游戏内截图：浏览器里压成 webp（单张上限 1.5 MB）再上传，每张能单独写一句说明';
    case 'itemlist':
      return '一件一行：填道具名 + 冷却秒 + 次数（后两项留空表示不改这一项）。名字选条目页表里的写法就是更正，表里没有的就是新增，不用自己选';
    default:
      return `最多 ${r.maxLen} 字`;
  }
};

/* 合并规则的一句话说明。带 key：简介（summary）虽然是 longtext，口径却和其它正文不同 */
const mergeNote = (key: string, r: (typeof R)[string]) =>
  r.append
    ? '追加合并，不会顶掉已有的'
    : r.kind === 'tags'
      ? '整组替换'
      : r.kind === 'image'
        ? '替换当前人工封面（渲染图仍在，删掉人工封面即回退）'
        : r.kind === 'gallery'
          ? '追加进条目的「图片集」，署你的昵称；不会顶掉已有的图'
          : r.kind === 'itemlist'
            ? '逐行合并：按道具名对上号，服务器配置的原值会保留在表格备注里'
            : r.kind === 'longtext'
              ? key === 'summary'
                ? '只补空白：本站还没写简介的图，你投的就是它正文开头那段；已经有本站简介的图不接受覆盖（投稿页会直接拦住，请改投「背景故事」或「补充说明」）'
                : '作为新的一条正文（署你的昵称），不覆盖本站整理的正文；投过一次之后可以在投稿页右侧点「修订这条」改它 —— 替换正文，署名仍记原作者'
              : '';

const fieldRows = Object.entries(R).map(([key, r]) => ({
  key,
  label: r.label,
  can: canFill(r),
  hint: r.hint ?? '',
  merge: mergeNote(key, r),
}));
---

<BaseLayout
  title="投稿指南 | ZE 地图资料站"
  description="怎么给 ZE 地图资料站补充资料：网页表单（不用 GitHub 账号）、提 issue、提 PR、换封面，以及提交之后会发生什么。"
>
  <section class="hero" style="padding: 70px 0 24px;">
    <div class="container">
      <h1 class="hero-title" style="font-size: clamp(32px, 5vw, 52px);">
        投稿<span class="gradient-text">指南</span>
      </h1>
      <p class="hero-sub">
        补充剧情、难度、作者、神器、攻略视频、封面 —— <b>不会写代码、没有 GitHub 账号都能投</b>
      </p>
    </div>
  </section>

  <div class="container" style="padding-bottom: 70px;">
    <article class="doc">
      <h2>先选一条路</h2>
      <p>照着这张表挑，不用全看：</p>
      <table class="doc-table">
        <thead>
          <tr>
            <th>你想做的事</th>
            <th>走哪条</th>
            <th>要 GitHub 账号吗</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>给某张图补 / 改资料（难度、标签、作者、<b>神器 / 道具</b>、视频、来源…）</td>
            <td><a href="#form" target="_self">① 网页表单</a></td>
            <td><b>不用</b></td>
          </tr>
          <tr>
            <td>有一大段<b>背景故事</b>想交</td>
            <td><a href="#form" target="_self">① 网页表单</a>（选「背景故事」）</td>
            <td><b>不用</b></td>
          </tr>
          <tr>
            <td>有这张图的<b>游戏内截图</b>，想放进条目的「图片集」</td>
            <td><a href="#form" target="_self">① 网页表单</a>（选「图片集图片」，可一次选多张）</td>
            <td><b>不用</b></td>
          </tr>
          <tr>
            <td>一次说好几件事，或者一整段攻略</td>
            <td><a href="#issue" target="_self">② 提 issue</a></td>
            <td>要（注册免费）</td>
          </tr>
          <tr>
            <td>想直接改文件，或者一次改很多张图</td>
            <td><a href="#pr" target="_self">③ 提 PR</a></td>
            <td>要</td>
          </tr>
          <tr>
            <td>想给某张图换封面（要传图片）</td>
            <td><a href="#cover" target="_self">④ 传封面</a>，或把图发给站长代传</td>
            <td>要（注册免费，<b>且必须先 Fork</b>）</td>
          </tr>
          <tr>
            <td>什么都不想学，把东西发过来就行</td>
            <td><a href="#contact" target="_self">⑤ 找站长</a></td>
            <td><b>不用</b></td>
          </tr>
        </tbody>
      </table>

      <h2>动手之前，先认清两件事</h2>

      <h3>1. 「地图英文名」是什么</h3>
      <p>
        就是<b>地图详情页标题下面那行小字</b>，也是网址里 <code>/maps/</code> 后面那一段，
        例如 <code>ze_obj_abyss_v2</code>、<code>ze_ffvii_mako_reactor</code>。
        下面所有操作都要用到它，<b>不是</b> Steam 的分片名（<code>2001-ze_xxx-123456</code> 那种）。
      </p>

      <h3>2. 「原稿」和「打印稿」，只能改原稿</h3>
      <table class="doc-table">
        <thead>
          <tr>
            <th></th>
            <th>文件</th>
            <th>能不能改</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>✅ 原稿</td>
            <td><code>data/research/&lt;地图英文名&gt;.json</code></td>
            <td><b>改这里</b>，网站从它生成条目内容</td>
          </tr>
          <tr>
            <td>❌ 打印稿</td>
            <td><code>src/content/maps/&lt;地图英文名&gt;.mdx</code></td>
            <td>脚本<b>自动生成</b>的，手改会被整段覆盖（真发生过好几次）</td>
          </tr>
        </tbody>
      </table>
      <p>
        所有 <code>.mdx</code> 都由脚本生成。包含路线图等富内容的页面也从对应的
        <code>data/research/</code> JSON 中生成；需要修正资料时只改 JSON。
      </p>
      <div class="doc-note">
        拿不准该改哪儿？直接用 <a href="#form" target="_self">① 网页表单</a> 或
        <a href="#issue" target="_self">② 提 issue</a>，
        <b>不需要你判断文件</b>，站长会处理。
      </div>

      <h2 id="form">① 网页表单（最省事，不用账号）</h2>
      <ol>
        <li>
          打开<b>地图库</b>找到那张图 → 进详情页 → 看右侧栏的「<b>补充 / 纠错</b>」，
          点 <b>✏️ 补充这张图的资料</b>。
          <br />
          或者直接打开 <a href="/submit/">投稿表单</a>，在里面输地图名（中文名也行）也能进。
        </li>
        <li>
          在「<b>要提交哪一项</b>」里选这次要补什么 —— <b>一次只能提交一项</b>，
          要补好几项就提交几次。
        </li>
        <li>
          填内容。左侧表单旁边有一栏「<b>这张图现在的内容</b>」：基本信息、神器表、本站正文、
          已经通过的社区投稿都在里面，照着改不容易出错。
          <br />
          正文类那几项（背景故事 / 攻略讲解 / 补充说明）<b>还能改已经通过的那一条</b>：
          在右侧点那条的「<b>修订这条</b>」，正文会带进表单，提交后是<b>替换</b>它 ——
          署名仍记原作者，条目页会标出是谁修订的。
          <br />
          下面的「理由 / 来源」和「你的昵称」都是选填，但<b>来源很重要</b>（见下）。
        </li>
        <li>点提交。会给你一个<b>投稿编号</b>，凭它可以在表单页下面查审核状态。</li>
      </ol>

      <h3>表单里能填什么</h3>
      <p>下面这张表由站点的字段定义直接生成，和表单、服务器校验是同一份，所以不会对不上：</p>
      <table class="doc-table">
        <thead>
          <tr>
            <th>字段</th>
            <th>能填什么</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {
            fieldRows.map((f) => (
              <tr>
                <td>{f.label}</td>
                <td>{f.can}</td>
                <td>
                  {f.hint}
                  {f.merge ? <><br /><span style="color: var(--muted); font-size: 12.5px">{f.merge}</span></> : null}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2 id="issue">② 提 issue（会填表就行）</h2>
      <p>
        适合「一次说好几件事」或者「有一整段攻略想交」：<b>不用改任何文件</b>，填空就行。
      </p>
      <ol>
        <li>
          注册并登录 GitHub（免费），打开仓库
          <a href="https://github.com/hhjjdsj/ze-map-site" target="_blank" rel="noopener">hhjjdsj/ze-map-site</a>
        </li>
        <li>
          点上方 <b>Issues</b> → 右侧绿色按钮
          <a href="https://github.com/hhjjdsj/ze-map-site/issues/new/choose" target="_blank" rel="noopener"
            >New issue</a
          >
        </li>
        <li>
          选模板 <b>补充地图资料</b>，按格子填：<b>地图名</b>（中文名也行）、
          <b>想补充哪方面</b>（可多选）、<b>具体内容</b>、<b>来源链接</b>、<b>署名</b>
        </li>
        <li>点 <b>Create</b> 提交，等站长处理</li>
      </ol>
      <p>
        其它模板：<b>报告网站问题</b>（页面报错、链接失效、显示错乱）、<b>其它建议</b>。
      </p>

      <h2 id="pr">③ 提 PR（直接改文件，全程网页操作）</h2>
      <p>适合熟悉 GitHub 的人，或者想一次改很多张图。</p>
      <ol>
        <li>
          在仓库里找到 <code>data/research/&lt;地图英文名&gt;.json</code>，点开它
        </li>
        <li>点右上角的<b>铅笔图标</b>（Edit this file）</li>
        <li>改字段（能填什么见上面那张表；难度只有 入门/简单/普通/困难/火星/入土/未知 七种）</li>
        <li>滚到页面底部，写一句「改了什么」，点 <b>Propose changes</b></li>
        <li>下一页点 <b>Create pull request</b>，再点一次确认</li>
      </ol>
      <p>
        GitHub 会自动帮你复制一份仓库、开好分支，<b>fork / branch 这些概念你都不用管</b>。
        提交后仓库会自动跑一遍检查，<b>结果直接显示在 PR 页面上</b>，有问题会告诉你哪里不对。
        JSON 每个字段的详细写法（含填空模板的样子）见
        <a
          href="https://github.com/hhjjdsj/ze-map-site/blob/main/data/research/README.md"
          target="_blank"
          rel="noopener">data/research/README.md</a
        >。
      </p>
      <div class="doc-note warn">
        <p>
          <b>用这种方式改，只改 JSON 就够了，不用管地图条目文件。</b>
          条目（<code>src/content/maps/&lt;地图英文名&gt;.mdx</code>）是脚本从资料打印出来的，
          但线上构建时会用资料<b>重新生成</b> —— 所以你的资料一定生效，检查会放行。
        </p>
        <p>
          <b>别手工编辑条目文件。</b> 检查会用资料重新生成一遍，发现「你动了条目、却没动资料或烘焙数据」
          就判红 —— 那是手改打印稿，下次构建会被覆盖。
        </p>
        <p>
          想让仓库里的打印稿也同步（可选）：<code>npm run maps:generate</code>，把
          <code>src/content/maps/</code> 下的改动一起提交。不想碰这些文件的话，用 ① 的表单也一样。
        </p>
      </div>

      <div class="doc-note warn">
        <p>
          <b>JSON 的标点很严格</b>，这是新手最容易翻车的地方：
        </p>
        <ul>
          <li>每个字段末尾要有英文逗号 <code>,</code>（<b>最后一行不要</b>）</li>
          <li>引号要成对，用英文双引号 <code>"</code>，不能用中文引号 <code>“</code></li>
          <li>字段名后面是<b>冒号</b>，写成 <code>"sources"[</code> 就错了</li>
          <li>
            字段名拼错（比如把 <code>author</code> 写成 <code>awthor</code>）语法上没问题，
            但<b>那条内容会静默消失</b> —— 现在检查会把它抓出来并提示正确写法
          </li>
        </ul>
        <p>不确定就少改一点，或者改用 ① 的表单。</p>
      </div>

      <h2 id="cover">④ 换地图封面（要传图片）</h2>
      <div class="doc-note">
        <p>
          <b>推荐：直接在投稿页传，不用 GitHub 账号。</b>
          在<b>地图详情页右侧栏</b>点「✏️ 补充这张图的资料」→ 在「要提交哪一项」里选
          <b>地图封面</b> → 选一张图。图片会在你的浏览器里<b>自动裁成 16:9、压成 webp</b>（通常几十 KB）再上传，
          站长审核通过、写回仓库后就会替换成这张，和本站其它社区内容一样。
        </p>
      </div>
      <p>
        地图封面默认是脚本从地图数据渲染的（俯视密度图 + 实体点）。觉得某张图有更好看的封面，可以换成自己的图。
        这张图会同时用在两处：<b>地图库卡片</b>（16:9 画幅）和<b>详情页顶部</b>（满宽背景大图，上面压了一层暗色遮罩），
        所以<b>挑横向的图</b>。想直接改成文件（提 PR）也行，下面是那条路 —— 但它<b>必须先 Fork</b>：
      </p>
      <div class="doc-note warn">
        <p>
          ⚠️ <b>这一步必须先 Fork，不能直接往本站仓库传。</b>
          你在这个仓库没有写权限，直接在目录里点「Add file → Upload files」会被 GitHub 拒绝
          （提示 <code>You need write access to this repository</code>）。
          正确做法是先把仓库复制一份到你自己的账号下，在<b>你自己的副本</b>里上传，最后发一个 PR 回来：
        </p>
      </div>
      <ol>
        <li>
          打开仓库
          <a href="https://github.com/hhjjdsj/ze-map-site" target="_blank" rel="noopener"
            >hhjjdsj/ze-map-site</a
          >，右上角点 <b>Fork</b> → <b>Create fork</b>（得到 <code>你的用户名/ze-map-site</code>）
        </li>
        <li>
          在<b>你自己那份副本</b>里打开
          <a
            href="https://github.com/hhjjdsj/ze-map-site/tree/main/public/images/covers/custom"
            target="_blank"
            rel="noopener">public/images/covers/custom/</a
          > 目录
        </li>
        <li><b>Add file → Upload files</b>，把图片拖进去</li>
        <li>
          <b>文件名必须正好是「地图英文名」</b>，例如 <code>ze_obj_abyss_v2.jpg</code>。
          格式 <code>.jpg</code> / <code>.png</code> / <code>.webp</code> 都收
        </li>
        <li>拉到底 <b>Commit changes</b>（提交进你自己的副本，不会影响本站）</li>
        <li>
          回到原仓库 <b>hhjjdsj/ze-map-site</b> —— 顶部会出现 <b>Compare &amp; pull request</b>；
          没看到就点 <b>Contribute → Open pull request</b>，写一句「换了 xx 的封面」再 <b>Create pull request</b>
        </li>
      </ol>
      <div class="doc-note">
        <p>
          <b>嫌折腾？</b>投稿页的<b>「地图封面」</b>就是给这件事准备的：选一张图传上去，浏览器会先裁成 16:9、压成
          webp 再提交，通过后自动写进 <code>custom/</code>，文件名由系统按地图英文名对齐 —— 不用 Fork、不用 PR。
          也可以直接把图发给站长（⑤ 里那个 QQ），站长在本地跑 <code>npm run cover:set</code> 代传。
        </p>
      </div>
      <table class="doc-table">
        <thead>
          <tr>
            <th>要求</th>
            <th>建议</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>比例</td><td>横向 16:9。竖图会被裁成中间一条</td></tr>
          <tr><td>宽度</td><td>1280px 左右最合适，至少 640px（详情页顶部会放大当背景）</td></tr>
          <tr><td>体积</td><td>尽量 300 KB 以内，<b>硬上限 800 KB</b>（超了检查会红）。<b>截图直接存 PNG 往往有 1~2 MB</b>，存成 JPG（画质 80 左右）就行</td></tr>
        </tbody>
      </table>
      <div class="doc-note warn">
        <p>
          ⚠️ <b>文件名写成 Steam 分片名（<code>2001-ze_xxx-123456</code>）或者拼错一个字符，这张图永远不会显示</b>
          —— 而页面和构建全都正常，你不会收到任何报错。
          所以上传后请确认 PR 页面上的检查是绿的。
        </p>
      </div>
      <div class="doc-note">
        <p>
          <b>为什么换封面必须用「上传」，不能用铅笔？</b>
          GitHub 的铅笔编辑只能改文字文件 —— 图片这类二进制文件它不给编辑器。
          不过<b>新增、替换、删除图片都能在网页上完成</b>，不用装任何东西（都要在你自己 fork 的副本里做）：
        </p>
        <ul>
          <li>
            <b>换成另一张</b>：在你 fork 的 <code>custom/</code> 里还是 <b>Add file → Upload files</b>，
            <b>文件名和路径保持一模一样</b>，就是覆盖（PR 里会显示成修改）
          </li>
          <li>
            <b>换回脚本渲染的封面</b>：在 <code>custom/</code> 里点开那张图 → 右上角
            <b>⋯ → Delete file</b> → 同样提一个小 PR。不用改任何配置
          </li>
        </ul>
      </div>

      <h2 id="contact">⑤ 什么都不想学：直接联系站长</h2>
      <p>
        QQ <b>3157410575</b>（宇宙机器人）。把资料发过来就行 —— 文字、截图、视频链接、攻略原文都可以，
        整理的事交给站长。
      </p>
      <p>
        也可以<b>进 QQ 群</b>说：投稿、报错、问神器怎么用都行，群里也有人在玩同一张图。
      </p>
      <QqGroup variant="card" />

      <h2>提交之后会发生什么</h2>
      <table class="doc-table">
        <thead>
          <tr>
            <th>你走了哪条</th>
            <th>接下来</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>① 表单</td>
            <td>
              进人工审核队列（凭编号可查）→ 站长审核 → 通过的会攒进待写回队列，
              由站长批量写进仓库并自动重新构建，<b>通常几分钟内</b>就能在页面上看到，并署上你留的昵称
            </td>
          </tr>
          <tr>
            <td>② issue</td>
            <td>站长看到后整理进站点，可能用你留的方式追问细节</td>
          </tr>
          <tr>
            <td>③④ PR</td>
            <td>自动检查跑一遍 → 站长合并 → 自动构建部署上线</td>
          </tr>
        </tbody>
      </table>
      <p>审核不通过或被搁置，通常是这几种原因：</p>
      <ul>
        <li><b>没有来源</b> —— 查不到的宁缺勿假，写「网上说」没法核对</li>
        <li><b>说法有争议</b>（比如难度），会先挂起来等更多依据</li>
        <li><b>整段搬运</b>他人文章 —— 引用请注明出处，别原样复制</li>
        <li><b>格式没法用</b>（JSON 坏了、文件名不对），会退回让你改</li>
      </ul>

      <h2>站里还没有的新地图</h2>
      <p>
        新地图需要先提供 Steam 创意工坊物品 ID，由站长烘焙实体与地形数据后收录。
        可以提 issue 告知地图的工坊链接与资料来源。
      </p>
      <ul>
        <li>刚发布、还没收录：提 issue 提供工坊链接</li>
        <li>想为未收录地图补充资料：提 issue，等地图收录后再补对应 JSON</li>
        <li>需要路线图、视频嵌入等富内容：交给站长整理进 JSON 的 <code>document</code> 字段</li>
      </ul>

      <h2>给开发者的命令</h2>
      <p>在本机跑开发时用得上，普通投稿完全不需要：</p>
      <table class="doc-table">
        <thead>
          <tr>
            <th>命令</th>
            <th>作用</th>
          </tr>
        </thead>
        <tbody>
          <tr><td><code>npm run build</code></td><td>完整构建（含日期清单、生成条目、搜索索引）</td></tr>
          <tr><td><code>npm run maps:generate</code></td><td>从资料 JSON 与实体索引重新生成条目</td></tr>
          <tr><td><code>npm run content:verify</code></td><td>校验资料 JSON（来源、难度、字段名、可疑措辞）</td></tr>
          <tr><td><code>npm run cover:set -- &lt;地图名&gt; &lt;图片&gt;</code></td><td>本机裁图并换成人工封面（自动转 16:9 webp）</td></tr>
          <tr><td><code>npm run cover:verify</code></td><td>校验人工封面（文件名、格式、体积、比例）</td></tr>
          <tr><td><code>npm run content:links</code></td><td>扫全站站内链接与静态资源，查死链</td></tr>
        </tbody>
      </table>

      <h2>注意事项</h2>
      <ul>
        <li>请尽量附上<b>可核对的来源链接</b>，避免无法验证的说法</li>
        <li>不要直接整段搬运他人文章；引用请注明出处</li>
        <li>地图版权归原作者，本站只做整理</li>
      </ul>
    </article>
