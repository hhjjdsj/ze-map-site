---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="鬼泣：神器介绍与 BOSS 战详解（原版文档）| ZE 地图资料站"
  description="《鬼泣（Devil May Cry）》指挥手册原版 PDF：人类/僵尸神器、皮肤与五关 BOSS 战。作者 Liyuu～，鸣谢 冬初淡夏、無玖9。"
>
  <main class="manual-page">
    <div class="manual-head">
      <div>
        <h1>鬼泣：神器介绍与 BOSS 战详解</h1>
        <p class="manual-sub">原版文档（二版，指挥用）· 作者 Liyuu～ · 鸣谢 冬初淡夏、無玖9</p>
      </div>
      <div class="manual-actions">
        <a href="/maps/ze_devil_may_cry/">← 回到地图页</a>
        <a class="primary" href="/files/devil-may-cry-manual.pdf" download>下载 PDF</a>
      </div>
    </div>
    <div class="manual-frame">
      <iframe src="/files/devil-may-cry-manual.pdf#view=FitH" title="鬼泣指挥手册原版文档" loading="lazy"></iframe>
    </div>
    <p class="manual-note">
      本文档由作者 Liyuu～ 授权转载，保留原文排版与配图；测试版内容可能随地图版本调整。
    </p>
  </main>
</BaseLayout>

<style>
  .manual-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px clamp(14px, 3vw, 32px) 60px;
  }
  .manual-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .manual-head h1 {
    margin: 0 0 6px;
    font-size: clamp(22px, 3vw, 32px);
  }
  .manual-sub {
    margin: 0;
    color: var(--muted, #8b98a9);
    font-size: 13px;
  }
  .manual-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .manual-actions a {
    font-size: 13px;
    color: var(--muted, #8b98a9);
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 7px 14px;
    border-radius: 8px;
  }
  .manual-actions a.primary {
    color: #fff;
    background: linear-gradient(135deg, #e5484d, #ff7a59);
    border-color: transparent;
  }
  .manual-frame {
    height: calc(100vh - 190px);
    min-height: 620px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #111;
  }
  .manual-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .manual-note {
    margin: 12px 0 0;
    color: var(--muted, #8b98a9);
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .manual-frame { height: 70vh; min-height: 480px; }
  }
</style>
