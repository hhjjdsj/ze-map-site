---
import { getMaps, getMap } from '../../lib/maps';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleryFor } from '../../lib/gallery';
import { parseResearchBody, docToText } from '../../../shared/research-body.mjs';
import { videoKindOf } from '../../../shared/videos.mjs';
import { DIFFICULTIES } from '../../../shared/difficulty.mjs';

export async function getStaticPaths() {
  const maps = await getMaps();
  return maps.map((entry) => ({ params: { slug: entry.id }, props: { slug: entry.id } }));
}

const { slug } = Astro.props;
const entry = await getMap(slug);
if (!entry) throw new Error(`找不到地图：${slug}`);
const data = entry.data;
const gallery = galleryFor(entry.id);
const hero = data.cover ?? gallery[0]?.localSrc ?? gallery[0]?.src ?? null;
const galleryImages = gallery.filter((image) => (image.localSrc ?? image.src) !== hero);
const research = parseResearchBody(entry.body);
const playerBlocks = Array.isArray(data.playerContent?.blocks) ? data.playerContent.blocks : [];
const playerByType = (type: string) => playerBlocks.find((block: any) => block.type === type);
const baselineBlocks = [
  { id: 'story', type: 'story', title: '背景故事', text: research.story },
  { id: 'intro', type: 'intro', title: '简介', text: research.intro || research.summary || String(data.research?.summary ?? '').trim() },
  { id: 'gameplay', type: 'gameplay', title: '关卡流程说明', text: research.gameplay },
];
/* research 侧为空的固定区块：点「重置为 research」时不能把条目删掉，只清空并提示 */
const baselineEmpty = Object.fromEntries(
  baselineBlocks.map((block) => [block.type, !String(block.text ?? '').trim()])
) as Record<string, boolean>;
const playerGuideCleared = data.playerContent?.guideCleared === true;
const baselineGuides = playerGuideCleared
  ? []
  : playerBlocks.some((block: any) => block.type === 'guideItem')
    ? playerBlocks.filter((block: any) => block.type === 'guideItem')
    : research.guides.map((guide, index) => ({ id: `guide-${index + 1}`, type: 'guideItem', title: guide.title, text: guide.text }));
const blocks = [...baselineBlocks.map((block) => playerByType(block.type) ?? block), ...baselineGuides];
const initialBlocks = blocks.map((block: any) => ({
  id: block.id,
  type: block.type,
  title: block.title ?? ({ story: '背景故事', intro: '简介', gameplay: '关卡流程说明' }[block.type] ?? '攻略技巧'),
  text: block.text ?? docToText(block.doc),
  doc: block.doc ?? null,
}));
const initialInfobox = {
  author: data.author ?? '',
  version: data.version ?? '',
  players: data.players ?? '',
  duration: data.duration ?? '',
  stages: data.stages ?? '',
  size: data.size ?? '',
  aliases: Array.isArray(data.aliases) ? data.aliases.join('\n') : data.aliases ?? '',
  ...(data.playerContent?.infobox ?? {}),
};
const STAGE_HEADER = ['关卡', '名称', '关卡内容'];
/* 关卡内容一律归一成三列：关卡 / 名称 / 自由文本。旧的六列表在这里合并成一段。 */
const normalizeStageRows = (rows: any): string[][] => {
  if (!Array.isArray(rows) || !rows.length) return [STAGE_HEADER];
  const out: string[][] = [];
  for (let index = 0; index < rows.length; index++) {
    const row = rows[index];
    if (!Array.isArray(row)) continue;
    const isHeader = index === 0 && row.some((cell) => /关卡|名称|内容|流程/.test(String(cell ?? '')));
    if (isHeader) {
      out.push([...STAGE_HEADER]);
      continue;
    }
    if (row.length > 3) {
      const labels = ['目标', '关键路线', '神器 / 道具', '团灭点 / 备注'];
      const parts = row.slice(2).map((value, column) => {
        const text = String(value ?? '').trim();
        return text ? `${labels[column] ?? '内容'}：${text}` : '';
      }).filter(Boolean);
      out.push([row[0] ?? '', row[1] ?? '', parts.join('\n\n')]);
    } else {
      out.push([row[0] ?? '', row[1] ?? '', row[2] ?? '']);
    }
  }
  if (!out.length || !out[0].some((cell) => /关卡|名称|内容|流程/.test(String(cell ?? '')))) {
    out.unshift([...STAGE_HEADER]);
  }
  return out;
};
const initialStageRows = normalizeStageRows(Array.isArray(data.playerContent?.stageRows) ? data.playerContent.stageRows : research.stageRows);
const initialStageDocs = Array.isArray(data.playerContent?.stageDocs) ? data.playerContent.stageDocs : null;
const initialItems = Array.isArray(data.items) ? data.items.filter((item: any) => item.kind !== 'removed').map((item: any) => ({ action: 'update', name: item.name, cd: item.cd ?? '', uses: item.uses ?? '', intro: item.intro ?? '', note: item.note ?? '' })) : [];
const initialVideos = Array.isArray(data.playerContent?.videos) ? data.playerContent.videos : (Array.isArray(data.videoUrls) ? data.videoUrls.map((url: string) => ({ url, kind: videoKindOf(url, data.videoKinds) })) : []);
const initialDifficulty = data.playerContent?.difficulty ?? data.difficulty;
const initialTags = Array.isArray(data.playerContent?.tags) ? data.playerContent.tags : (Array.isArray(data.tags) ? data.tags : []);
const tocItem = (id: string, label: string, count = 0) => ({ id, label, ...(count > 0 ? { count } : {}) });
const tocItems = [
  ...(galleryImages.length > 0 ? [tocItem('gallery', '图片集', galleryImages.length)] : []),
  tocItem('story', '背景故事'),
  tocItem('intro', '地图概览'),
  tocItem('stage-editor', '关卡流程', Math.max(0, initialStageRows.length - 1)),
  tocItem('items', '神器 / 道具', initialItems.length),
  tocItem('guide', '攻略技巧', initialBlocks.filter((block: any) => block.type === 'guideItem').length),
  tocItem('videos', '视频', initialVideos.length),
];
---

<BaseLayout title={`编辑 ${data.title} | ZE 地图资料站`} description="编辑地图玩家内容" noindex>
  <main class="edit-page" data-slug={entry.id}>
    <header class="edit-title-block" style={data.cover ? `--edit-hero:url('${data.cover}')` : undefined}>
      <div class="edit-title-wash" aria-hidden="true"></div>
      <div class="edit-header">
        <div><p class="edit-kicker">PLAYER CONTENT · 编辑页</p><h1>{data.title}</h1><p class="edit-slug">{entry.id}</p><div class="edit-badges"><span>{data.difficulty}</span><span>{data.game}</span>{(data.tags ?? []).slice(0, 5).map((tag: string) => <span>{tag}</span>)}</div></div>
        <a class="edit-btn" href={`/maps/${entry.id}/`}>返回详情页</a>
      </div>
    </header>

    <nav class="edit-mode-bar" aria-label="编辑方式">
      <div class="edit-mode-copy">
        <p class="edit-kicker">EDIT MODE</p>
        <h2>选择编辑方式</h2>
        <p>单项编辑不用登录；整页编辑需要登录，提交后进入审核队列。</p>
      </div>
      <div class="edit-mode-actions">
        <a class="edit-mode-btn" href={`/submit/edit/?map=${entry.id}`} target="_self">单项编辑（无需登录）</a>
        <a class="edit-mode-btn" href={`/edit/${entry.id}/`} target="_self">整页编辑（需登录）</a>
      </div>
    </nav>
    <div class="edit-auth-banner" id="edit-auth-banner" hidden>
      <div>
        <strong>整页编辑需要登录</strong>
        <p>登录后才能提交整页修订；只想改一项可以直接用单项编辑，不需要登录。</p>
      </div>
      <a class="edit-btn" href="/account/" target="_self">去登录</a>
      <a class="edit-btn edit-primary" href={`/submit/edit/?map=${entry.id}`} target="_self">单项编辑</a>
    </div>

    <div class="edit-layout">
    <main class="edit-main">
    {/* 顺序对齐详情页：标题/封面编辑 → 封面 → 图片集 → 背景故事/概览 → 神器 → 攻略 → 视频 */}
    <section class="edit-card edit-fields"><div><label for="title">页面标题</label><input id="title" class="edit-title-input" value={data.title} maxlength="80" /></div><div><label for="heroImage">封面地址（可选）</label><input id="heroImage" value={data.playerContent?.heroImage ?? ''} placeholder="https://..." /><select id="heroImagePick" class="edit-cover-pick"><option value="">— 从图片集选择封面 —</option>{gallery.map((image, index) => <option value={image.localSrc} selected={image.localSrc === (data.playerContent?.heroImage ?? '')}>{image.caption || `图片 ${index + 1}`}</option>)}</select></div></section>
    {hero && <figure class="edit-cover"><img src={hero} alt={`${data.title} 封面`} /><figcaption>封面 · 从图片集选择</figcaption></figure>}
    {galleryImages.length > 0 && <section class="edit-card edit-gallery" id="gallery"><div class="edit-card-head"><div><h2>图片集</h2><p>详情页会显示这些图片；封面不在网格里重复出现。</p></div><span class="edit-source">{galleryImages.length} 张</span></div><div class="edit-gallery-grid">{galleryImages.map((image) => <img src={image.localSrc} alt={image.caption || data.title} />)}</div></section>}
    <section class="edit-card">
      <div class="edit-card-head"><div><h2>背景故事与简介</h2><p>每个正文区块独立保存；research 只作为基线，网页不会直接修改 research。</p></div><span class="edit-source">research 基线</span></div>
      <div id="blocks"></div>
    </section>

    <section class="edit-card" id="stage-editor">
      <div class="edit-card-head"><div><h2>关卡流程</h2><p>先写流程说明，再按关卡填写自由内容（换行、列表都可以）。</p></div><button class="edit-btn" id="add-stage" type="button">＋ 添加关卡</button></div>
      <div id="flow-blocks"></div>
      <div id="stages-table"></div>
    </section>
    <section class="edit-card" id="items"><div class="edit-card-head"><div><h2>神器 / 道具</h2><p>只提交玩家修改的行；名称来自 research 基表或新增行。</p></div><button class="edit-btn" id="add-item" type="button">＋ 添加道具</button></div><div id="items-table"></div></section>
    <section class="edit-card" id="guide"><div class="edit-card-head"><div><h2>攻略技巧</h2><p>每一条攻略单独保存；空条目不提交。</p></div><button class="edit-btn" id="add-guide" type="button">＋ 添加攻略条目</button></div><div id="guide-blocks"></div></section>
    <section class="edit-card" id="videos"><div class="edit-card-head"><div><h2>视频</h2><p>只接受 B 站链接；分类固定为通关视频、攻略、音乐。</p></div><button class="edit-btn" id="add-video" type="button">＋ 添加视频</button></div><div id="videos-table"></div></section>
    <section class="edit-actions"><span id="result" role="status"></span><button class="edit-btn edit-primary" id="submit" type="button" disabled>提交整页修订</button></section>
    </main>
    <aside class="edit-sidebar"><nav class="edit-side-card edit-toc" data-edit-toc aria-label="本页目录">
      <button class="edit-toc-title" type="button" id="edit-toc-toggle" aria-expanded="true" aria-controls="edit-toc-list">
        <span class="edit-toc-label">本页目录</span>
        <span class="edit-toc-count">{tocItems.length}</span>
        <span class="edit-toc-toggle-text">收起</span>
        <span class="edit-toc-caret" aria-hidden="true">▾</span>
      </button>
      <ol id="edit-toc-list">{tocItems.map((item) => <li><a href={`#${item.id}`} target="_self"><span>{item.label}</span>{item.count ? <b>{item.count}</b> : null}</a></li>)}</ol>
    </nav><section class="edit-side-card edit-infobox"><div class="edit-card-head"><div><h3>基本信息</h3><p>结构化字段，不使用富文本。</p></div><span class="edit-source">可编辑</span></div><div class="edit-side-fields"><div><label for="author">作者</label><input id="author" value={initialInfobox.author} /></div><div><label for="version">版本</label><input id="version" value={initialInfobox.version} /></div><div><label for="players">人数</label><input id="players" value={initialInfobox.players} /></div><div><label for="duration">时长</label><input id="duration" value={initialInfobox.duration} /></div><div><label for="stages">关卡数</label><input id="stages" value={initialInfobox.stages} /></div><div><label for="size">体积</label><input id="size" value={initialInfobox.size} /></div><div><label for="difficulty">难度</label><select id="difficulty">{DIFFICULTIES.map((item) => <option value={item} selected={item === initialDifficulty}>{item}</option>)}</select></div><div class="edit-full-field"><label>标签</label><div class="edit-tags" id="tags-chips"></div><input id="tag-input" class="edit-tag-input" placeholder="输入标签后回车；点 × 删除" /></div><div class="edit-full-field"><label for="aliases">其他叫法</label><textarea id="aliases" rows="3">{initialInfobox.aliases}</textarea></div></div></section><section class="edit-side-card"><h3>编辑规则</h3><p>详情页与编辑页使用同一套区块顺序。未提交字段保留当前值；删除和重置会进入审核 diff。</p><a class="edit-btn edit-primary" href={`/maps/${entry.id}/`}>查看详情页</a></section></aside>
    
    </div>
  </main>
</BaseLayout>

<script type="application/json" id="initial-blocks" set:html={JSON.stringify(initialBlocks)}></script>
<script type="application/json" id="initial-structured" set:html={JSON.stringify({ stageRows: initialStageRows, stageDocs: initialStageDocs, items: initialItems, videos: initialVideos, baseRev: data.contentRev ?? null, researchRev: data.researchRev ?? null, baselineEmpty })}></script>
<script type="application/json" id="initial-gallery" set:html={JSON.stringify(galleryImages.map((image: any) => ({ src: image.localSrc ?? image.src, caption: image.caption ?? "" })))}></script>
<script type="application/json" id="initial-tags" set:html={JSON.stringify(initialTags)}></script>
<script>
  import { Editor, Extension, Node } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import { TextStyle } from '@tiptap/extension-text-style';
  import TextAlign from '@tiptap/extension-text-align';
  import Placeholder from '@tiptap/extension-placeholder';

  const DOC_COLORS = ['red','orange','amber','green','teal','cyan','blue','indigo','purple','pink','gray','brown'];
  const TokenTextStyle = TextStyle.extend({
    parseHTML() {
      return [{ tag: 'span', consuming: false, getAttrs: (element: HTMLElement) => element.hasAttribute('style') || [...element.classList].some((name) => name.startsWith('doc-color-')) ? {} : false }];
    },
  });
  const FontSize = Extension.create({
    name: 'fontSize',
    addGlobalAttributes() {
      return [{ types: ['textStyle'], attributes: { fontSize: {
        default: null,
        parseHTML: (element: HTMLElement) => { const value = Number.parseInt(element.style.fontSize, 10); return Number.isInteger(value) ? value : null; },
        renderHTML: (attributes: Record<string, unknown>) => attributes.fontSize ? { style: `font-size: ${attributes.fontSize}px` } : {},
      } } }];
    },
    addCommands() {
      return {
        setFontSize: (fontSize: number) => ({ chain }: any) => chain().setMark('textStyle', { fontSize }).run(),
        unsetFontSize: () => ({ chain }: any) => chain().setMark('textStyle', { fontSize: null }).removeEmptyTextStyle().run(),
      };
    },
  });
  /**
   * 颜色只存 token，渲染成 class（不写内联色值）。
   * 这样 amber / indigo 这些不是 CSS 颜色关键字的 token 也能正确显示，
   * 也避免编辑器里看到一种颜色、详情页里变成另一种颜色。
   */
  const TokenColor = Extension.create({
    name: 'tokenColor',
    addGlobalAttributes() {
      return [{ types: ['textStyle'], attributes: { color: {
        default: null,
        parseHTML: (element: HTMLElement) => {
          const token = [...element.classList].map((name) => name.startsWith('doc-color-') ? name.slice(10) : '').find(Boolean);
          return token && DOC_COLORS.includes(token) ? token : null;
        },
        renderHTML: (attributes: Record<string, unknown>) => typeof attributes.color === 'string' && DOC_COLORS.includes(attributes.color) ? { class: `doc-color-${attributes.color}` } : {},
      } } }];
    },
    addCommands() {
      return {
        setTokenColor: (color: string) => ({ chain }: any) => chain().setMark('textStyle', { color }).run(),
        unsetTokenColor: () => ({ chain }: any) => chain().setMark('textStyle', { color: null }).removeEmptyTextStyle().run(),
      };
    },
  });

  type Block = { id: string; type: string; title: string; text: string; doc?: any };
  const page = document.querySelector<HTMLElement>('.edit-page')!;
  const slug = page.dataset.slug!;
  const blocks = JSON.parse(document.getElementById('initial-blocks')?.textContent ?? '[]') as Block[];
  const removedBlockIds: string[] = [];
  const structured = JSON.parse(document.getElementById('initial-structured')?.textContent ?? '{}') as { stageRows: string[][]; stageDocs?: any[] | null; items: any[]; videos: any[]; baseRev: string | null; researchRev: string | null; baselineEmpty?: Record<string, boolean> };
  const initialTags = JSON.parse(document.getElementById('initial-tags')?.textContent ?? '[]') as string[];
  const tags = [...initialTags];
  const tagsRoot = document.getElementById('tags-chips')!;
  const tagInput = document.getElementById('tag-input') as HTMLInputElement;
  const difficulty = document.getElementById('difficulty') as HTMLSelectElement;
  const originalDifficulty = difficulty.value;
  const renderTags = () => { tagsRoot.replaceChildren(); for (const tag of tags) { const chip = document.createElement('span'); chip.className = 'edit-tag'; chip.textContent = tag; const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '×'; remove.title = '删除标签'; remove.onclick = () => { tags.splice(tags.indexOf(tag), 1); renderTags(); }; chip.append(remove); tagsRoot.append(chip); } };
  const addTag = () => { for (const raw of tagInput.value.split(/[、,，\s]+/)) { const tag = raw.trim(); if (tag && !tags.some((item) => item.toLowerCase() === tag.toLowerCase())) tags.push(tag); } tagInput.value = ''; renderTags(); };
  tagInput.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === '，' || event.key === ',') { event.preventDefault(); addTag(); } });
  tagInput.addEventListener('blur', addTag);
  const stageRows = structured.stageRows ?? [];
  const stageDocs = Array.isArray(structured.stageDocs) ? [...structured.stageDocs] : [];
  const stageEditors = new Map<number, Editor>();
  const STAGE_HEADER = ['关卡', '名称', '关卡内容'];
  const items = structured.items ?? [];
  const videos = structured.videos ?? [];
  const blocksEl = document.getElementById('blocks')!;
  const flowBlocksEl = document.getElementById('flow-blocks')!;
  const guideBlocksEl = document.getElementById('guide-blocks')!;
  const result = document.querySelector<HTMLElement>('#result')!;
  const title = document.querySelector<HTMLInputElement>('#title')!;
  const heroImage = document.querySelector<HTMLInputElement>('#heroImage')!;
  const infoboxKeys = ['author', 'version', 'players', 'duration', 'stages', 'size', 'aliases'];
  const originalTitle = title.value;
  const originalHero = heroImage.value;
  const heroPick = document.querySelector<HTMLSelectElement>('#heroImagePick');
  const coverImage = document.querySelector<HTMLImageElement>('.edit-cover img');
  const refreshCover = () => { if (coverImage && heroImage.value.trim()) coverImage.src = heroImage.value.trim(); };
  heroPick?.addEventListener('change', () => { if (heroPick.value) { heroImage.value = heroPick.value; refreshCover(); } });
  heroImage.addEventListener('input', refreshCover);
  const dirtyInfobox = new Set<string>();
  infoboxKeys.forEach((key) => document.getElementById(key)?.addEventListener('input', () => dirtyInfobox.add(key)));
  const textToDoc = (text: string) => ({
    type: 'doc',
    content: String(text ?? '').split(/\n\s*\n/).filter(Boolean).map((paragraph) => {
      const content: any[] = [];
      paragraph.split('\n').forEach((line, index) => {
        if (index) content.push({ type: 'hardBreak' });
        if (line) content.push({ type: 'text', text: line });
      });
      return { type: 'paragraph', content };
    }),
  });
  const editors = new Map<string, Editor>();
  const initialDocs = new Map<string, string>();
  let initialGuideSignature = '';
  let stagesDirty = false;
  let videosDirty = false;
  /* 正文图片节点：和 shared/page-schema.mjs 的 figure 对齐（attrs.src / attrs.side）。 */
  const Figure = Node.create({
    name: 'figure',
    group: 'block',
    atom: true,
    draggable: true,
    selectable: true,
    addAttributes() {
      return {
        src: { default: null },
        side: { default: 'left' },
        n: { default: null },
      };
    },
    parseHTML() {
      return [{
        tag: 'figure.doc-figure',
        getAttrs: (element: HTMLElement) => ({
          src: element.querySelector('img')?.getAttribute('src') ?? null,
          side: element.classList.contains('doc-figure-right') ? 'right' : 'left',
        }),
      }];
    },
    renderHTML({ HTMLAttributes }: any) {
      const side = HTMLAttributes.side === 'right' ? 'right' : 'left';
      return ['figure', { class: `doc-figure doc-figure-${side}` }, ['img', { src: HTMLAttributes.src ?? '', alt: '' }]];
    },
  });
  const extensions = [
    /* StarterKit 自带 link / underline；再单独引入会重复注册扩展。 */
    StarterKit.configure({ heading: { levels: [3, 4] }, link: { protocols: ['https'], openOnClick: false, autolink: true } }),
    Figure,
    TokenTextStyle,
    FontSize,
    TokenColor,
    TextAlign.configure({ types: ['heading', 'paragraph'], alignments: ['left', 'center', 'right'] }),
    Placeholder.configure({ placeholder: '开始输入内容…' }),
  ];
  const makeInput = (value: string, placeholder = '') => { const field = document.createElement('input'); field.value = value ?? ''; field.placeholder = placeholder; return field; };
  const makeTextarea = (value: string, placeholder = '') => { const field = document.createElement('textarea'); field.rows = 1; field.value = value ?? ''; field.placeholder = placeholder; return field; };
  const autoGrow = (field: HTMLTextAreaElement) => { field.style.height = 'auto'; field.style.height = `${field.scrollHeight}px`; };
  const renderStructured = () => {
    for (const editor of stageEditors.values()) editor.destroy();
    stageEditors.clear();
    const stageRoot = document.getElementById('stages-table')!; stageRoot.replaceChildren();
    /* 第一行是表头（关卡 / 名称 / 内容），只存在数据里，不渲染成可编辑字段 */
    const hasHeader = stageRows.length > 0 && stageRows[0].some((cell) => /关卡|名称|内容|流程/.test(String(cell ?? '')));
    const firstStage = hasHeader ? 1 : 0;
    if (stageRows.length <= firstStage) {
      const empty = document.createElement('p');
      empty.className = 'stage-empty';
      empty.textContent = '还没有关卡，点右上角「添加关卡」。';
      stageRoot.append(empty);
    }
    for (let rowIndex = firstStage; rowIndex < stageRows.length; rowIndex++) {
      const row = stageRows[rowIndex];
      const card = document.createElement('article');
      card.className = 'stage-card';

      const head = document.createElement('div');
      head.className = 'stage-card-head';
      const num = makeInput(row[0] ?? '', '第 1 关');
      const name = makeInput(row[1] ?? '', '关卡名称');
      num.oninput = () => { stagesDirty = true; row[0] = num.value; };
      name.oninput = () => { stagesDirty = true; row[1] = name.value; };
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '删除';
      remove.onclick = () => { stagesDirty = true; stageRows.splice(rowIndex, 1); stageDocs.splice(rowIndex, 1); renderStructured(); };
      head.append(num, name, remove);
      card.append(head);

      /*
       * 单个关卡是富文本：Tiptap 编辑器 + 同一套工具栏。
       * stageRows 的第三列继续存纯文本（审核 diff / 老数据回退用），
       * 富文本结构存在 stageDocs 里，详情页优先渲染它。
       */
      const caption = document.createElement('p');
      caption.className = 'stage-field-caption';
      caption.textContent = '关卡内容';
      const editorHost = document.createElement('div');
      editorHost.className = 'block-rich-editor';
      const editor = new Editor({
        element: editorHost,
        extensions,
        content: stageDocs[rowIndex] ?? textToDoc(row[2] ?? ''),
        onUpdate: ({ editor: current }) => {
          stagesDirty = true;
          stageDocs[rowIndex] = current.getJSON();
          row[2] = current.getText();
        },
      });
      stageEditors.set(rowIndex, editor);
      card.append(caption, toolbar(editor), editorHost);
      stageRoot.append(card);
    }
    const itemRoot = document.getElementById('items-table')!; itemRoot.replaceChildren();
    items.forEach((item, index) => { const line = document.createElement('div'); line.className = `structured-row item-row${item.action === 'remove' ? ' is-removed' : ''}`; const name = makeInput(item.name); name.readOnly = item.action !== 'add'; const cd = makeInput(String(item.cd ?? ''), '冷却'); const uses = makeInput(String(item.uses ?? ''), '次数'); const intro = makeTextarea(item.intro ?? '', '说明'); const note = makeTextarea(item.note ?? '', '备注'); [name, cd, uses, intro, note].forEach((field) => field.oninput = () => { item.dirty = true; item.name = name.value; item.cd = cd.value; item.uses = uses.value; item.intro = intro.value; item.note = note.value; if (field instanceof HTMLTextAreaElement) autoGrow(field); }); const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = item.action === 'remove' ? '已标记删除' : '标记删除'; remove.onclick = () => { item.action = 'remove'; item.dirty = true; renderStructured(); }; line.append(name, cd, uses, intro, note, remove); itemRoot.append(line); });
    const videoRoot = document.getElementById('videos-table')!; videoRoot.replaceChildren();
    videos.forEach((video, index) => { const line = document.createElement('div'); line.className = 'structured-row video-row'; const url = makeInput(video.url ?? '', 'https://www.bilibili.com/video/...'); const kind = document.createElement('select'); [['run', '通关视频'], ['guide', '攻略'], ['music', '音乐']].forEach(([value, label]) => { const option = new Option(label, value); option.selected = video.kind === value; kind.append(option); }); url.oninput = () => { videosDirty = true; video.url = url.value; }; kind.onchange = () => { videosDirty = true; video.kind = kind.value; }; const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '删除'; remove.onclick = () => { videosDirty = true; videos.splice(index, 1); renderStructured(); }; line.append(url, kind, remove); videoRoot.append(line); });
    stageRoot.querySelectorAll('textarea').forEach(autoGrow);
    itemRoot.querySelectorAll('textarea').forEach(autoGrow);
  };
  const toolbar = (editor: Editor) => {
    const bar = document.createElement('div'); bar.className = 'edit-toolbar';
    /* 只拦按钮：拦 <select> 会让原生下拉根本打不开（字号 / 对齐点了没反应）。 */
    bar.addEventListener('mousedown', (event) => { if ((event.target as HTMLElement).closest('button')) event.preventDefault(); });
    const command = (label: string, title: string, run: () => void) => { const button = document.createElement('button'); button.type = 'button'; button.textContent = label; button.title = title; button.onclick = run; bar.append(button); };
    command('B', '粗体', () => editor.chain().focus().toggleBold().run());
    command('I', '斜体', () => editor.chain().focus().toggleItalic().run());
    command('U', '下划线', () => editor.chain().focus().toggleUnderline().run());
    command('S', '删除线', () => editor.chain().focus().toggleStrike().run());
    command('H3', '三级标题', () => editor.chain().focus().toggleHeading({ level: 3 }).run());
    command('H4', '四级标题', () => editor.chain().focus().toggleHeading({ level: 4 }).run());
    command('•', '无序列表', () => editor.chain().focus().toggleBulletList().run());
    command('1.', '有序列表', () => editor.chain().focus().toggleOrderedList().run());
    command('❝', '引用', () => editor.chain().focus().toggleBlockquote().run());
    command('↶', '撤销', () => editor.chain().focus().undo().run());
    command('↷', '重做', () => editor.chain().focus().redo().run());
    const size = document.createElement('select'); size.title = '字号'; size.append(new Option('默认字号', ''));
    [12, 14, 16, 18, 20, 24, 28, 32].forEach((value) => size.append(new Option(`${value}px`, String(value))));
    size.onchange = () => { const value = Number(size.value); if (value) (editor.chain().focus() as any).setFontSize(value).run(); else (editor.chain().focus() as any).unsetFontSize().run(); size.value = ''; }; bar.append(size);
    const align = document.createElement('select'); align.title = '对齐'; [['left', '左对齐'], ['center', '居中'], ['right', '右对齐']].forEach(([value, label]) => align.append(new Option(label, value)));
    align.onchange = () => { editor.chain().focus().setTextAlign(align.value).run(); }; bar.append(align);
    command('🖼', '插入图片', () => openFigurePicker(editor));
    command('⌫', '清除格式', () => editor.chain().focus().unsetAllMarks().clearNodes().run());
    /* 默认色 = 页面正文色（暗色主题下就是详情页的亮白色），移除颜色覆盖。 */
    const defaultColor = document.createElement('button');
    defaultColor.type = 'button';
    defaultColor.className = 'doc-swatch doc-swatch-default';
    defaultColor.title = '正文默认色（暗色主题下为亮白）';
    defaultColor.textContent = '默认';
    defaultColor.style.color = 'var(--edit-text)';
    defaultColor.onclick = () => (editor.chain().focus() as any).unsetTokenColor().run();
    bar.append(defaultColor);
    DOC_COLORS.forEach((color) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `doc-swatch doc-color-${color}`;
      button.style.color = `var(--doc-${color})`;
      button.title = color;
      button.textContent = '●';
      button.onclick = () => (editor.chain().focus() as any).setTokenColor(color).run();
      bar.append(button);
    });
    return bar;
  };

  /* 插入图片：可以从图片集挑、粘贴站内地址，或直接上传一张（走 /api/content-gallery）。 */
  let figurePicker: HTMLElement | null = null;
  let figureEditor: Editor | null = null;
  const insertFigure = (src: string) => {
    if (!figureEditor || !src) return;
    figureEditor.chain().focus().insertContent({ type: 'figure', attrs: { src, side: 'left' } }).run();
    closeFigurePicker();
  };
  const closeFigurePicker = () => {
    if (figurePicker) figurePicker.hidden = true;
    figureEditor = null;
  };
  const openFigurePicker = (editor: Editor) => {
    figureEditor = editor;
    if (!figurePicker) {
      const overlay = document.createElement('div');
      overlay.className = 'edit-figure-picker';
      overlay.hidden = true;
      overlay.innerHTML = [
        '<div class="edit-figure-dialog" role="dialog" aria-label="插入图片">',
        '  <div class="edit-figure-head"><strong>插入图片</strong><button type="button" data-close>×</button></div>',
        '  <div class="edit-figure-row"><input type="text" data-url placeholder="粘贴站内图片地址，例如 /images/... " /><button type="button" data-insert>插入</button></div>',
        '  <div class="edit-figure-row"><label class="edit-figure-upload">上传图片<input type="file" accept="image/*" data-file hidden /></label><span data-status class="edit-figure-status"></span></div>',
        '  <div class="edit-figure-grid" data-grid></div>',
        '</div>',
      ].join('');
      document.body.append(overlay);
      const gallery = JSON.parse(document.getElementById('initial-gallery')?.textContent ?? '[]') as Array<{ src: string; caption?: string }>;
      const grid = overlay.querySelector('[data-grid]')!;
      for (const image of gallery) {
        if (!image?.src) continue;
        const button = document.createElement('button');
        button.type = 'button';
        button.title = image.caption || image.src;
        button.innerHTML = '<img alt="" src="' + image.src.replace(/"/g, '&quot;') + '" />';
        button.onclick = () => insertFigure(image.src);
        grid.append(button);
      }
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay || (event.target as HTMLElement).closest('[data-close]')) closeFigurePicker();
      });
      overlay.querySelector('[data-insert]')?.addEventListener('click', () => {
        const input = overlay.querySelector('[data-url]') as HTMLInputElement;
        insertFigure(input.value.trim());
      });
      overlay.querySelector('[data-file]')?.addEventListener('change', async (event) => {
        const file = (event.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const status = overlay.querySelector('[data-status]')!;
        status.textContent = '上传中…';
        const fd = new FormData();
        fd.append('map', location.pathname.split('/').filter(Boolean).pop() ?? '');
        fd.append('image', file);
        fd.append('caption', file.name.replace(/\.[^.]+$/, ''));
        try {
          const res = await fetch('/api/content-gallery', { method: 'POST', body: fd });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'HTTP ' + res.status);
          const media = data.media ?? {};
          const src = media.localSrc || media.src;
          if (!src) throw new Error('没有拿到图片地址');
          insertFigure(src);
        } catch (error) {
          status.textContent = '上传失败：' + (error instanceof Error ? error.message : String(error));
        }
      });
      figurePicker = overlay;
    }
    figurePicker.hidden = false;
    (figurePicker.querySelector('[data-url]') as HTMLInputElement)?.focus();
  };

  const render = () => {
     for (const editor of editors.values()) editor.destroy();
     editors.clear(); blocksEl.replaceChildren(); flowBlocksEl.replaceChildren(); guideBlocksEl.replaceChildren();
    blocks.forEach((block, index) => {
      const card = document.createElement('article'); card.className = 'block-editor'; if (block.type !== 'guideItem') card.id = block.id; card.dataset.index = String(index);
      const head = document.createElement('div'); head.className = 'block-head';
      const label = document.createElement('span'); label.textContent = block.type === 'guideItem' ? '攻略技巧条目' : block.title;
      const hint = document.createElement('span'); hint.className = 'block-hint'; hint.textContent = block.hint ?? '';
      const actions = document.createElement('div');
      const isGuide = block.type === 'guideItem';
      const guideIndexes = blocks.map((item, position) => item.type === 'guideItem' ? position : -1).filter((position) => position >= 0);
      const up = document.createElement('button'); up.type = 'button'; up.textContent = '↑'; up.title = isGuide ? '上移' : '固定区块不可排序'; up.disabled = !isGuide || index === guideIndexes[0];
      const down = document.createElement('button'); down.type = 'button'; down.textContent = '↓'; down.title = isGuide ? '下移' : '固定区块不可排序'; down.disabled = !isGuide || index === guideIndexes[guideIndexes.length - 1];
      const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = isGuide ? '删除' : '重置为 research';
      up.onclick = () => { [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]]; render(); };
      down.onclick = () => { [blocks[index + 1], blocks[index]] = [blocks[index], blocks[index + 1]]; render(); };
       remove.onclick = () => {
         /*
          * 固定区块的按钮是「重置为 research」：research 本身为空时，删掉条目会让页面
          * 直接少一节 —— 玩家要的是「清空回到基线」，不是删条目。这里只清空内容、保留区块，
          * 并在区块头上提示一句；真正删除条目走的是下面的 guideItem「删除」。
          */
         if (!isGuide && structured.baselineEmpty?.[block.type]) {
           block.doc = undefined;
           block.text = '';
           block.hint = 'research 为空，已保留空条目';
           render();
           return;
         }
         removedBlockIds.push(block.id); blocks.splice(index, 1); render();
       };
      actions.append(up, down, remove); head.append(label, hint, actions); card.append(head);
      if (block.type === 'guideItem') { const input = document.createElement('input'); input.value = block.title; input.placeholder = '攻略条目标题'; input.oninput = () => { block.title = input.value; }; card.append(input); }
       const editorHost = document.createElement('div'); editorHost.className = 'block-rich-editor';
       const editor = new Editor({ element: editorHost, extensions, content: block.doc ?? textToDoc(block.text), onUpdate: ({ editor: current }) => { block.doc = current.getJSON(); block.text = current.getText(); if (block.hint) { block.hint = ''; hint.textContent = ''; } } });
       editors.set(block.id, editor); card.append(toolbar(editor), editorHost); (block.type === 'guideItem' ? guideBlocksEl : block.type === 'gameplay' ? flowBlocksEl : blocksEl).append(card);
       if (!initialDocs.has(block.id)) initialDocs.set(block.id, JSON.stringify(editor.getJSON()));
    });
    if (!initialGuideSignature) initialGuideSignature = JSON.stringify(blocks.filter((block) => block.type === 'guideItem').map((block) => ({ id: block.id, title: block.title, doc: JSON.parse(initialDocs.get(block.id) ?? 'null') })));
  };
  document.getElementById('add-guide')?.addEventListener('click', () => { blocks.push({ id: `guide-${Date.now()}`, type: 'guideItem', title: '新的攻略技巧', text: '' }); render(); });
  document.getElementById('submit')?.addEventListener('click', async () => {
    const button = document.getElementById('submit') as HTMLButtonElement; button.disabled = true; button.dataset.busy = '1'; result.textContent = '正在提交…';
    const infobox = Object.fromEntries(infoboxKeys.filter((key) => dirtyInfobox.has(key)).map((key) => [key, document.getElementById(key)?.value ?? '']));
    const itemEdits = items.filter((item) => item.dirty || item.action === 'add' || item.action === 'remove').map(({ dirty, ...item }) => ({ ...item, cd: item.cd === '' ? null : Number(item.cd), uses: item.uses === '' ? null : Number(item.uses) }));
    const currentBlocks = blocks.map((block) => ({ id: block.id, type: block.type, ...(block.type === 'guideItem' ? { title: block.title } : {}), doc: editors.get(block.id)?.getJSON() ?? block.doc ?? textToDoc(block.text) }));
    const fixedChanges = currentBlocks.filter((block) => block.type !== 'guideItem' && JSON.stringify(block.doc) !== initialDocs.get(block.id));
    const guides = currentBlocks.filter((block) => block.type === 'guideItem');
    const guideChanged = JSON.stringify(guides.map((block) => ({ id: block.id, title: block.title, doc: block.doc }))) !== initialGuideSignature;
    const changedBlocks = [...fixedChanges, ...(guideChanged ? guides : [])];
    const payload = {
      slug,
      ...(typeof structured.baseRev === 'string' ? { baseRev: structured.baseRev } : {}),
      ...(typeof structured.researchRev === 'string' ? { researchRev: structured.researchRev } : {}),
      ...(title.value !== originalTitle ? { title: title.value.trim() } : {}),
      ...(difficulty.value !== originalDifficulty ? { difficulty: difficulty.value } : {}),
      ...(JSON.stringify(tags) !== JSON.stringify(initialTags) ? { tags } : {}),
      ...(heroImage.value !== originalHero ? { heroImage: heroImage.value.trim() || null } : {}),
      ...(Object.keys(infobox).length ? { infobox } : {}),
      ...(changedBlocks.length ? { blocks: changedBlocks } : {}),
      ...(guideChanged && guides.length === 0 ? { guideCleared: true } : {}),
      ...(removedBlockIds.length ? { removedBlocks: removedBlockIds } : {}),
      ...(stagesDirty ? {
        stageRows,
        stageDocs: stageRows.map((row, index) => index === 0 ? null : (stageDocs[index] ?? textToDoc(row[2] ?? ''))),
      } : {}),
      ...(itemEdits.length ? { itemEdits } : {}),
      ...(videosDirty ? { videos } : {}),
    };
    const changedPayloadKeys = Object.keys(payload).filter((key) => !['slug', 'baseRev', 'researchRev'].includes(key));
    if (!changedPayloadKeys.length) {
      result.textContent = '还没有改动 —— 改一处再提交。';
      delete button.dataset.busy;
      button.disabled = button.dataset.canEdit !== '1';
      return;
    }
    try { const response = await fetch('/api/page-revision', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }); const data = await response.json(); if (!response.ok) throw new Error(data.error || '提交失败'); result.textContent = `已进入审核队列（编号 ${data.id}）`; } catch (error) { result.textContent = error instanceof Error ? error.message : '提交失败'; } finally { delete button.dataset.busy; button.disabled = button.dataset.canEdit !== '1'; }
  });
  renderTags();
  render();
  document.getElementById('add-stage')?.addEventListener('click', () => {
    stagesDirty = true;
    const hasHeader = stageRows.length > 0 && stageRows[0].some((cell) => /关卡|名称|内容|流程/.test(String(cell ?? '')));
    if (!hasHeader) stageRows.unshift([...STAGE_HEADER]);
    stageRows.push(['', '', '']);
    stageDocs.push(null);
    renderStructured();
  });
  document.getElementById('add-item')?.addEventListener('click', () => { items.push({ action: 'add', dirty: true, name: '', cd: '', uses: '', intro: '', note: '' }); renderStructured(); });
  document.getElementById('add-video')?.addEventListener('click', () => { videosDirty = true; videos.push({ url: '', kind: 'run' }); renderStructured(); });
  renderStructured();
  window.addEventListener('resize', () => document.querySelectorAll<HTMLTextAreaElement>('.structured-row textarea').forEach(autoGrow));
</script>

<style is:global>
  /* 与详情页 / 源站共用一套黑底、红色主色、青色链接与网格光晕 */
  .edit-page { --edit-bg:transparent; --edit-panel:var(--panel); --edit-panel-2:var(--panel-2); --edit-text:var(--text); --edit-muted:var(--muted); --edit-border:var(--border); --edit-border-2:var(--border-2); --edit-accent:var(--accent); --edit-link:var(--accent-2); --doc-red:#ff7b72; --doc-orange:#ffa657; --doc-amber:#e3b341; --doc-green:#7ee787; --doc-teal:#56d4b5; --doc-cyan:#76e3ea; --doc-blue:#79c0ff; --doc-indigo:#a5b4fc; --doc-purple:#d2a8ff; --doc-pink:#ff9bce; --doc-gray:#b1bac4; --doc-brown:#d4a373; max-width:100%; margin:0; padding:0 0 80px; color:var(--edit-text); background:transparent; min-height:100vh; position:relative; z-index:1; }
