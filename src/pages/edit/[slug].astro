  .edit-title-block { position:relative; overflow:hidden; border-bottom:1px solid var(--edit-border); background:transparent; }.edit-title-block::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 30% 50%, rgba(255,77,77,.18), transparent 60%); pointer-events:none; }.edit-title-wash { position:absolute; inset:0; background:var(--edit-hero) center 35%/cover no-repeat; opacity:.22; filter:saturate(.8); mask-image:linear-gradient(#000,transparent); }.edit-header { position:relative; max-width:1240px; margin:0 auto; padding:42px 24px 32px; display:flex; align-items:flex-end; justify-content:space-between; gap:20px; }.edit-kicker { color:var(--edit-muted); font-size:11px; letter-spacing:.14em; font-weight:700; }.edit-header h1 { margin:7px 0 3px; font-size:clamp(32px,5vw,52px); line-height:1.15; font-weight:900; letter-spacing:-.02em; }.edit-slug { margin:4px 0 14px; color:var(--edit-link); font:13px ui-monospace,monospace; }.edit-badges { display:flex; flex-wrap:wrap; gap:6px; }.edit-badges span { padding:3px 9px; border:1px solid var(--edit-border-2); border-radius:999px; color:var(--edit-muted); background:color-mix(in srgb,var(--edit-panel) 80%,transparent); font-size:11px; }
  .edit-card,.edit-actions { width:min(920px,calc(100% - 48px)); max-width:920px; margin-left:auto; margin-right:auto; min-width:0; }.edit-card { margin-top:16px; padding:20px; border:1px solid var(--edit-border); border-radius:10px; background:var(--edit-panel); }.edit-card-head { display:flex; justify-content:space-between; gap:16px; margin-bottom:14px; }.edit-card h2 { position:relative; margin:0; padding-left:12px; font-size:19px; }.edit-card h2::before { content:''; position:absolute; left:0; top:3px; bottom:3px; width:4px; border-radius:4px; background:linear-gradient(180deg,var(--accent),var(--accent-3)); box-shadow:0 0 14px rgba(255,77,77,.5); }.edit-card-head p { margin:5px 0 0; color:var(--edit-muted); font-size:13px; }.edit-source { padding:3px 8px; border:1px dashed var(--edit-border-2); border-radius:999px; color:var(--edit-muted); font-size:11px; white-space:nowrap; }
  .edit-layout { max-width:1240px; margin:0 auto; padding:30px 24px 0; display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:40px; }
  .edit-mode-bar, .edit-auth-banner { width:min(1240px, calc(100% - 48px)); max-width:1240px; margin:16px auto 0; padding:14px 18px; border-radius:10px; }
  .edit-mode-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; border:1px solid var(--edit-border); background:var(--edit-panel); }
  .edit-mode-copy h2 { margin:0 0 4px; font-size:16px; }
  .edit-mode-copy p { margin:0; color:var(--edit-muted); font-size:12.5px; line-height:1.7; }
  .edit-mode-actions { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .edit-mode-btn { display:inline-flex; padding:9px 13px; border:1px solid var(--edit-accent); border-radius:7px; background:var(--edit-accent); color:#fff; font-size:13px; font-weight:600; text-decoration:none; }
  .edit-auth-banner { display:flex; align-items:center; gap:12px; border:1px solid rgba(227,179,65,.45); background:rgba(227,179,65,.08); }
  .edit-auth-banner[hidden] { display:none; }
  .edit-auth-banner > div { flex:1; }
