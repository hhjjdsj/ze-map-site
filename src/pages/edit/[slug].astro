<script>
  function initEditToc() {
    const toc = document.querySelector('[data-edit-toc]');
    const toggle = document.getElementById('edit-toc-toggle');
    if (!toc || !toggle) return;
    const label = toggle.querySelector('.edit-toc-toggle-text');
    const apply = (collapsed) => {
      toc.dataset.collapsed = collapsed ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', String(!collapsed));
      if (label) label.textContent = collapsed ? '展开' : '收起';
    };
    let collapsed = false;
    try {
      collapsed = localStorage.getItem('ze-new-toc-collapsed') === '1';
    } catch {
      /* 隐私模式 / 禁用 localStorage：默认展开即可 */
    }
    apply(collapsed);
    toggle.addEventListener('click', () => {
      collapsed = !collapsed;
      apply(collapsed);
      try {
        localStorage.setItem('ze-new-toc-collapsed', collapsed ? '1' : '0');
      } catch {
        /* 存不了就只在本次页面生效 */
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initEditToc);
  else initEditToc();
</script>

<script>
  let canEditFull = false;
  let authChecking = false;
  async function initEditAuth() {
    if (authChecking) return;
    authChecking = true;
    const banner = document.getElementById('edit-auth-banner');
    const submit = document.getElementById('submit');
    try {
      const response = await fetch('/api/me', { cache: 'no-store', headers: { accept: 'application/json' } });
      const data = await response.json().catch(() => null);
      canEditFull = Boolean(data?.ok && data?.user);
    } catch {
      canEditFull = false;
    } finally {
      authChecking = false;
    }
    if (banner) banner.hidden = canEditFull;
    if (submit) {
      submit.dataset.canEdit = canEditFull ? '1' : '0';
      if (submit.dataset.busy !== '1') submit.disabled = !canEditFull;
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initEditAuth);
  else initEditAuth();
  window.addEventListener('focus', () => { void initEditAuth(); });
</script>
