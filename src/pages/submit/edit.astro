---
/**
 * 编辑条目（2026-10-21，本地试验版 · 未上线）
 *
 * 按 SolsticeStarry 的投稿页思路重做：先看现状，再改；只提交改动过的项。
 *   单项补充：不需要登录，改一项交一项（含封面 / 图片集上传）；
 *   整页编辑：需要登录，所有字段按现状预填，只把改动项按 items[] 一次提交。
 * 数据和线上同一套：/submit/maps.json（现状）、/api/page-revision（单项）、
 * /api/content-cover、/api/content-gallery。
 *
 * 旧 /submit 已删除并 301 到这里；本页是唯一的单项编辑入口。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FIELD_RULES } from '../../../shared/submission-fields.mjs';

const rules = FIELD_RULES as Record<string, any>;
const SKIP = new Set(['cover', 'gallery', 'items']);
const CONTENT_FIELDS = new Set(['difficulty', 'title', 'aliases', 'tags', 'author', 'authorNote', 'version', 'players', 'duration', 'stages', 'videoRun', 'videoVeteran', 'videoTrigger', 'videoEaster', 'videoMusic', 'videoOther']);
const fields = Object.entries(rules)
  .filter(([k, r]) => CONTENT_FIELDS.has(k) && !r.hidden && !SKIP.has(k))
  .map(([key, r]) => ({
    key,
    label: r.label ?? key,
    kind: r.kind ?? 'text',
    hint: String(r.hint ?? '').replace(/\*\*/g, '').slice(0, 140),
    requireLogin: Boolean(r.requireLogin),
    values: r.values ?? null,
  }));
---

<BaseLayout title="编辑条目 | ZE 地图资料站" description="按现状修改这张图的资料：只提交改动过的项，单项补充不需要登录。">
  <section class="se-hero">
    <div class="se-hero-inner">
      <div class="se-hero-copy">
        <p class="se-kicker">EDIT ENTRY</p>
        <h1 class="se-title">编辑条目</h1>
        <p class="se-lead">
          这张图现在的资料在下面，改哪一项就动哪一项；只有改动过的项会提交。
          <b>单项补充不需要登录</b>，整页编辑需要登录。
        </p>
      </div>
      <ol class="se-hero-steps">
        <li><b>1</b><span>选地图</span><em>中文名或内部名都行</em></li>
        <li><b>2</b><span>填内容</span><em>只改要改的那几项</em></li>
        <li><b>3</b><span>提交待审</span><em>进审核队列，可留理由</em></li>
        <li><b>4</b><span>审核上线</span><em>通过后写入条目并署名</em></li>
      </ol>
    </div>
  </section>

  <div class="se-layout">
    <main class="se-main">
      <div class="se-tabs" id="se-tabs">
        <button class="se-tab is-on" type="button" data-tab="single">单项补充</button>
        <button class="se-tab" type="button" data-tab="full">整页编辑（需登录）</button>
      </div>

      <section class="se-card">
        <label class="se-map">
          <span>地图</span>
          <input id="se-map" list="se-map-list" placeholder="中文名或内部名，比如 ze_lotr_minas_tirith" autocomplete="off" />
          <datalist id="se-map-list"></datalist>
        </label>
        <p class="se-note" id="se-map-note">正在读取地图索引…</p>
        <p class="se-auth" id="se-auth">正在读取登录状态…</p>
      </section>

      <section class="se-card" id="se-single" hidden>
        <div class="se-row">
          <p class="se-label">要补充哪一项</p>
          <div class="se-fieldchips" id="se-field"></div>
        </div>
      </section>

      <section class="se-card" id="se-local-pending" hidden>
        <div class="se-card-head">
          <h2 class="se-h2">本机待审投稿</h2>
          <span class="se-note">匿名投稿的撤回码存在这台设备上；换设备就找不回了</span>
        </div>
        <div id="se-local-list" class="se-local-list"></div>
      </section>

<section class="se-card" id="se-single-editor-card" hidden>
        <div id="se-single-editor"></div>
      </section>

      <section class="se-card" id="se-guides" hidden>
        <div class="se-card-head">
          <h2 class="se-h2">攻略条目</h2>
          <span class="se-note">和整页编辑共用同一份内容；这里新增的条目两边都会出现</span>
          <button class="se-btn se-btn-sm" type="button" id="se-guide-add">＋ 新增一条</button>
        </div>
        <div class="se-fieldchips" id="se-guide-chips"></div>
        <div id="se-guide-panel">
          <input id="se-guide-title" class="se-guide-title" placeholder="条目名称，例如：二.僵尸神器" />
          <div class="se-guide-bar" id="se-guide-toolbar"></div>
          <div class="se-guide-body" id="se-guide-body"></div>
          <div class="se-guide-foot">
            <button class="se-btn se-btn-sm" type="button" id="se-guide-delete">删除当前条目</button>
            <span class="se-note" id="se-guide-status"></span>
          </div>
        </div>
      </section>

      <section class="se-card" id="se-full" hidden>
        <p class="se-note">所有字段已按现状填好；改过的字段会高亮，提交时只带上改过的项。</p>
        <div id="se-full-fields" class="se-fields"></div>
        <div id="se-new-sections" class="se-new-sections"></div>
        <button class="se-btn se-btn-sm" type="button" id="se-add-section">＋ 新增一节（社区整理）</button>
      </section>

      <section class="se-card" id="se-items" hidden>
        <div class="se-card-head">
          <h2 class="se-h2">神器 / 道具</h2>
          <span class="se-note">改哪行交哪行；点「删除」＝这件本图没有</span>
          <button class="se-btn se-btn-sm" type="button" id="se-item-add">+ 新增一件</button>
        </div>
        <div class="se-items-wrap">
          <table class="se-items">
            <thead>
              <tr><th>道具名</th><th>冷却（秒）</th><th>次数</th><th>说明</th><th>备注</th><th>操作</th></tr>
            </thead>
            <tbody id="se-items-body"></tbody>
          </table>
        </div>
      </section>

      <section class="se-card" id="se-media" hidden>
        <div class="se-card-head">
          <h2 class="se-h2">封面 / 图片集</h2>
          <span class="se-note">每个框里选好文件后，点框里的「上传这张」；上传后进审核</span>
        </div>
        <div class="se-media-grid">
          <div class="se-file" id="se-cover-box">
            <span>换封面</span>
            <input type="file" id="se-cover" accept="image/*" />
            <em>PNG / JPG / WebP，单张</em>
            <button class="se-btn se-btn-sm" type="button" id="se-cover-go" disabled>上传这张</button>
          </div>
          <div class="se-file" id="se-gallery-box">
            <span>加图片集</span>
            <input type="file" id="se-gallery" accept="image/*" />
            <em id="se-gallery-hint">工坊预览图之外，玩家截图</em>
            <button class="se-btn se-btn-sm" type="button" id="se-gallery-go" disabled>上传这张</button>
          </div>
        </div>
      </section>

      <section class="se-card se-submit" id="se-submit" hidden>
        <div class="se-submit-bar">
          <span id="se-changed" class="se-changed-chip">改动 0 项</span>
          <div class="se-submit-acts">
            <button class="se-btn se-btn-primary" type="button" id="se-send">提交待审</button>
          </div>
        </div>
        <p class="se-result" id="se-result" hidden></p>
      </section>
    </main>

    <aside class="se-side">
      <div class="se-card">
        <h2 class="se-h2">这张图现在的内容</h2>
        <dl class="se-dl" id="se-side-dl"></dl>
      </div>
      <div class="se-card">
        <h2 class="se-h2">已通过的社区投稿</h2>
        <ul class="se-notes" id="se-side-notes"></ul>
      </div>
    </aside>
  </div>

  <script type="application/json" id="se-field-defs" set:html={JSON.stringify(fields)} />

  <script>
    import { Editor, Node } from '@tiptap/core';
    import StarterKit from '@tiptap/starter-kit';

    type FieldDef = { key: string; label: string; kind: string; hint: string; requireLogin: boolean; values: string[] | null };
    type MapRow = Record<string, any>;
    const defs: FieldDef[] = JSON.parse(document.getElementById('se-field-defs')?.textContent ?? '[]');
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    const els = {
      map: $<HTMLInputElement>('se-map')!,
      mapList: $<HTMLDataListElement>('se-map-list')!,
      mapNote: $('se-map-note')!,
      auth: $('se-auth')!,
      tabs: $('se-tabs')!,
      single: $('se-single')!,
      full: $('se-full')!,
      items: $('se-items')!,
      media: $('se-media')!,
      submit: $('se-submit')!,
      field: $('se-field')!,
      singleEditor: $('se-single-editor')!,
      fullFields: $('se-full-fields')!,
      itemsBody: $('se-items-body')!,
      changed: $('se-changed')!,
      result: $<HTMLParagraphElement>('se-result')!,
      sideDl: $('se-side-dl')!,
      sideNotes: $('se-side-notes')!,
      cover: $<HTMLInputElement>('se-cover')!,
      gallery: $<HTMLInputElement>('se-gallery')!,
    };

    let index: MapRow[] = [];
    let current: MapRow | null = null;
    let mode: 'single' | 'full' = 'single';
    let currentField = 'difficulty';
    let logged = false;
    let base: Record<string, string> = {};
    let now: Record<string, string> = {};
    type ItemRow = { name: string; cd: string; uses: string; intro: string; note: string; removed: boolean };
    let itemRows: ItemRow[] = [];
    let itemBase: ItemRow[] = [];
    const pendingMedia: { cover?: any; gallery: any[] } = { gallery: [] };

    const defOf = (k: string) => defs.find((d) => d.key === k);
    const kindOf = (k: string) => defOf(k)?.kind ?? 'text';

    const valueOf = (row: MapRow, key: string): string => {
      const v = row[key];
      if (v == null) return '';
      /* 标签用「、」连接：它本来就是多选，用换行会在单行控件里粘成一串 */
      if (Array.isArray(v)) return v.join(key === 'tags' ? '、' : '\n');
      return String(v);
    };

    /* 标签词表（全站已用过的标签，点一下就是选中） */
    let tagVocab: string[] = [];
    fetch('/submit/tags.json')
      .then((r) => (r.ok ? r.json() : []))
      .then((list: any) => {
        tagVocab = Array.isArray(list?.tags) ? list.tags.map((x: any) => String(x?.n ?? '')).filter(Boolean) : [];
        if (currentField === 'tags') renderSingle();
      })
      .catch((err) => {
        console.error('[submit/edit] 载入失败', err);});

    /** 把「、」分隔的字符串做成可点的标签片（原来的按钮式交互） */
    function tagEditor(value: string, onChange: (v: string) => void): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'se-chips';
      const current = () => value.split(/[、,，\s]+/).map((s) => s.trim()).filter(Boolean);
      const sync = () => {
        const set = new Set(current());
        for (const chip of wrap.querySelectorAll<HTMLButtonElement>('.se-chip')) {
          chip.classList.toggle('is-on', set.has(chip.dataset.tag ?? ''));
        }
      };
      const addChip = (tag: string) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'se-chip';
        b.dataset.tag = tag;
        b.textContent = tag;
        b.addEventListener('click', () => {
          const list = current();
          const at = list.indexOf(tag);
          if (at >= 0) list.splice(at, 1);
          else list.push(tag);
          value = list.join('、');
          onChange(value);
          sync();
        });
        wrap.append(b);
      };
      for (const t of current()) addChip(t);
      for (const t of tagVocab) if (!current().includes(t)) addChip(t);
      wrap.classList.add('is-vocab');
      sync();

      /* 新标签：输完回车 / 点「加上」 */
      const row = document.createElement('div');
      row.className = 'se-chip-add';
      const inp = document.createElement('input');
      inp.type = 'text';
      inp.placeholder = '新标签，回车加上';
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'se-btn se-btn-sm';
      add.textContent = '加上';
      const commit = () => {
        const t = inp.value.trim();
        if (!t) return;
        const list = current();
        if (!list.includes(t)) list.push(t);
        value = list.join('、');
        onChange(value);
        inp.value = '';
        wrap.textContent = '';
        for (const x of current()) addChip(x);
        sync();
      };
      add.addEventListener('click', commit);
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          commit();
        }
      });
      row.append(inp, add);
      const box = document.createElement('div');
      box.className = 'se-tagbox';
      box.append(wrap, row);
      return box;
    }

    /** 难度这类 enum：也做成按钮片，不用下拉（原来的样子） */
    function enumEditor(def: FieldDef, value: string, onChange: (v: string) => void): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'se-chips';
      for (const opt of def.values ?? []) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'se-chip' + (opt === value ? ' is-on' : '');
        b.textContent = opt;
        b.addEventListener('click', () => {
          for (const c of wrap.querySelectorAll('.se-chip')) c.classList.toggle('is-on', c === b);
          onChange(opt);
        });
        wrap.append(b);
      }
      return wrap;
    }

    function editorFor(def: FieldDef, value: string, onChange: (v: string) => void, hideLabel = false): HTMLElement {
      const wrap = document.createElement('label');
      wrap.className = 'se-field';
      if (!hideLabel) {
        const cap = document.createElement('span');
        cap.textContent = def.label;
        wrap.append(cap);
      }
      let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      if (def.kind === 'enum' && Array.isArray(def.values)) {
        input = document.createElement('select');
        for (const v of def.values) {
          const o = document.createElement('option');
          o.value = v;
          o.textContent = v;
          input.append(o);
        }
        (input as HTMLSelectElement).value = value || def.values[0];
      } else if (def.kind === 'longtext' || def.kind === 'urlList' || def.kind === 'textlist') {
        input = document.createElement('textarea');
        input.rows = def.kind === 'longtext' ? 5 : 3;
        input.value = value;
      } else if (def.kind === 'int') {
        input = document.createElement('input');
        input.type = 'number';
        input.min = '0';
        input.value = value;
      } else {
        input = document.createElement('input');
        input.type = 'text';
        input.value = value;
      }
      input.addEventListener('input', () => onChange(input.value));
      wrap.append(input);
      if (def.hint) {
        const em = document.createElement('em');
        em.className = 'se-hint';
        em.textContent = def.hint.slice(0, 110);
        wrap.append(em);
      }
      return wrap;
    }

    function renderSide(row: MapRow) {
      const rows: Array<[string, string]> = [
        ['难度', row.difficulty ?? '—'],
        ['标签', Array.isArray(row.tags) ? row.tags.join('、') : '—'],
        ['作者', row.author ?? '—'],
        ['版本', row.version ?? '—'],
        ['人数', row.players ?? '—'],
        ['时长', row.duration ?? '—'],
        ['关卡', row.stages != null ? String(row.stages) : '—'],
        ['图片集', row.galleryCount ? `${row.galleryCount} 张` : '—'],
      ];
      els.sideDl.textContent = '';
      for (const [k, v] of rows) {
        const div = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.textContent = String(v);
        div.append(dt, dd);
        els.sideDl.append(div);
      }
      els.sideNotes.textContent = '';
      const notes: any[] = Array.isArray(row.notes) ? row.notes : [];
      if (!notes.length) {
        const li = document.createElement('li');
        li.className = 'se-empty';
        li.textContent = '还没有人投过正文 —— 你写的会成为第一条（通过后显示在条目里）。';
        els.sideNotes.append(li);
      }
      for (const n of notes.slice(0, 6)) {
        const li = document.createElement('li');
        const head = document.createElement('div');
        head.className = 'se-note-head';
        head.textContent = `${n.field}${n.title ? `「${n.title}」` : ''} · ${n.by || '匿名'}`;
        const body = document.createElement('p');
        body.className = 'se-note-body';
        body.textContent = String(n.text ?? '').slice(0, 64) + '…';
        const acts = document.createElement('div');
        acts.className = 'se-note-acts';
        for (const label of ['修订这条', '申请删除']) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'se-mini';
          b.textContent = label;
          b.addEventListener('click', () => {
            els.result.hidden = false;
            els.result.textContent = `「${label}」在正式版里会走修订/删除申请；这一轮先只验证编辑表单。`;
          });
          acts.append(b);
        }
        li.append(head, body, acts);
        els.sideNotes.append(li);
      }
    }

    /* 特殊项：没有普通编辑器，各自落在下面的卡片里 */
    const SPECIAL_FIELDS = [
      { key: 'items', label: '神器 / 道具' },
      { key: 'guides', label: '攻略条目' },
      { key: 'cover', label: '地图封面' },
      { key: 'gallery', label: '图片集图片' },
    ];

    /* 攻略条目：和整页编辑同一份 blocks；提交时整组攻略条目一起进 patch.blocks。 */
    const GuideFigure = Node.create({
      name: 'figure',
      group: 'block',
      atom: true,
      draggable: true,
      addAttributes() {
        return { src: { default: null }, side: { default: 'left' }, n: { default: null } };
      },
      parseHTML() {
        return [{
          tag: 'figure.doc-figure',
          getAttrs: (element: HTMLElement) => ({
            src: element.querySelector('img')?.getAttribute('src') ?? null,
            side: element.classList.contains('doc-figure-right') ? 'right' : 'left',
          }),
        }];
      },
      renderHTML({ HTMLAttributes }: any) {
        const side = HTMLAttributes.side === 'right' ? 'right' : 'left';
        return ['figure', { class: 'doc-figure doc-figure-' + side }, ['img', { src: HTMLAttributes.src ?? '', alt: '' }]];
      },
    });
    const emptyDoc = () => ({ type: 'doc', content: [] });
    let guideItems: Array<{ id: string; title: string; doc: any }> = [];
    let guideActive = 0;
    let guideDirty = false;
    let guideEditor: Editor | null = null;
    let guidePicker: HTMLElement | null = null;
    const guideStatus = (text: string) => { const el = document.getElementById('se-guide-status'); if (el) el.textContent = text; };
    const insertGuideFigure = (src: string) => {
      if (!guideEditor || !src) return;
      guideEditor.chain().focus().insertContent({ type: 'figure', attrs: { src, side: 'left' } }).run();
      guideDirty = true;
      closeGuidePicker();
      guideStatus('图片已插入；提交后进入审核。');
    };
    function closeGuidePicker() { if (guidePicker) guidePicker.hidden = true; }
    function openGuidePicker() {
      if (!guidePicker) {
        const overlay = document.createElement('div');
        overlay.className = 'se-guide-picker';
        overlay.hidden = true;
        overlay.innerHTML = '<div class="se-guide-picker-dialog"><div class="se-guide-picker-head"><strong>插入图片</strong><button type="button" data-close>×</button></div><div class="se-guide-picker-row"><input type="text" data-url placeholder="粘贴站内图片地址，例如 /images/..." /><button type="button" data-insert>插入</button></div><div class="se-guide-picker-row"><label class="se-btn se-btn-sm">上传图片<input type="file" accept="image/*" data-file hidden /></label><span class="se-note" data-status></span></div><div class="se-guide-picker-grid" data-grid></div></div>';
        document.body.append(overlay);
        const grid = overlay.querySelector('[data-grid]')!;
        const gallery = Array.isArray((current as any)?.gallery) ? (current as any).gallery : [];
        for (const image of gallery) {
          if (!image?.src) continue;
          const button = document.createElement('button');
          button.type = 'button';
          button.title = image.caption || image.src;
          button.innerHTML = '<img alt="" src="' + String(image.src).replace(/"/g, '&quot;') + '" />';
          button.addEventListener('click', () => insertGuideFigure(image.src));
          grid.append(button);
        }
        overlay.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          if (target === overlay || target.closest('[data-close]')) closeGuidePicker();
        });
        overlay.querySelector('[data-insert]')?.addEventListener('click', () => {
          const input = overlay.querySelector('[data-url]') as HTMLInputElement;
          insertGuideFigure(input.value.trim());
        });
        overlay.querySelector('[data-file]')?.addEventListener('change', async (event) => {
          const file = (event.target as HTMLInputElement).files?.[0];
          if (!file || !current) return;
          const status = overlay.querySelector('[data-status]')!;
          status.textContent = '上传中…';
          const fd = new FormData();
          fd.append('map', current.slug);
          fd.append('image', file);
          fd.append('caption', file.name.replace(/\.[^.]+$/, ''));
          try {
            const res = await fetch('/api/content-gallery', { method: 'POST', body: fd });
            const data = await res.json();
            if (!res.ok || !data.ok) throw new Error(data.error || 'HTTP ' + res.status);
            const src = data.media?.localSrc || data.media?.src;
            if (!src) throw new Error('没有拿到图片地址');
            insertGuideFigure(src);
          } catch (error) {
            status.textContent = '上传失败：' + (error instanceof Error ? error.message : String(error));
          }
        });
        guidePicker = overlay;
      }
      guidePicker.hidden = false;
      (guidePicker.querySelector('[data-url]') as HTMLInputElement)?.focus();
    }
    function ensureGuideEditor() {
      if (guideEditor) return guideEditor;
      const host = document.getElementById('se-guide-body');
      if (!host) return null;
      guideEditor = new Editor({
        element: host,
        extensions: [StarterKit.configure({ heading: { levels: [3, 4] } }), GuideFigure],
        content: guideItems[guideActive]?.doc ?? emptyDoc(),
        onUpdate: ({ editor }) => {
          const item = guideItems[guideActive];
          if (item) item.doc = editor.getJSON();
          guideDirty = true;
          guideStatus('已修改；提交后进入审核队列。');
        },
      });
      return guideEditor;
    }
    function renderGuideToolbar() {
      const bar = document.getElementById('se-guide-toolbar');
      if (!bar || bar.dataset.ready) return;
      bar.dataset.ready = '1';
      const command = (label: string, title: string, run: () => void) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'se-btn se-btn-sm';
        button.textContent = label;
        button.title = title;
        button.addEventListener('click', run);
        bar.append(button);
      };
      const chain = () => guideEditor?.chain().focus();
      command('B', '粗体', () => chain()?.toggleBold().run());
      command('I', '斜体', () => chain()?.toggleItalic().run());
      command('U', '下划线', () => chain()?.toggleUnderline().run());
      command('H3', '三级标题', () => chain()?.toggleHeading({ level: 3 }).run());
      command('H4', '四级标题', () => chain()?.toggleHeading({ level: 4 }).run());
      command('•', '无序列表', () => chain()?.toggleBulletList().run());
      command('1.', '有序列表', () => chain()?.toggleOrderedList().run());
      command('🖼', '插入图片', () => openGuidePicker());
    }
    function renderGuides() {
      const card = document.getElementById('se-guides');
      if (!card) return;
      const visible = mode === 'single' && currentField === 'guides' && !!current;
      card.hidden = !visible;
      if (!visible) return;
      const chips = document.getElementById('se-guide-chips');
      const panel = document.getElementById('se-guide-panel');
      if (!chips || !panel) return;
      chips.replaceChildren();
      panel.hidden = guideItems.length === 0;
      guideItems.forEach((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'se-fchip' + (index === guideActive ? ' is-on' : '');
        button.textContent = item.title || '未命名条目';
        button.addEventListener('click', () => {
          guideActive = index;
          renderGuides();
        });
        chips.append(button);
      });
      if (!guideItems.length) {
        guideStatus('这张图还没有攻略条目，点右上角「新增一条」开始写。');
        return;
      }
      const title = document.getElementById('se-guide-title') as HTMLInputElement | null;
      if (title && document.activeElement !== title) title.value = guideItems[guideActive]?.title ?? '';
      renderGuideToolbar();
      const editor = ensureGuideEditor();
      editor?.commands.setContent(guideItems[guideActive]?.doc ?? emptyDoc(), false);
      guideStatus(guideDirty ? '有未提交的修改。' : '');
    }
    document.getElementById('se-guide-title')?.addEventListener('input', (event) => {
      const item = guideItems[guideActive];
      if (!item) return;
      item.title = (event.target as HTMLInputElement).value;
      guideDirty = true;
      guideStatus('已修改；提交后进入审核队列。');
      const chip = document.querySelectorAll('#se-guide-chips .se-fchip')[guideActive] as HTMLElement | undefined;
      if (chip) chip.textContent = item.title || '未命名条目';
    });
    document.getElementById('se-guide-add')?.addEventListener('click', () => {
      guideItems.push({ id: 'guide-' + Date.now(), title: '新的攻略技巧', doc: emptyDoc() });
      guideActive = guideItems.length - 1;
      guideDirty = true;
      renderGuides();
    });
    document.getElementById('se-guide-delete')?.addEventListener('click', () => {
      if (!guideItems.length) return;
      if (!confirm('删除当前攻略条目？提交后需要审核通过才会生效。')) return;
      guideItems.splice(guideActive, 1);
      guideActive = Math.max(0, Math.min(guideActive, guideItems.length - 1));
      guideDirty = true;
      renderGuides();
    });


    function renderSingle() {
      els.field.textContent = '';
      /* 原来的样子：所有可投的项铺成一排按钮，点哪个改哪个（不用下拉） */
      for (const def of defs) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'se-fchip' + (def.key === currentField ? ' is-on' : '');
        b.dataset.key = def.key;
        b.textContent = def.label;
        b.addEventListener('click', () => {
          currentField = def.key;
          renderSingle();
        });
        els.field.append(b);
      }
      for (const sp of SPECIAL_FIELDS) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'se-fchip' + (sp.key === currentField ? ' is-on' : '');
        b.dataset.key = sp.key;
        b.textContent = sp.label;
        b.addEventListener('click', () => {
          currentField = sp.key;
          renderSingle();
        });
        els.field.append(b);
      }
      els.singleEditor.textContent = '';
      const isSpecial = SPECIAL_FIELDS.some((s) => s.key === currentField);
      if (!isSpecial) {
        const def = defOf(currentField)!;
        const onChange = (v: string) => { now[currentField] = v; renderCount(); };
        if (def.key === 'tags') {
          els.singleEditor.append(tagEditor(now.tags ?? '', onChange));
        } else if (def.kind === 'enum') {
          els.singleEditor.append(enumEditor(def, now[currentField] ?? '', onChange));
        } else {
          els.singleEditor.append(editorFor(def, now[currentField] ?? '', onChange, true));
        }
      }
      els.singleEditor.hidden = isSpecial;
      const editorCard = document.getElementById('se-single-editor-card');
      if (editorCard) editorCard.hidden = mode !== 'single' || isSpecial;
      els.items.hidden = !(isSpecial && currentField === 'items') || mode === 'full';
      els.media.hidden = !(isSpecial && (currentField === 'cover' || currentField === 'gallery'));
      const guidesCard = document.getElementById('se-guides');
      if (guidesCard) guidesCard.hidden = !(isSpecial && currentField === 'guides') || mode !== 'single';
      if (isSpecial && currentField === 'guides') renderGuides();
      const coverBox = document.getElementById('se-cover-box');
      const galleryBox = document.getElementById('se-gallery-box');
      if (coverBox) coverBox.hidden = currentField !== 'cover';
      if (galleryBox) galleryBox.hidden = currentField !== 'gallery';
    }

    function renderFull() {
      els.fullFields.textContent = '';
      for (const def of defs) {
        const row = document.createElement('div');
        row.className = 'se-full-row';
        row.dataset.key = def.key;
        const onChange = (v: string) => {
          now[def.key] = v;
          row.classList.toggle('is-changed', v !== base[def.key]);
          renderCount();
        };
        if (def.key === 'tags') row.append(tagEditor(now.tags ?? '', onChange));
        else if (def.kind === 'enum') row.append(enumEditor(def, now[def.key] ?? '', onChange));
        else row.append(editorFor(def, now[def.key] ?? '', onChange));
        if (now[def.key] !== base[def.key]) row.classList.add('is-changed');
        els.fullFields.append(row);
      }
    }

    function renderItems() {
      els.itemsBody.textContent = '';
      if (!itemRows.length) {
        const tr = document.createElement('tr');
        const td = document.createElement('td');
        td.colSpan = 6;
        td.className = 'se-empty';
        td.textContent = '这张图还没有神器 / 道具表，点上面的「+ 新增一件」加一行。';
        tr.append(td);
        els.itemsBody.append(tr);
        return;
      }
      for (const [i, it] of itemRows.entries()) {
        const tr = document.createElement('tr');
        if (it.removed) tr.classList.add('is-removed');
        const nameTd = document.createElement('td');
        if (i < itemBase.length) {
          /* 改名：名字也做成输入框，提交时按「删旧 + 加新」处理（2026-10-27） */
          const inp = document.createElement('input');
          inp.type = 'text';
          inp.value = it.name;
          inp.style.width = '110px';
          inp.addEventListener('input', () => { itemRows[i].name = inp.value; renderCount(); });
          nameTd.append(inp);
        } else {
          /* 新增行要能填名字 */
          const inp = document.createElement('input');
          inp.type = 'text';
          inp.placeholder = '道具名';
          inp.value = it.name;
          inp.style.width = '110px';
          inp.addEventListener('input', () => { itemRows[i].name = inp.value; renderCount(); });
          nameTd.append(inp);
        }
        const mkInput = (val: string, w: string, on: (v: string) => void, text = '') => {
          const td = document.createElement('td');
          const inp = document.createElement('input');
          inp.value = val;
          inp.style.width = w;
          inp.placeholder = text;
          inp.addEventListener('input', () => { on(inp.value); renderCount(); });
          td.append(inp);
          return td;
        };
        const intro = mkInput(it.intro, '100%', (v) => (itemRows[i].intro = v), '一句话说明（选填）');
        const note = mkInput(it.note, '100%', (v) => (itemRows[i].note = v), '备注');
        const cd = mkInput(it.cd, '74px', (v) => (itemRows[i].cd = v), '原表未给');
        const uses = mkInput(it.uses, '58px', (v) => (itemRows[i].uses = v), '—');
        const actTd = document.createElement('td');
        actTd.className = 'se-item-acts';
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'se-btn se-btn-sm';
        del.textContent = it.removed ? '恢复' : '删除';
        del.addEventListener('click', () => {
          if (i >= itemBase.length) {
            itemRows.splice(i, 1);
          } else {
            itemRows[i].removed = !itemRows[i].removed;
          }
          renderItems();
          renderCount();
        });
        actTd.append(del);
        tr.append(nameTd, cd, uses, intro, note, actTd);
        els.itemsBody.append(tr);
      }
    }

    function changedFields() {
      return Object.keys(now).filter((k) => now[k] !== base[k]);
    }

    function changedItems() {
      const out: Array<Record<string, unknown>> = [];
      for (const [i, it] of itemRows.entries()) {
        const b = itemBase[i];
        if (!b) {
          if (it.name.trim()) out.push({ action: 'add', name: it.name, cd: it.cd, uses: it.uses, intro: it.intro, note: it.note });
          continue;
        }
        /* 改名：旧名删掉、新名加上，字段沿用这一行（避免审核台看起来像误删） */
        if (!it.removed && !b.removed && it.name.trim() && it.name.trim() !== b.name) {
          out.push({ action: 'remove', name: b.name, intro: '改名：' + b.name + ' → ' + it.name, note: '改名' });
          out.push({ action: 'add', name: it.name, cd: it.cd, uses: it.uses, intro: it.intro, note: it.note });
          continue;
        }
        if (it.removed && !b.removed) {
          out.push({ action: 'remove', name: it.name, intro: it.intro, note: it.note || '作者申请删除' });
          continue;
        }
        if (!it.removed && b.removed) {
          out.push({ action: 'add', name: it.name, cd: it.cd, uses: it.uses, intro: it.intro, note: it.note });
          continue;
        }
        /*
         * 只带上真正改过的列：这张图是手写表（maps.json 里只有名字），
         * 如果整行覆盖提交，空的 cd/uses 会把原来正文里的数值抹掉。
         */
        const diff: Record<string, unknown> = { action: 'update', name: it.name };
        for (const k of ['cd', 'uses', 'intro', 'note'] as const) {
          if (it[k] !== b[k]) diff[k] = it[k];
        }
        if (Object.keys(diff).length > 2) out.push(diff);
      }
      return out;
    }

    function renderCount() {
      const n = changedFields().length + (changedItems().length ? 1 : 0);
      els.changed.textContent = `改动 ${n} 项`;
    }

    function loadCurrent(row: MapRow) {
      current = row;
      base = {};
      now = {};
      for (const def of defs) {
        base[def.key] = valueOf(row, def.key);
        now[def.key] = base[def.key];
      }
      itemRows = (Array.isArray(row.items) ? row.items : []).map((r: any) => ({
        name: String(r.n ?? r.name ?? ''),
        cd: String(r.c ?? r.cd ?? ''),
        uses: String(r.u ?? r.uses ?? ''),
        intro: String(r.i ?? r.intro ?? ''),
        note: String(r.note ?? ''),
        removed: String(r.action ?? '') === 'remove',
      }));
      itemBase = itemRows.map((r) => ({ ...r }));
      if (guideEditor) { guideEditor.destroy(); guideEditor = null; }
      guideItems = (Array.isArray((row as any).guides) ? (row as any).guides : []).map((guide: any) => ({
        id: String(guide?.id ?? ''),
        title: String(guide?.title ?? ''),
        doc: guide?.doc ?? emptyDoc(),
      }));
      guideActive = 0;
      guideDirty = false;
      renderSide(row);
      renderSingle();
      renderFull();
      renderItems();
      renderCount();
      els.submit.hidden = false;
      els.result.hidden = true;
      /* 载入后按当前模式显示对应的编辑区（之前这里漏了，单项补充会一直藏着） */
      setMode(mode);
    }

    function setMode(next: 'single' | 'full') {
      if (next === 'full') {
        if (!current) {
          els.mapNote.textContent = '先选一张图，再去整页编辑。';
          return;
        }
        location.href = `/edit/${current.slug}/`;
        return;
      }
      mode = next;
      for (const b of els.tabs.querySelectorAll<HTMLButtonElement>('.se-tab')) b.classList.toggle('is-on', b.dataset.tab === next);
      els.single.hidden = next !== 'single';
      els.full.hidden = next !== 'full';
      els.items.hidden = next !== 'full' && currentField !== 'items';
      if (next === 'single') renderSingle();
      /* 单项的内容卡只在单项档显示；切到整页编辑时必须一起收起，否则会出现两份难度 */
      if (next !== 'single') {
        const editorCard = document.getElementById('se-single-editor-card');
        if (editorCard) editorCard.hidden = true;
      }
      els.media.hidden = next !== 'single' || !(currentField === 'cover' || currentField === 'gallery');
      els.mapNote.textContent = current ? `正在编辑《${current.title}》（${current.slug}）的资料。` : '输入名字开始。';
    }

    els.tabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.se-tab');
      if (btn) setMode(btn.dataset.tab as 'single' | 'full');
    });
    $('se-item-add')?.addEventListener('click', () => {
      itemRows.push({ name: '', cd: '', uses: '', intro: '', note: '', removed: false });
      renderItems();
    });
    els.map.addEventListener('change', () => {
      const q = els.map.value.trim().toLowerCase();
      const hit =
        index.find((r) => String(r.slug).toLowerCase() === q) ??
        index.find((r) => String(r.title ?? '').toLowerCase() === q) ??
        index.find((r) => String(r.title ?? '').toLowerCase().includes(q) && q.length >= 2);
      if (!hit) { els.mapNote.textContent = '没找到这张图，换个名字试试。'; return; }
      loadCurrent(hit);
    });

    /* 整页编辑：新增「条目」= 新的一节（社区整理），提交时作为 section 字段 */
    const newSections: Array<{ title: string; text: string }> = [];
    $('se-add-section')?.addEventListener('click', () => {
      const box = document.createElement('div');
      box.className = 'se-newsec';
      const title = document.createElement('input');
      title.type = 'text';
      title.placeholder = '小节标题（2~20 字）';
      const ta = document.createElement('textarea');
      ta.placeholder = '这一节的内容…';
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'se-btn se-btn-sm';
      del.textContent = '删除这一节';
      const item = { title: '', text: '' };
      title.addEventListener('input', () => {
        item.title = title.value;
        renderCount();
      });
      ta.addEventListener('input', () => {
        item.text = ta.value;
        renderCount();
      });
      del.addEventListener('click', () => {
        const at = newSections.indexOf(item);
        if (at >= 0) newSections.splice(at, 1);
        box.remove();
        renderCount();
      });
      box.append(title, ta, del);
      $('se-new-sections')!.append(box);
      newSections.push(item);
    });

    /* ---------- 提交文字改动 ---------- */
    function payload() {
      const items: Array<Record<string, unknown>> = [];
      const fieldsChanged = changedFields();
      for (const k of fieldsChanged) {
        const def = defOf(k)!;
        let v: unknown = now[k];
        if (def.kind === 'urlList' || def.kind === 'textlist') v = now[k].split('\n').map((s) => s.trim()).filter(Boolean);
        items.push({ field: k, value: v });
      }
      const its = changedItems();
      if (its.length) items.push({ field: 'items', value: its });
      const secs = newSections.filter((s) => s.title.trim() && s.text.trim());
      if (secs.length) items.push({ field: 'section', value: { sections: secs } });
      return items;
    }

    const INFOBOX_FIELDS = new Set(['author', 'authorNote', 'version', 'players', 'duration', 'stages', 'aliases']);
    const VIDEO_FIELDS: Record<string, string> = { videoUrls: 'run', videoRun: 'run', videoVeteran: 'guide', videoTrigger: 'guide', videoEaster: 'guide', videoMusic: 'music', videoOther: 'guide' };
    const numberOf = (value: unknown) => {
      if (value === '' || value === null || value === undefined) return null;
      const number = Number(value);
      return Number.isFinite(number) ? number : null;
    };
    function contentPatch(items: Array<Record<string, unknown>>) {
      const patch: Record<string, unknown> = { slug: current!.slug, mode: 'single' };
      if (current?.contentRev) patch.baseRev = String(current.contentRev);
      const infobox: Record<string, string> = {};
      const videos: Array<{ url: string; kind: string }> = [];
      const seenVideos = new Set<string>();
      for (const item of items) {
        const field = String(item.field ?? '');
        const value = item.value;
        if (field === 'title') patch.title = String(value ?? '').trim();
        else if (field === 'difficulty') patch.difficulty = String(value ?? '');
        else if (field === 'tags') patch.tags = String(value ?? '').split(/[、,，\s]+/).map((tag) => tag.trim()).filter(Boolean);
        else if (field === 'items') {
          patch.itemEdits = (Array.isArray(value) ? value : []).map((row: any) => ({
            ...row,
            cd: numberOf(row?.cd),
            uses: numberOf(row?.uses),
          }));
        } else if (VIDEO_FIELDS[field]) {
          const kind = VIDEO_FIELDS[field];
          for (const url of Array.isArray(value) ? value : [value]) {
            const text = String(url ?? '').trim();
            if (!text || seenVideos.has(text)) continue;
            seenVideos.add(text);
            videos.push({ url: text, kind });
          }
        } else if (INFOBOX_FIELDS.has(field)) {
          const text = Array.isArray(value) ? value.join('\n') : String(value ?? '');
          infobox[field] = text.slice(0, 200);
        }
      }
      if (Object.keys(infobox).length) patch.infobox = infobox;
      if (videos.length) patch.videos = videos;
      if (pendingMedia.cover || pendingMedia.gallery.length) patch.media = { ...(pendingMedia.cover ? { cover: pendingMedia.cover } : {}), gallery: pendingMedia.gallery };
      return patch;
    }

    function renderLocalPending() {
      const box = document.getElementById('se-local-pending');
      const list = document.getElementById('se-local-list');
      if (!box || !list) return;
      let rows: Array<{ id: number; token: string; slug: string; title?: string; at: number }> = [];
      try { rows = JSON.parse(localStorage.getItem('ze:pending') || '[]'); } catch {}
      rows = rows.filter((r) => r && r.id && r.token);
      box.hidden = rows.length === 0;
      list.textContent = '';
      for (const r of rows) {
        const row = document.createElement('div');
        row.className = 'se-local-row';
        const label = document.createElement('span');
        label.textContent = `#${r.id} · ${r.title ?? r.slug} · ${new Date(r.at).toLocaleString()}`;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'se-btn se-btn-sm';
        btn.textContent = '撤回';
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const res = await fetch('/api/page-revision/withdraw', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ id: r.id, token: r.token }),
            });
            const j = await res.json();
            if (!res.ok || !j.ok) throw new Error(j.error || '撤回失败');
            const left = rows.filter((x) => x.id !== r.id);
            localStorage.setItem('ze:pending', JSON.stringify(left));
            renderLocalPending();
          } catch (err) {
            btn.disabled = false;
            btn.textContent = '撤回失败';
            btn.title = err instanceof Error ? err.message : String(err);
          }
        });
        row.append(label, btn);
        list.append(row);
      }
    }

    async function sendText() {
      if (!current) return;
      const items = payload();
      if (!items.length && !guideDirty) {
        els.result.hidden = false;
        els.result.textContent = '还没有改动 —— 改一项再提交。';
        return;
      }
      els.result.hidden = false;
      els.result.textContent = '提交中…';
      try {
        const patch = contentPatch(items);
        if (guideDirty) {
          const activeDoc = guideEditor?.getJSON();
          patch.blocks = guideItems.map((item, index) => ({
            id: item.id,
            type: 'guideItem',
            title: item.title,
            doc: index === guideActive && activeDoc ? activeDoc : (item.doc ?? emptyDoc()),
          }));
          patch.guideCleared = patch.blocks.length === 0;
        }
        const changed = Object.keys(patch).filter((key) => !['slug', 'mode', 'baseRev'].includes(key));
        if (!changed.length) {
          els.result.textContent = '没有可提交到内容层的字段。';
          return;
        }
        const res = await fetch('/api/page-revision', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(patch),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);
        const okText = `已提交，编号 #${data.id ?? '?'}。审核通过后会写进条目。`;
        if (data.withdrawToken) {
          try {
            const list = JSON.parse(localStorage.getItem('ze:pending') || '[]');
            list.push({ id: data.id, token: data.withdrawToken, slug: current.slug, title: current.title, at: Date.now() });
            localStorage.setItem('ze:pending', JSON.stringify(list.slice(-15)));
            renderLocalPending();
          } catch {}
        }
        pendingMedia.cover = undefined;
        pendingMedia.gallery.length = 0;
        /* 先重载（把改动清零），再把成功提示放回去 —— 顺序反了提示会被 loadCurrent 清掉 */
        loadCurrent(current);
        els.result.hidden = false;
        els.result.textContent = okText;
      } catch (e) {
        els.result.textContent = '提交失败：' + (e instanceof Error ? e.message : String(e));
      }
    }

    /* ---------- 上传封面 / 图片集 ---------- */
    async function upload(fileInput: HTMLInputElement, kind: 'cover' | 'gallery') {
      const file = fileInput.files?.[0];
      if (!file || !current) return;
      const fd = new FormData();
      fd.append('map', current.slug);
      fd.append(kind === 'cover' ? 'cover' : 'image', file);
      if (kind === 'gallery') fd.append('caption', file.name.replace(/\.[^.]+$/, ''));
      els.result.hidden = false;
      els.result.textContent = '上传中…';
      try {
        const res = await fetch(kind === 'cover' ? '/api/content-cover' : '/api/content-gallery', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);
        if (kind === 'cover') pendingMedia.cover = data.media;
        else pendingMedia.gallery.push(data.media);
        els.result.textContent = '图片已暂存；填完这一项后点提交，进入审核。';
        fileInput.value = '';
      } catch (e) {
        els.result.textContent = '上传失败：' + (e instanceof Error ? e.message : String(e));
      }
    }

    $('se-send')!.addEventListener('click', sendText);
    /* 每个框自己上传：选好文件后按钮才可点（不再用底部一个混合按钮） */
    const coverGo = document.getElementById('se-cover-go') as HTMLButtonElement | null;
    const galleryGo = document.getElementById('se-gallery-go') as HTMLButtonElement | null;
    els.cover.addEventListener('change', () => {
      if (coverGo) coverGo.disabled = !els.cover.files?.length;
    });
    els.gallery.addEventListener('change', () => {
      if (galleryGo) galleryGo.disabled = !els.gallery.files?.length;
    });
    coverGo?.addEventListener('click', async () => {
      await upload(els.cover, 'cover');
      if (coverGo) coverGo.disabled = true;
    });
    galleryGo?.addEventListener('click', async () => {
      await upload(els.gallery, 'gallery');
      if (galleryGo) galleryGo.disabled = true;
    });

    /* ---------- 启动 ---------- */
    fetch('/api/me?lite=1')
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        /* 本地预览（127.0.0.1 / localhost）临时放开整页编辑：站长不想为测试注册账号。
           线上域名下仍然必须登录。 */
        const LOCAL = ['127.0.0.1', 'localhost', '::1'].includes(location.hostname);
        logged = Boolean(j?.user) || LOCAL;
        els.auth.textContent = j?.user
          ? `已登录：${j.user.name}（整页编辑可用）`
          : LOCAL
            ? '本地预览：整页编辑已临时放开（正式站需要登录）'
            : '未登录：单项补充照常可用；整页编辑需要登录。';
        els.auth.classList.toggle('is-on', logged);
      })
      .catch(() => {
        const LOCAL = ['127.0.0.1', 'localhost', '::1'].includes(location.hostname);
        logged = LOCAL;
        els.auth.textContent = LOCAL
          ? '本地预览：整页编辑已临时放开（正式站需要登录）'
          : '登录状态没读到（接口没通）—— 不影响单项补充。';
      });

    /* 索引偶尔在 dev/冷启动时第一次拿不到，重试两次再报错 */
    const loadIndex = async (): Promise<MapRow[]> => {
      let last: unknown = null;
      for (let attempt = 0; attempt < 3; attempt++) {
        try {
          const r = await fetch('/submit/maps.json', { cache: 'no-store' });
          if (!r.ok) throw new Error('HTTP ' + r.status);
          const j = await r.json();
          if (!Array.isArray(j)) throw new Error('不是数组');
          return j as MapRow[];
        } catch (e) {
          last = e;
          if (attempt < 2) await new Promise((res) => setTimeout(res, 600));
        }
      }
      throw last instanceof Error ? last : new Error('索引读取失败');
    };

    loadIndex()
      .then((rows) => {
        index = rows;
        els.mapList.textContent = '';
        for (const row of rows) {
          const o = document.createElement('option');
          o.value = String(row.slug);
          o.label = String(row.title ?? row.slug);
          els.mapList.append(o);
        }
        const want = new URLSearchParams(location.search).get('map') ?? '';
        const hit = want
          ? rows.find((x) => String(x.slug) === want || String(x.titleEn) === want)
          : undefined;
        if (hit) {
          els.map.value = String(hit.slug);
          loadCurrent(hit);
        } else if (want) {
          els.mapNote.textContent = `索引 ${rows.length} 张图；没找到「${want}」，输入名字开始。`;
        } else {
          els.mapNote.textContent = `索引 ${rows.length} 张图，输入名字开始。`;
        }
      })
      .catch((err) => {
        console.error('[submit/edit] 读取索引失败', err);
        els.mapNote.textContent = '读取地图索引失败，请刷新重试。';
      });
  </script>

