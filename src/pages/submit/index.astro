---
/**
 * 投稿表单（P2）
 *
 * 不用会 git：填完提交 → 进 D1 待审队列 → 站长在 /admin 审核 → 攒进待写回队列 → 批量写回
 * data/community/<slug>.json → Cloudflare 重建 → 内容出现在地图条目里。
 *
 * 字段定义全部来自 shared/submission-fields.mjs（与 Worker 共用一份），
 * 所以这里既不用手写控件，也不会和「什么算合法投稿」的规则漂移。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import QqGroup from '../../components/QqGroup.astro';
import { FIELD_RULES } from '../../../shared/submission-fields.mjs';

const fields = Object.entries(FIELD_RULES).map(([key, rule]: [string, any]) => ({
  key,
  kind: rule.kind as string,
  label: rule.label as string,
  hint: (rule.hint as string) ?? '',
  values: (rule.values as string[]) ?? [],
}));
---

<BaseLayout
  title="补充 / 纠错 | ZE 地图资料站"
  description="不用会 git：发现地图资料有错漏，填个表单提交即可，人工审核通过后会更新到条目里。"
>
  <div class="container submit-page">
    {/*
      页面头部（2026-10-08 重做视觉）：以前就是一张朴素的 form-card + 两段提示，
      投稿者第一眼看不出「这事要几步、值不值得做」。改成标题卡 + 步骤条，
      右边挂一张「投稿指南」的入口。
    */}
    <header class="submit-hero">
      <div class="sh-main">
        <span class="sh-badge">Community · 不需要 GitHub 账号</span>
        <h1>补充 / 纠错</h1>
        <p class="sh-sub">
          发现某张图的资料有错漏？填个表单提交就行 —— 人工审核通过后会写进条目里，并署上你的昵称。
        </p>
        <ol class="sh-steps">
          <li><b>1</b>选地图</li>
          <li><b>2</b>填内容</li>
          <li><b>3</b>提交待审</li>
          <li><b>4</b>审核上线</li>
        </ol>
      </div>
      <a class="sh-guide" href="/contribute/">
        <span class="sh-guide-t">第一次来？看投稿指南</span>
        <span class="sh-guide-d">每条路适合什么、字段怎么填、提交之后会发生什么</span>
        <span class="sh-guide-go">打开指南 ↗</span>
      </a>
    </header>

    <div class="submit-layout">
      <div class="submit-main">
        <p class="s-ctx" id="ctx">正在读取地图信息…</p>

    {/*
      没带 ?map= 直接打开本页时的选图入口。
      以前这种情况只显示「找不到地图「」，请从地图详情页重新进入」—— 对不用 GitHub 的投稿者
      来说这其实是最好走的一条路，却在第一步就撞进死胡同，而且不知道该怎么办。
    */}
    <div class="form-card s-card s-pick" id="pick" hidden>
      <h2 class="s-title">先选一张地图</h2>
      <p class="form-hint">这个表单是给<strong>某一张图</strong>补充资料的，所以得先知道是哪张图。</p>
      <ol class="s-steps">
        <li>
          打开 <a href="/maps/">地图库</a> → 点进那张图 → 右侧栏点 <b>✏️ 补充这张图的资料</b>
        </li>
        <li>或者直接在下面输名字（中文名、英文名都行）：</li>
      </ol>
      <div class="s-pick-row">
        <input id="pick-slug" placeholder="ze_ffvii_mako_reactor 或 魔晄炉" autocomplete="off" />
        <button class="btn btn-primary" type="button" id="pick-go">打开投稿表单</button>
      </div>
      <p class="form-hint" id="pick-out"></p>
    </div>

    <form class="form-card s-card s-form" id="sub-form" hidden>

      <section class="s-step">
        <h2 class="s-step-title"><span class="s-num">1</span>选地图与要补充的项目</h2>
        <div class="form-grid">
          <div class="form-row">
            <label for="f-map">地图</label>
            <input id="f-map" readonly />
          </div>
          <div class="form-row">
            <label for="f-field">要提交哪一项</label>
            <select id="f-field">
              {fields.map((f) => <option value={f.key}>{f.label}</option>)}
            </select>
            {/* 选项按钮由脚本按 select 生成（见页面底部的「字段快捷按钮」） */}
            <div class="field-chips" id="field-chips" role="group" aria-label="要提交哪一项"></div>
          </div>
        </div>
        <p class="form-hint" id="f-hint"></p>
      </section>

      <section class="s-step">
        <h2 class="s-step-title"><span class="s-num">2</span>填内容</h2>
        {
          fields.map((f) => (
            <div class="form-row s-field" data-block={f.key} hidden>
              <label for={`f-in-${f.key}`}>{f.label}</label>
              {f.kind === 'enum' ? (
                <select id={`f-in-${f.key}`} data-input={f.key}>
                  {f.values.map((v) => (
                    <option value={v}>{v}</option>
                  ))}
                </select>
              ) : f.kind === 'image' ? (
                /*
                  封面：选图后**在浏览器里**裁成 16:9、转 webp、压到 ~100 KB 再上传。
                  这样手机截图（2~5 MB）不会卡在上传上，服务端也不必做图像处理。
                  真正的权威校验（种类 / 体积 / 尺寸）在 worker/covers.ts。
                */
                <div>
                  <label class="drop-zone" for={`f-in-${f.key}`}>
                    <span class="dz-icon" aria-hidden="true">🖼️</span>
                    <span class="dz-title">点击选择图片，或把文件拖到这里</span>
                    <span class="dz-sub">横向图效果最好；会自动裁成 16:9、压成 webp</span>
                    <span class="dz-files" />
                    <input
                      id={`f-in-${f.key}`}
                      data-input={f.key}
                      type="file"
                      accept="image/png,image/jpeg,image/webp"
                      class="dz-input"
                    />
                  </label>
                  <p class="form-hint" id="cover-status">
                    还没选图。选一张横向图，会自动裁成 16:9、压成 webp 再上传，不用自己处理。
                  </p>
                  <div class="cover-pair">
                    <figure class="cover-fig" id="cover-cur-wrap" hidden>
                      <img id="cover-current" alt="当前封面" />
                      <figcaption>当前封面</figcaption>
                    </figure>
                    <figure class="cover-fig is-new" id="cover-new-wrap" hidden>
                      <img id="cover-preview" alt="新封面预览" />
                      <figcaption>上传后</figcaption>
                    </figure>
                  </div>
                </div>
              ) : f.kind === 'gallery' ? (
                /*
                  图片集：可一次选多张，每张单独一条投稿、单独写一句说明。
                  浏览器里压成最长边 1600 的 webp（**不裁剪** —— 截图该保持原样），
                  权威校验与落盘在 worker/gallery.ts。
                */
                <div>
                  <label class="drop-zone" for={`f-in-${f.key}`}>
                    <span class="dz-icon" aria-hidden="true">📷</span>
                    <span class="dz-title">点击选择图片（可多选），或拖到这里</span>
                    <span class="dz-sub">不裁剪，只压成 webp；每张上传后可以单独写一句说明</span>
                    <span class="dz-files" />
                    <input
                      id={`f-in-${f.key}`}
                      data-input={f.key}
                      type="file"
                      accept="image/png,image/jpeg,image/webp"
                      multiple
                      class="dz-input"
                    />
                  </label>
                  <p class="form-hint" id="gallery-status">
                    还没选图。可一次选多张：会自动压成 webp 再上传，每张上传后可以单独写说明。
                  </p>
                  <div id="gallery-list" class="gallery-upload-list"></div>
                </div>
              ) : f.kind === 'itemlist' ? (
                /*
                  神器 / 道具：逐行更正，不做整表替换（表格在条目正文里，
                  合并逻辑在 shared/items.mjs 的 mergeItems）。行编辑器由脚本生成，
                  名称用 datalist 联想本站现有的写法 —— 名字对不上就会被当成「新增一件」。
                */
                <div>
                  <datalist id="items-known" />
                  {/*
                    站内现有的神器表列成一排按钮：点一件就把它的名字/冷却/次数/说明带进下面的行里改。
                    以前只能靠记忆打名字（表单里做名称联想），更新过的人少、还容易打成新增。
                  */}
                  <div id="items-current" class="items-current" />
                  <div id="items-rows" class="items-rows" />
                  <button class="btn s-add-row" type="button" id="items-add">
                    ＋ 再加一件（表里没有的）
                  </button>
                </div>
              ) : f.kind === 'longtext' ? (
                /*
                  正文类字段（背景故事 / 攻略讲解 / 补充说明）：既能新写一条，
                  也能**改已经通过的那一条** —— 点右侧面板里那条的「修订这条」，
                  正文会带进这个框，上面的修订条说明「改的是谁的稿」。
                  没有这条提示的话，投稿人会以为自己的修改是新增（2026-10-10 反馈）。
                */
                <div class="revise-wrap">
                  <p class="revise-bar" id={`revise-${f.key}`} hidden />
                  <textarea id={`f-in-${f.key}`} data-input={f.key} rows="8" />
                </div>
              ) : f.kind === 'tags' ? (
                /*
                  标签：列出**全站所有标签**让他勾（默认勾上这张图现有的那些），
                  找不到再走下面的「新标签」入口。以前是自由文本框，看不到站内已有什么，
                  同一个意思会分叉；而且 tags 是整组替换，只想加一个却常把原有的全写丢。
                  词表来自 /submit/tags.json（构建期从全站数据算），所以审核通过的新标签
                  下次构建就进词表 —— 以后谁给任何图投稿都能看到。
                */
                <div class="tag-picker" id="tag-picker">
                  <input
                    id="tag-search"
                    class="tag-search"
                    type="search"
                    placeholder="搜标签（例如「神器」「恐怖」）…"
                    autocomplete="off"
                  />
                  <div class="field-chips tag-chips" id="tag-chips" />
                  <div class="tag-new-row">
                    <input
                      id="tag-new"
                      class="tag-new"
                      maxlength="24"
                      placeholder="找不到想要的？输入一个新标签"
                      autocomplete="off"
                    />
                    <button class="btn" type="button" id="tag-new-add">＋ 新建标签</button>
                  </div>
                  <p class="form-hint" id="tag-status">正在加载标签词表…</p>
                </div>
              ) : f.kind === 'urlList' ? (
                <textarea
                  id={`f-in-${f.key}`}
                  data-input={f.key}
                  rows="3"
                  placeholder="每行一个链接（https:// 开头）"
                />
              ) : (
                <input
                  id={`f-in-${f.key}`}
                  data-input={f.key}
                  type={f.kind === 'int' ? 'number' : 'text'}
                />
              )}
              {f.kind === 'itemlist' || f.kind === 'gallery' || f.kind === 'tags' ? null : f.kind ===
                'longtext' ? (
                /* 正文没有「一个现值」可显示：本站正文与已有的社区投稿都在右侧面板里 */
                <p class="form-hint s-cur">
                  这张图现有的正文与已经通过的投稿都列在右侧「这张图现在的内容」里 ——
                  想改哪一条，点那条的「修订这条」。
                </p>
              ) : (
                <p class="form-hint s-cur">
                  条目现在的值：<span class="cur-val" data-current={f.key}>—</span>
                </p>
              )}
            </div>
          ))
        }
      </section>

      <section class="s-step">
        <h2 class="s-step-title"><span class="s-num">3</span>署名与说明</h2>
        <div class="form-row">
          <label for="f-note">理由 / 来源（选填，但很有帮助）</label>
          <textarea id="f-note" rows="2" maxlength="500"
            placeholder="例如：工坊页面描述里写的是普通难度；或者给出参考链接"></textarea>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <label for="f-submitter">你的昵称（选填，会署在条目里）</label>
            <input id="f-submitter" maxlength="32" />
          </div>
          <div class="form-row">
            <label for="f-contact">联系方式（选填，便于追问）</label>
            <input id="f-contact" maxlength="80" placeholder="QQ / 邮箱" />
          </div>
        </div>
      </section>

      <div class="s-actions">
        <button class="btn btn-primary btn-lg" type="submit" id="f-submit">提交审核</button>
        <span class="s-actions-note">提交后进入人工审核队列 —— 通过才会写进条目，不通过会告诉你原因。</span>
      </div>
      <p class="form-hint">
        等得急、或者想问怎么写：<QqGroup />（群里也会贴审核进度）
      </p>
      <p class="form-error" id="f-error" hidden></p>
    </form>

    <div class="form-card s-card s-result" id="result" hidden></div>

    <div class="form-card s-card" id="status-card">
      <h2 class="s-title">查审核状态</h2>
      <p class="form-hint">提交成功后会给你一个编号，凭它就能查。</p>
      <div class="s-pick-row">
        <input id="q-id" type="number" min="1" placeholder="投稿编号，例如 12" />
        <button class="btn" type="button" id="q-go">查询</button>
      </div>
      <p class="s-status" id="q-out"></p>
    </div>
      </div>

      {/*
        右侧说明栏：这几条都是投稿者最常问的（以前散在正文提示里，读起来累）。
        内容纯静态，不参与提交逻辑。
      */}
      <aside class="submit-aside">
        {/*
          「这张图现在的内容」对照面板：投稿人的核心困难是**看不到现状**——
          要改难度、补神器、换封面，都得先知道现在写的是什么。这个卡片跟着滚动（sticky），
          表单在左边改、右边随时对照，不用来回切页面。内容由脚本按 mapInfo 填。
        */}
        <div class="s-aside-card" id="ref-card" hidden>
          <h3>这张图现在的内容</h3>
          <div id="ref-body" class="ref-body"></div>
          <a class="ref-open" id="ref-open" href="#" target="_blank" rel="noopener">
            在地图页打开对照 ↗
          </a>
        </div>
        <div class="s-aside-card">
          <h3>提交之后</h3>
          <ol class="s-timeline">
            <li>进入待审队列</li>
            <li>站长人工审核</li>
            <li>写回仓库</li>
            <li>自动重建，几分钟后上线</li>
          </ol>
        </div>
        <div class="s-aside-card">
          <h3>这些最有用</h3>
          <ul class="s-list">
            <li>难度定错了、标签不准</li>
            <li>神器表缺件、冷却写错</li>
            <li>通关流程、卡关点、常见问题</li>
            <li>真实截图（封面与图片集）</li>
          </ul>
        </div>
        <div class="s-aside-card">
          <h3>几点说明</h3>
          <ul class="s-list">
            <li>不需要 GitHub 账号</li>
            <li>署名可以留空</li>
            <li>会人工核对，不保证全采纳</li>
            <li>可以随时回来查编号</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  /* 与 Worker 共用同一份字段规则与校验 —— 前端只是「提前告诉你哪里不对」，
     真正的权威校验在服务端（worker/submissions.ts）。 */
  import { FIELD_RULES, validateValue } from '../../../shared/submission-fields.mjs';

  const slug = new URLSearchParams(location.search).get('map') ?? '';
  const ctxEl = document.getElementById('ctx') as HTMLElement;
  const form = document.getElementById('sub-form') as HTMLFormElement;
  const fieldSel = document.getElementById('f-field') as HTMLSelectElement;
  const hintEl = document.getElementById('f-hint') as HTMLElement;
  const errEl = document.getElementById('f-error') as HTMLElement;
  const resultEl = document.getElementById('result') as HTMLElement;
  const submitBtn = document.getElementById('f-submit') as HTMLButtonElement;

  let mapInfo: Record<string, unknown> | null = null;
  let allMaps: Array<Record<string, unknown>> = [];

  /*
   * 没带 ?map= 时的选图入口。
   * 以前这种情况只丢下一句「请从地图详情页重新进入」就结束了 —— 对不用 GitHub 的投稿者
   * 来说这恰恰是最好走的一条路，却在第一步撞进死胡同，还不知道该去哪儿。
   */
  const pickEl = document.getElementById('pick') as HTMLElement;
  const pickInput = document.getElementById('pick-slug') as HTMLInputElement;
  const pickOut = document.getElementById('pick-out') as HTMLElement;

  function openPicker(why: string) {
    ctxEl.textContent = why;
    pickEl.hidden = false;
    pickInput.focus();
  }

  /** 中文名 / 英文名 / 内部名都能对上；先精确匹配再退化到包含匹配 */
  function goPick() {
    const q = pickInput.value.trim().toLowerCase();
    if (!q) {
      pickOut.textContent = '先输个名字，中文名或英文名都可以。';
      return;
    }
    const low = (v: unknown) => String(v ?? '').toLowerCase();
    const hit =
      allMaps.find((m) => low(m.slug) === q) ??
      allMaps.find((m) => low(m.titleEn) === q) ??
      allMaps.find((m) => low(m.title) === q) ??
      allMaps.find((m) => low(m.titleEn).includes(q)) ??
      allMaps.find((m) => low(m.title).includes(q));
    if (!hit) {
      pickOut.textContent = `没找到「${pickInput.value.trim()}」。可以去地图库搜一下，或者换成英文名试试。`;
      return;
    }
    location.href = '/submit/?map=' + encodeURIComponent(String(hit.slug));
  }

  document.getElementById('pick-go')?.addEventListener('click', goPick);
  pickInput?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') {
      e.preventDefault();
      goPick();
    }
  });
  /* 标签选择器的输入框/按钮（函数声明会提升，这里调用没问题） */
  wireTagPicker();

  const rules = FIELD_RULES as Record<string, { kind: string; hint?: string }>;

  function formatValue(v: unknown): string {
    if (v === undefined || v === null || v === '') return '（空）';
    if (Array.isArray(v)) return v.length ? v.join('、') : '（空）';
    return String(v);
  }

  /* ===== 神器 / 道具行编辑器 =====
     一行 = 一件道具。**动作不让投稿人选**：名字对得上本站已有的表就是「更正」，
     对不上就是「新增」，勾了「本图没有这件」就是「删除」（只加标注，不删行）。
     理由：2026-09-28 的反馈——面对「更正 / 新增」下拉框，投稿人不知道该选哪个。 */
  type ItemRow = { n?: string; c?: string; u?: string; k?: string; l?: string; i?: string };

  /** 本站这张图现在的表（手写正文 + 服务器配置 + 已通过的社区更正，构建期合成） */
  function currentItemRows(): ItemRow[] {
    const list = mapInfo?.items;
    return Array.isArray(list) ? (list as ItemRow[]) : [];
  }

  const keyOf = (name: unknown) => String(name ?? '').replace(/\u3000/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();

  /** 名字在本站表里对得上的那一行（对上就是「更正」，对不上就是「新增」） */
  function knownItemRow(name: string): ItemRow | null {
    const key = keyOf(name);
    if (!key) return null;
    return currentItemRows().find((r) => keyOf(r.n) === key) ?? null;
  }

  /** 一行现在的样子（给投稿人看：表里写的是什么） */
  function describeItemRow(row: ItemRow): string {
    const label = row.l ? `${row.l} / ${row.n}` : String(row.n ?? '');
    const nums = [row.c, row.u].filter((v) => v && v !== '—' && v !== '不限');
    return nums.length ? `${label}（${nums.join(' / ')}）` : label;
  }

  function addItemRow(preset?: ItemRow): void {
    const rowsEl = document.getElementById('items-rows');
    if (!rowsEl) return;

    const known = currentItemRows();
    const wrap = document.createElement('div');
    wrap.className = 'item-row';

    const line1 = document.createElement('div');
    line1.className = 'ir-grid';

    const name = document.createElement('input');
    name.dataset.k = 'name';
    name.setAttribute('list', 'items-known');
    name.placeholder = known.length ? `道具名（如 ${known[0].n}）` : '道具名';
    name.autocomplete = 'off';
    if (preset?.n) name.value = String(preset.n);

    const cd = document.createElement('input');
    cd.dataset.k = 'cd';
    cd.type = 'number';
    cd.min = '0';
    cd.max = '3600';
    cd.step = '0.5';
    cd.placeholder = '冷却秒';
    /* 表里存的是「60 秒」/「—」这种展示值：能取出数字就预填，取不出就留空（留空 = 这一项不动） */
    if (preset?.c) {
      const m = /(\d+(?:\.\d+)?)/.exec(String(preset.c));
      if (m) cd.value = m[1];
    }

    const uses = document.createElement('input');
    uses.dataset.k = 'uses';
    uses.type = 'number';
    uses.min = '0';
    uses.max = '99';
    uses.placeholder = '次数';
    if (preset?.u && /^\d+$/.test(String(preset.u).trim())) uses.value = String(preset.u).trim();

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'btn';
    del.textContent = '✕';
    del.title = '删掉这一行';
    del.addEventListener('click', () => wrap.remove());

    line1.append(name, cd, uses, del);

    const line2 = document.createElement('div');
    line2.className = 'ir-meta';

    const note = document.createElement('input');
    note.dataset.k = 'note';
    note.placeholder = '备注（选填）：我们服和原表的差别，如「只在第四关出现」';
    note.className = 'ir-note';

    /* 神器表「说明」列的一句话介绍 —— 这件神器是干嘛的（长文走「攻略 / 神器讲解」字段） */
    const intro = document.createElement('input');
    intro.dataset.k = 'intro';
    intro.maxLength = 200;
    intro.placeholder = '说明（选填）：这件神器是干嘛的，一句话';
    intro.className = 'ir-intro';
    if (preset?.i) intro.value = String(preset.i);

    const missingWrap = document.createElement('label');
    missingWrap.className = 'ir-missing';
    const missing = document.createElement('input');
    missing.type = 'checkbox';
    missing.dataset.k = 'missing';
    missingWrap.append(missing, document.createTextNode('本图没有这件'));

    line2.append(note, intro, missingWrap);

    const status = document.createElement('p');
    status.className = 'form-hint ir-status';
    status.dataset.k = 'status';

    const refresh = () => {
      const hit = knownItemRow(name.value);
      if (missing.checked) {
        status.textContent = hit
          ? `提交后会把「${describeItemRow(hit)}」标成『本图没有这件』（原来的行保留，只加标注）`
          : '表里没有这个名字，勾了也不会生效 —— 先填一个表里已有的名字';
        return;
      }
      if (hit) {
        status.textContent = `表里已有：${describeItemRow(hit)}${hit.i ? ` · 说明：${hit.i}` : ''} → 你填的冷却 / 次数 / 说明会改成新的，原值留在备注里`;
      } else if (name.value.trim()) {
        status.textContent = '表里没有这件 → 会作为新增（社区补充）加进表里';
      } else {
        status.textContent = currentItemRows().length
          ? '名字从下面的联想里选，或者照条目页的写法填'
          : '本站这张图还没有表 —— 你填的就成了它的第一张神器表';
      }
    };

    name.addEventListener('input', refresh);
    missing.addEventListener('change', refresh);

    wrap.append(line1, line2, status);
    rowsEl.append(wrap);
    refresh();
  }

  /** 读回编辑器里的行；整行全空的行直接丢掉（加了行又不用是常态） */
  function collectItems(): Array<Record<string, unknown>> {
    const out: Array<Record<string, unknown>> = [];
    for (const wrap of document.querySelectorAll<HTMLElement>('#items-rows .item-row')) {
      const val = (k: string) =>
        wrap.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)?.value.trim() ?? '';
      const box = wrap.querySelector<HTMLInputElement>('[data-k="missing"]');
      const name = val('name');
      const cdRaw = val('cd');
      const usesRaw = val('uses');
      const note = val('note');
      const intro = val('intro');
      if (!name && !cdRaw && !usesRaw && !note && !intro) continue;
      /* 动作由名字决定（见 updateStatus）：勾了「本图没有」→ remove，表里有 → update，否则 add */
      const action = box?.checked ? 'remove' : knownItemRow(name) ? 'update' : 'add';
      out.push({ action, name, cd: cdRaw, uses: usesRaw, note, intro });
    }
    return out;
  }

  function prefillItems(): void {
    const rowsEl = document.getElementById('items-rows');
    const curEl = document.getElementById('items-current');
    const known = document.getElementById('items-known');
    const rows = currentItemRows();

    if (rowsEl) rowsEl.textContent = '';
    if (known) {
      known.textContent = '';
      for (const r of rows) {
        const opt = document.createElement('option');
        opt.value = String(r.n ?? '');
        opt.label = r.l
          ? String(r.l)
          : [r.c, r.u].filter((v) => v && v !== '—').join(' / ');
        known.append(opt);
      }
    }
    if (curEl) {
      curEl.textContent = '';
      if (!rows.length) {
        const p = document.createElement('p');
        p.className = 'form-hint';
        p.textContent = '本站还没有这张图的神器表 —— 你填的会成为第一张。';
        curEl.append(p);
      } else {
        const p = document.createElement('p');
        p.className = 'form-hint';
        p.textContent = `本站这张图现在的表（${rows.length} 件，点一件就能改它的冷却 / 次数 / 说明）：`;
        const box = document.createElement('div');
        box.className = 'field-chips items-current-chips';
        for (const r of rows) {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = String(r.n ?? '');
          b.title = `${describeItemRow(r)}${r.i ? ` · 说明：${r.i}` : ''} —— 点一下带进下面的表单`;
          b.addEventListener('click', () => addItemRow(r));
          box.append(b);
        }
        curEl.append(p, box);
      }
    }
    addItemRow();
  }

  function showField(key: string) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-block]')) {
      el.hidden = el.dataset.block !== key;
    }
    hintEl.textContent = rules[key]?.hint ?? '';
  }

  /* ===== 修订一条已通过的社区投稿 =====
     以前正文只能**追加**：发现自己写错了，只能在下面再补一段，条目页就出现两条
     几乎一样的段落，越改越乱（2026-10-10 的反馈）。
     现在点右侧面板里那条的「修订这条」→ 正文带进左侧表单 → 提交时带上 reviseOf（那条的 id）。
     审核通过后是**替换**它的正文，署名仍是原作者，条目页另标「谁在什么时候修订的」。 */
  type ReviseTarget = { field: string; id: string; by: string; text: string };
  let reviseTarget: ReviseTarget | null = null;

  /** 正文类字段的中文名（story → 背景故事）；从字段表取，不另写一份 */
  const fieldLabel = (key: string) => rules[key]?.label ?? '社区补充';

  function renderReviseBar(): void {
    for (const key of Object.keys(rules)) {
      const bar = document.getElementById(`revise-${key}`);
      if (!bar) continue;
      const on = reviseTarget?.field === key;
      bar.hidden = !on;
      bar.textContent = '';
      if (!on || !reviseTarget) continue;
      const who = reviseTarget.by || '匿名';
      const b = document.createElement('b');
      b.textContent = `正在修订 ${who} 的投稿`;
      bar.append(
        b,
        document.createTextNode(
          `（编号 ${reviseTarget.id}）：提交后是替换这一条，不是新增；署名仍是 ${who}，条目页会标注由你修订。`
        )
      );
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.textContent = '取消修订';
      cancel.addEventListener('click', () => cancelRevise());
      bar.append(cancel);
    }
    /* 面板里高亮正在改的那一条 —— 滚回去还能对上号 */
    for (const el of document.querySelectorAll<HTMLElement>('.ref-note')) {
      el.classList.toggle('is-target', Boolean(reviseTarget) && el.dataset.noteId === reviseTarget?.id);
    }
  }

  function startRevise(t: ReviseTarget): void {
    /* 字段名不对（老数据 field 为 null）时落到「补充说明 / 纠错」—— 与条目页的分块规则一致 */
    const field = Object.prototype.hasOwnProperty.call(rules, t.field) ? t.field : 'body';
    reviseTarget = { ...t, field };
    fieldSel.value = field;
    showField(field);
    prefill(field);
    const input = document.querySelector<HTMLTextAreaElement>(`[data-input="${field}"]`);
    if (input) {
      input.value = t.text;
      input.focus();
    }
    renderReviseBar();
    errEl.hidden = true;
  }

  function cancelRevise(): void {
    if (!reviseTarget) return;
    reviseTarget = null;
    renderReviseBar();
    /* 清空正文框：取消修订后回到「新写一条」，别把别人的稿子留在框里当自己的投出去 */
    prefill(fieldSel.value);
  }

  /* ===== 「这张图现在的内容」对照面板（右侧 sticky） =====
     只读摘要：基本信息 + 神器表 + 攻略视频 + 资料来源 + 图片集张数。
     数据来自 /submit/maps.json（构建期把服务器配置、手写正文、已通过的社区更正合成好的那份），
     所以它跟条目页上看到的是一致的，不会出现「表单说 A、页面说 B」。 */
  function renderRefPanel(): void {
    const card = document.getElementById('ref-card');
    const body = document.getElementById('ref-body');
    const open = document.getElementById('ref-open') as HTMLAnchorElement | null;
    if (!card || !body) return;
    if (!mapInfo) {
      card.hidden = true;
      return;
    }
    card.hidden = false;
    if (open) open.href = `/maps/${mapInfo.slug}/`;
    body.textContent = '';

    /*
     * 一小段正文（本站整理的 / 社区投稿的）。
     * 正文可以到四千字，全摊开会把面板撑成一面墙 —— 给个能滚的小窗，
     * 投稿人要的是「现在写的是什么」，扫一眼就够。
     */
    const refText = (label: string, text: string) => {
      const wrap = document.createElement('div');
      const cap = document.createElement('p');
      cap.className = 'ref-note-meta';
      cap.textContent = label;
      const box = document.createElement('div');
      box.className = 'ref-text';
      box.textContent = text;
      wrap.append(cap, box);
      return wrap;
    };

    /*
     * 一条已通过的社区投稿：投的是哪个字段 + 谁写的 + 什么时候 + 正文 + 「修订这条」。
     * 修订按钮把这条的正文带进左侧表单（见 startRevise）—— 这是「能改」的入口，
     * 光把正文列出来还是只能追加。
     */
    const refNote = (n: Record<string, unknown>) => {
      const wrap = document.createElement('div');
      wrap.className = 'ref-note';
      const id = String(n.id ?? '');
      wrap.dataset.noteId = id;
      const who = String(n.by ?? '') || '匿名';
      const when = String(n.at ?? '').slice(0, 10);
      const field = String(n.field ?? '');
      const meta = document.createElement('p');
      meta.className = 'ref-note-meta';
      meta.textContent =
        `${fieldLabel(field)} · ${who}${when ? ` · ${when}` : ''}` +
        (n.revisedBy ? ` · ${String(n.revisedBy)} 修订过` : '');
      const box = document.createElement('div');
      box.className = 'ref-text';
      box.textContent = String(n.text ?? '');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ref-revise';
      btn.textContent = '修订这条';
      btn.title = `把这条正文带进左侧表单改（署名仍是 ${who}）`;
      btn.addEventListener('click', () =>
        startRevise({ field, id, by: who, text: String(n.text ?? '') })
      );
      wrap.append(meta, box, btn);
      return wrap;
    };

    const row = (label: string, value: unknown) => {
      const text = Array.isArray(value) ? value.join('、') : String(value ?? '');
      /* 空值不显示；「0」也当没有（关卡数 0 是「没填」，摆出来只是噪音）。
         「未知难度」要留着 —— 那正是一条「这里还缺资料」的提示。 */
      if (!text || text === '—' || text === 'undefined' || text === '0') return;
      const p = document.createElement('p');
      p.className = 'ref-row';
      const b = document.createElement('b');
      b.textContent = label;
      p.append(b, document.createTextNode(text));
      body.append(p);
    };
    row('难度', mapInfo.difficulty);
    if (Array.isArray(mapInfo.tags) && mapInfo.tags.length) row('标签', mapInfo.tags);
    row('作者', mapInfo.author);
    row('版本', mapInfo.version);
    row('人数', mapInfo.players);
    row('时长', mapInfo.duration);
    row('关卡', mapInfo.stages);
    if (typeof mapInfo.galleryCount === 'number') row('图片集', `${mapInfo.galleryCount} 张`);

    const info = mapInfo as Record<string, unknown>;

    /*
     * 本站正文：story = 人工整理稿里的「背景故事」整节（目前是魔晄炉 / 米纳斯 / 黑珍珠号那三张），
     * summary = 条目的简介段落（107 张有）。
     * 以前面板里完全没有正文 —— 投「背景故事」的人看不到已经写了什么，只能盲着追加一条。
     */
    const siteStory = typeof info.story === 'string' ? info.story : '';
    const siteSummary = typeof info.summary === 'string' ? info.summary : '';
    if (siteStory || siteSummary) {
      const h = document.createElement('p');
      h.className = 'ref-h';
      h.textContent = '本站正文';
      body.append(h);
      if (siteStory) body.append(refText('背景故事（本站整理）', siteStory));
      if (siteSummary) body.append(refText('简介（本站整理）', siteSummary));
    }

    /*
     * 已通过的社区投稿：列出来 + 每条一个「修订这条」。
     * 这是 2026-10-10 的反馈重点：以前只能新增，写错了改不了，页面上会出现两条几乎一样的段落。
     */
    const notes = (Array.isArray(info.notes) ? info.notes : []) as Array<Record<string, unknown>>;
    const nh = document.createElement('p');
    nh.className = 'ref-h';
    nh.textContent = notes.length ? `已通过的社区投稿（${notes.length} 条，可修订）` : '已通过的社区投稿';
    body.append(nh);
    if (!notes.length) {
      const p = document.createElement('p');
      p.className = 'form-hint';
      p.textContent =
        '还没有人投过正文 —— 你写的会成为第一条（通过后在条目页单独成块显示，署你的昵称，不会覆盖本站正文）。';
      body.append(p);
    } else {
      for (const n of notes) {
        body.append(refNote(n));
      }
    }
    const items = currentItemRows();
    const head = document.createElement('p');
    head.className = 'ref-h';
    head.textContent = items.length ? `神器 / 道具（${items.length} 件）` : '神器 / 道具（本站还没有这张图的表）';
    body.append(head);
    if (items.length) {
      const ul = document.createElement('ul');
      ul.className = 'ref-items';
      for (const r of items) {
        const li = document.createElement('li');
        li.textContent = `${r.n ?? ''}${r.c ? ` · ${r.c}` : ''}${r.u ? ` · ${r.u}` : ''}${r.i ? ` —— ${r.i}` : ''}`;
        ul.append(li);
      }
      body.append(ul);
    }
    for (const [label, key] of [
      ['攻略视频', 'videoUrls'],
      ['资料来源', 'sources'],
    ] as const) {
      const list = info[key];
      if (!Array.isArray(list) || !list.length) continue;
      const h = document.createElement('p');
      h.className = 'ref-h';
      h.textContent = `${label}（${list.length}）`;
      const ul = document.createElement('ul');
      ul.className = 'ref-list';
      for (const url of list) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = String(url);
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = String(url).replace(/^https?:\/\/(www\.)?/, '');
        li.append(a);
        ul.append(li);
      }
      body.append(h, ul);
    }
  }

  /* ===== 标签选择器 =====
     词表来自 /submit/tags.json（构建期从全站数据算出来的：每个标签挂多少张图）。
     默认勾上「这张图现在有的标签」—— 这样投稿人想加一个标签时，不会把原有的整组写丢
     （tags 是整组替换，这是以前最容易踩的坑）。 */
  type TagRow = { n: string; c: number };
  let tagVocab: TagRow[] | null = null;
  let tagSelected: string[] = [];
  let tagKeyword = '';

  const tagChipsEl = () => document.getElementById('tag-chips');
  const tagStatusEl = () => document.getElementById('tag-status');
  const tagLimit = () => rules.tags?.max ?? 12;

  function tagStateText(): string {
    const inVocab = new Set((tagVocab ?? []).map((t) => t.n));
    const fresh = tagSelected.filter((t) => !inVocab.has(t));
    const parts = [`已选 ${tagSelected.length} / ${tagLimit()}`];
    if (fresh.length) parts.push(`新标签 ${fresh.length} 个（${fresh.join('、')}）需审核确认`);
    return parts.join(' · ');
  }

  function renderTagChips(): void {
    const box = tagChipsEl();
    if (!box) return;
    box.textContent = '';
    const kw = tagKeyword.trim().toLowerCase();
    const selected = new Set(tagSelected);
    const vocab = tagVocab ?? [];
    /* 新标签（不在词表里的已选项）永远排在最前，免得搜索时看不到、以为没选上 */
    const fresh = tagSelected.filter((t) => !vocab.some((v) => v.n === t));
    for (const name of fresh) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'on is-new';
      b.textContent = `${name} · 新`;
      b.title = '新标签：审核通过后会进全站标签，之后任何人投稿都能选到';
      b.addEventListener('click', () => toggleTag(name));
      box.append(b);
    }
    const list = vocab.filter((t) => !kw || t.n.toLowerCase().includes(kw));
    for (const t of list) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = t.c >= 5 ? `${t.n} (${t.c})` : t.n;
      b.title = `全站 ${t.c} 张图用过这个标签`;
      if (selected.has(t.n)) b.className = 'on';
      b.addEventListener('click', () => toggleTag(t.n));
      box.append(b);
    }
    if (!list.length && !fresh.length) {
      const p = document.createElement('p');
      p.className = 'form-hint';
      p.textContent = tagVocab
        ? kw
          ? `词表里没有「${tagKeyword}」—— 用下面的「新建标签」加一个。`
          : '词表是空的。'
        : '标签词表加载中…';
      box.append(p);
    }
    const st = tagStatusEl();
    if (st) {
      st.textContent = tagVocab ? tagStateText() : '标签词表没加载出来 —— 仍可用下面的「新建标签」手动加。';
    }
  }

  function toggleTag(name: string): void {
    const i = tagSelected.indexOf(name);
    if (i >= 0) {
      tagSelected.splice(i, 1);
    } else {
      if (tagSelected.length >= tagLimit()) {
        const st = tagStatusEl();
        if (st) st.textContent = `最多 ${tagLimit()} 个标签 —— 先取消一个再选。`;
        return;
      }
      tagSelected.push(name);
    }
    renderTagChips();
  }

  function addNewTag(): void {
    const input = document.getElementById('tag-new') as HTMLInputElement | null;
    const raw = (input?.value ?? '').trim();
    if (!raw) return;
    /* 先用共用校验器过一遍（长度 / 字符 / 重复与服务端同一条规则），免得提交了才被拒 */
    const checked = validateValue('tags', [...tagSelected, raw]);
    if (!checked.ok) {
      const st = tagStatusEl();
      if (st) st.textContent = String((checked as { error?: string }).error ?? '这个标签不可用');
      return;
    }
    /* 词表里已有同名（忽略大小写）就选它，别再建一个只差大小写的标签 */
    const hit = (tagVocab ?? []).find((t) => t.n.toLowerCase() === raw.toLowerCase());
    if (input) input.value = '';
    if (hit) {
      if (!tagSelected.includes(hit.n)) toggleTag(hit.n);
      else renderTagChips();
      return;
    }
    tagSelected.push(raw);
    renderTagChips();
  }

  async function loadTagVocab(): Promise<void> {
    if (tagVocab) return;
    try {
      const r = await fetch('/submit/tags.json');
      const j = (await r.json()) as { tags?: TagRow[] };
      tagVocab = Array.isArray(j.tags) ? j.tags : [];
    } catch {
      tagVocab = [];
    }
    renderTagChips();
  }

  /** 切到「标签」字段或选中地图时调用：勾上这张图现有的标签，并确保词表已加载 */
  function prefillTags(): void {
    tagSelected = [...(mapInfo?.tags ?? [])];
    renderTagChips();
    void loadTagVocab();
  }

  function wireTagPicker(): void {
    const search = document.getElementById('tag-search') as HTMLInputElement | null;
    search?.addEventListener('input', () => {
      tagKeyword = search.value;
      renderTagChips();
    });
    const add = document.getElementById('tag-new-add');
    add?.addEventListener('click', addNewTag);
    const input = document.getElementById('tag-new') as HTMLInputElement | null;
    input?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        addNewTag();
      }
    });
  }

  function prefill(key: string) {
    const input = document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      `[data-input="${key}"]`
    );
    const curEl = document.querySelector<HTMLElement>(`[data-current="${key}"]`);
    const cur = mapInfo?.[key];
    /* 列表类字段（标签 / 视频 / 来源）以前挤成一行「a、b、c」，改的时候根本对不上号；
       现在逐条列出来，投稿人能看到「已经有哪几条」，再决定追加还是替换。 */
    if (curEl) {
      if (Array.isArray(cur) && cur.length) {
        curEl.textContent = '';
        const ul = document.createElement('ul');
        ul.className = 'cur-list';
        for (const item of cur) {
          const li = document.createElement('li');
          li.textContent = String(item);
          ul.append(li);
        }
        curEl.append(ul);
      } else {
        curEl.textContent = formatValue(cur);
      }
    }

    /* 神器 / 道具：没有「一个值」可以预填，改成列出现有的表 + 一行空行等投稿人填 */
    if (rules[key]?.kind === 'itemlist') {
      prefillItems();
      return;
    }

    /* 标签：勾选器，默认勾上这张图现有的标签（避免整组替换把原有的写丢） */
    if (rules[key]?.kind === 'tags') {
      prefillTags();
      return;
    }

    /* 图片集：也不能预填（多张图 + 说明），但告诉投稿人这张图现在有几张，
       免得把已有的图又投一遍 */
    if (rules[key]?.kind === 'gallery') {
      updateGalleryStatus();
      return;
    }

    /* 封面：把当前那张显示成缩略图，换的时候好对比 */
    if (key === 'cover') {
      const wrap = document.getElementById('cover-cur-wrap');
      const img = document.getElementById('cover-current') as HTMLImageElement | null;
      if (wrap && img && typeof cur === 'string' && cur) {
        img.src = cur;
        wrap.hidden = false;
      } else if (wrap) {
        wrap.hidden = true;
      }
    }

    /* 文件控件不能赋值（会抛异常），而且封面本来就不预填 */
    if (!input || (input as HTMLInputElement).type === 'file') return;
    if (cur === undefined || cur === null) input.value = '';
    else if (Array.isArray(cur)) input.value = cur.join('\n');
    else input.value = String(cur);
  }

  function collect(key: string): unknown {
    if (rules[key]?.kind === 'itemlist') return collectItems();
    /* 标签来自选择器（勾选 + 新建），不是文本框 */
    if (rules[key]?.kind === 'tags') return [...tagSelected];
    const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
      `[data-input="${key}"]`
    );
    if (!el) return undefined;
    const kind = rules[key]?.kind;
    if (kind === 'int') return el.value === '' ? '' : Number(el.value);
    if (kind === 'tags' || kind === 'urlList') {
      return el.value
        .split('\n')
        .map((s) => s.trim())
        .filter(Boolean);
    }
    return el.value;
  }

  function showError(msg: string) {
    errEl.textContent = msg;
    errEl.hidden = false;
  }

  fieldSel.addEventListener('change', () => {
    showField(fieldSel.value);
    prefill(fieldSel.value);
    errEl.hidden = true;
  });

  document.getElementById('items-add')?.addEventListener('click', () => addItemRow());

  /* 载入地图索引（构建期生成的 /submit/maps.json） */
  fetch('/submit/maps.json')
    .then((r) => r.json())
    .then((list: Array<Record<string, unknown>>) => {
      allMaps = list;
      if (!slug) {
        openPicker('还没选中地图 —— 先选一张，再填要补的资料。');
        return;
      }
      mapInfo = list.find((m) => m.slug === slug) ?? null;
      if (!mapInfo) {
        openPicker(`找不到地图「${slug}」—— 换个名字再试，或者从地图库点进来。`);
        return;
      }
      ctxEl.innerHTML = `正在为 <strong>《${mapInfo.title}》</strong>（${mapInfo.titleEn}）补充资料。`;
      (document.getElementById('f-map') as HTMLInputElement).value =
        `${mapInfo.title}（${mapInfo.titleEn}）`;

      /* ?field=items 可以直接落到某一项（投稿指南、地图页的入口都靠它少点两下） */
      const want = new URLSearchParams(location.search).get('field') ?? '';
      if (want && Object.prototype.hasOwnProperty.call(FIELD_RULES, want)) fieldSel.value = want;

      form.hidden = false;
      showField(fieldSel.value);
      renderRefPanel();
      prefill(fieldSel.value);
    })
    .catch(() => {
      ctxEl.textContent = '读取地图索引失败，请刷新重试。';
    });

  /* ===== 封面：在浏览器里裁成 16:9、压成 webp =====
     为什么不直接传原图：手机截图动辄 2~5 MB，而封面在页面里最大只用 1280px 宽。
     本地先处理掉，上传快、仓库小，服务端也不必引图像库（Worker 里那点运行时做不了这个）。
     这里压得再狠也不算数 —— 权威校验在 worker/covers.ts，它只看字节。 */
  const COVER_MAX_BYTES = 700 * 1024; // 与 worker/covers.ts 保持一致
  const COVER_TARGET_W = 1280;

  let coverBlob: Blob | null = null;
  let coverExt = 'webp';

  const coverInput = document.getElementById('f-in-cover') as HTMLInputElement | null;
  const coverStatus = document.getElementById('cover-status') as HTMLElement | null;
  const coverPreview = document.getElementById('cover-preview') as HTMLImageElement | null;
  const coverNewWrap = document.getElementById('cover-new-wrap') as HTMLElement | null;

  /** 解码：优先 createImageBitmap，失败退 <img>（HEIC 这类浏览器解不开的要给人话术） */
  async function loadBitmap(file: File): Promise<ImageBitmap | HTMLImageElement> {
    if (typeof createImageBitmap === 'function') {
      try {
        return await createImageBitmap(file);
      } catch {
        /* 交给下面的 <img> 再试一次 */
      }
    }
    return await new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        resolve(img);
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('浏览器解不开这个图片格式（比如手机直出的 HEIC），先另存为 JPG 再传'));
      };
      img.src = url;
    });
  }

  const encodeCanvas = (canvas: HTMLCanvasElement, type: string, quality: number) =>
    new Promise<Blob | null>((resolve) => canvas.toBlob((b) => resolve(b), type, quality));

  async function buildCover(file: File): Promise<{ blob: Blob; ext: string; w: number; h: number }> {
    const src = await loadBitmap(file);
    const sw = src.width;
    const sh = src.height;
    if (!sw || !sh) throw new Error('读不出这张图的尺寸');

    /* 居中裁成 16:9（和 npm run cover:set 的默认行为一致） */
    const ratio = 16 / 9;
    let cw = sw;
    let ch = sh;
    if (sw / sh > ratio) cw = Math.round(sh * ratio);
    else ch = Math.round(sw / ratio);
    const cx = Math.round((sw - cw) / 2);
    const cy = Math.round((sh - ch) / 2);

    const outW = Math.min(COVER_TARGET_W, cw);
    const outH = Math.max(1, Math.round(outW / ratio));
    const canvas = document.createElement('canvas');
    canvas.width = outW;
    canvas.height = outH;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('这个浏览器不支持 canvas，换一个浏览器试试');
    ctx.drawImage(src as CanvasImageSource, cx, cy, cw, ch, 0, 0, outW, outH);
    if ('close' in src && typeof (src as ImageBitmap).close === 'function') (src as ImageBitmap).close();

    /* 优先 webp（体积最小）；浏览器不支持编码 webp 时退 jpg */
    let blob = await encodeCanvas(canvas, 'image/webp', 0.82);
    let ext = 'webp';
    if (!blob || blob.type !== 'image/webp') {
      blob = await encodeCanvas(canvas, 'image/jpeg', 0.85);
      ext = 'jpg';
    }
    if (!blob) throw new Error('压缩失败，换一张图试试');

    /* 还偏大就降质量重压（1280×720 正常只有几十 KB，很少走到这里） */
    for (const q of [0.7, 0.6, 0.5]) {
      if (blob.size <= COVER_MAX_BYTES) break;
      const again = await encodeCanvas(canvas, blob.type || 'image/jpeg', q);
      if (again) blob = again;
    }
    return { blob, ext, w: outW, h: outH };
  }

  coverInput?.addEventListener('change', async () => {
    const file = coverInput.files?.[0];
    coverBlob = null;
    if (coverNewWrap) coverNewWrap.hidden = true;
    if (!file) {
      if (coverStatus) coverStatus.textContent = '还没选图。';
      return;
    }
    if (coverStatus) coverStatus.textContent = '正在裁剪压缩…';
    errEl.hidden = true;
    try {
      const r = await buildCover(file);
      coverBlob = r.blob;
      coverExt = r.ext;
      if (coverPreview) {
        coverPreview.src = URL.createObjectURL(r.blob);
        if (coverNewWrap) coverNewWrap.hidden = false;
      }
      if (coverStatus) {
        coverStatus.textContent =
          `已压好：${r.w}×${r.h} · ${Math.round(r.blob.size / 1024)} KB` +
          `（原图 ${Math.round(file.size / 1024)} KB → ${r.ext}）`;
      }
    } catch (err) {
      if (coverStatus) coverStatus.textContent = '这张图用不了。';
      showError(err instanceof Error && err.message ? err.message : '图片处理失败');
    }
  });

  /* ===== 图片集：可多选，逐张压、逐张说明 =====
     和封面共用 loadBitmap / encodeCanvas，差别是**不裁剪**（截图本来就该保持原样）、
     最长边压到 1600、上限放宽到 1.5 MB（图片进 R2，不进 git —— 见 worker/gallery.ts）。 */
  const GALLERY_MAX_BYTES = 1500 * 1024; // 与 worker/gallery.ts 保持一致
  const GALLERY_MAX_EDGE = 1600;
  const GALLERY_CAPTION_MAX = 60;

  type GalleryItem = {
    blob: Blob;
    ext: string;
    w: number;
    h: number;
    caption: string;
    /** 预览用的 objectURL —— 移除或提交成功时要 revoke，否则整页生命周期里一直占内存 */
    url: string;
  };
  const galleryItems: GalleryItem[] = [];

  const galleryInput = document.getElementById('f-in-gallery') as HTMLInputElement | null;
  const galleryStatus = document.getElementById('gallery-status') as HTMLElement | null;
  const galleryList = document.getElementById('gallery-list') as HTMLElement | null;

  async function buildGalleryImage(
    file: File
  ): Promise<{ blob: Blob; ext: string; w: number; h: number }> {
    const src = await loadBitmap(file);
    const sw = src.width;
    const sh = src.height;
    if (!sw || !sh) throw new Error('读不出这张图的尺寸');

    /* 只缩不放：小图保持原样，大图等比缩到最长边 1600 */
    const scale = Math.min(1, GALLERY_MAX_EDGE / Math.max(sw, sh));
    const outW = Math.max(1, Math.round(sw * scale));
    const outH = Math.max(1, Math.round(sh * scale));
    const canvas = document.createElement('canvas');
    canvas.width = outW;
    canvas.height = outH;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('这个浏览器不支持 canvas，换一个浏览器试试');
    ctx.drawImage(src as CanvasImageSource, 0, 0, outW, outH);
    if ('close' in src && typeof (src as ImageBitmap).close === 'function') (src as ImageBitmap).close();

    let blob = await encodeCanvas(canvas, 'image/webp', 0.82);
    let ext = 'webp';
    if (!blob || blob.type !== 'image/webp') {
      blob = await encodeCanvas(canvas, 'image/jpeg', 0.85);
      ext = 'jpg';
    }
    if (!blob) throw new Error('压缩失败，换一张图试试');

    for (const q of [0.7, 0.6, 0.5, 0.4]) {
      if (blob.size <= GALLERY_MAX_BYTES) break;
      const again = await encodeCanvas(canvas, blob.type || 'image/jpeg', q);
      if (again) blob = again;
    }
    return { blob, ext, w: outW, h: outH };
  }

  function updateGalleryStatus(): void {
    if (!galleryStatus) return;
    const has = Number(mapInfo?.galleryCount ?? 0);
    const base = has ? `《${mapInfo?.title}》现在的图片集有 ${has} 张。` : '';
    if (!galleryItems.length) {
      galleryStatus.textContent =
        base + '还没选图。可一次选多张：会自动压成 webp 再上传，每张上传后可以单独写说明。';
      return;
    }
    const total = galleryItems.reduce((n, i) => n + i.blob.size, 0);
    galleryStatus.textContent =
      base +
      `已压好 ${galleryItems.length} 张，共 ${Math.round(total / 1024)} KB` +
      ` —— 提交后一张一条投稿，都要过审。`;
  }

  /** 把选中的图标出来：缩略图 + 说明输入框 + 移除按钮 */
  function renderGalleryList(): void {
    if (!galleryList) return;
    galleryList.textContent = '';
    galleryItems.forEach((item, idx) => {
      const card = document.createElement('figure');
      card.className = 'gal-card';

      const img = document.createElement('img');
      img.src = item.url;
      img.alt = `第 ${idx + 1} 张`;
      img.className = 'gal-thumb';

      const cap = document.createElement('input');
      cap.value = item.caption;
      cap.maxLength = GALLERY_CAPTION_MAX;
      cap.placeholder = '这张图是什么？（选填）';
      cap.className = 'gal-cap';
      cap.addEventListener('input', () => {
        item.caption = cap.value;
      });

      const meta = document.createElement('figcaption');
      meta.className = 'form-hint gal-meta';
      meta.textContent = `${item.w}×${item.h} · ${Math.round(item.blob.size / 1024)} KB`;

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn gal-del';
      del.textContent = '移除这张';
      del.addEventListener('click', () => {
        URL.revokeObjectURL(item.url);
        galleryItems.splice(idx, 1);
        renderGalleryList();
        updateGalleryStatus();
      });

      card.append(img, cap, meta, del);
      galleryList.append(card);
    });
  }

  galleryInput?.addEventListener('change', async () => {
    const files = [...(galleryInput.files ?? [])];
    if (!files.length) return;
    errEl.hidden = true;
    if (galleryStatus) galleryStatus.textContent = `正在压缩 ${files.length} 张…`;
    for (const file of files) {
      try {
        const r = await buildGalleryImage(file);
        galleryItems.push({
          blob: r.blob,
          ext: r.ext,
          w: r.w,
          h: r.h,
          caption: '',
          url: URL.createObjectURL(r.blob),
        });
      } catch (err) {
        showError(`${file.name}：${err instanceof Error && err.message ? err.message : '处理失败'}`);
      }
    }
    /* 清空控件，这样同一张图还能再选一次（比如刚移除了想加回来） */
    galleryInput.value = '';
    renderGalleryList();
    updateGalleryStatus();
  });

  /** 提交成功后统一的展示（文本 / 封面 / 图片集共用；图片集一次会拿到多个编号） */
  function showSuccess(idOrIds: number | number[], extra: string) {
    const ids = (Array.isArray(idOrIds) ? idOrIds : [idOrIds]).filter((n) => Number.isFinite(n) && n > 0);
    const head = ids.length > 1
      ? `编号 <strong>${ids.join('、')}</strong>（共 ${ids.length} 条）`
      : `编号 <strong>${ids[0] ?? '—'}</strong>`;
    form.hidden = true;
    resultEl.hidden = false;
    resultEl.innerHTML =
      `<h2>提交成功 ✅</h2>` +
      `<p class="form-ok">${head} —— 请记下它，可以回来查审核状态。</p>` +
      `<p class="form-hint">${extra}</p>`;
    const qid = document.getElementById('q-id') as HTMLInputElement;
    if (qid) qid.value = String(ids[ids.length - 1] ?? '');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.hidden = true;

    const field = fieldSel.value;
    const note = (document.getElementById('f-note') as HTMLTextAreaElement).value;
    const submitter = (document.getElementById('f-submitter') as HTMLInputElement).value;
    const contact = (document.getElementById('f-contact') as HTMLInputElement).value;
    const backLink =
      `站长审核通过后会随下一批一起写回仓库并自动重建，通常几分钟内就会出现在 ` +
      `<a href="/maps/${slug}/">《${mapInfo?.title}》的条目</a> 里。`;

    /* 封面走 multipart 上传接口 —— 值是一张压好的图，不是文本 */
    if (field === 'cover') {
      if (!coverBlob) return showError('先选一张图片，等它压好之后再提交。');
      submitBtn.disabled = true;
      submitBtn.textContent = '上传中…';
      try {
        const fd = new FormData();
        fd.append('map', slug);
        fd.append('cover', coverBlob, `cover.${coverExt}`);
        fd.append('note', note);
        fd.append('submitter', submitter);
        fd.append('contact', contact);
        const res = await fetch('/api/submit-cover', { method: 'POST', body: fd });
        const data = (await res.json()) as { ok?: boolean; id?: number; error?: string };
        if (!data.ok) throw new Error(data.error || '上传失败');
        showSuccess(Number(data.id), `审核通过后封面会替换成这张。${backLink}`);
      } catch (err) {
        showError(err instanceof Error && err.message ? err.message : '上传失败，请稍后再试');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '提交';
      }
      return;
    }

    /* 图片集走 multipart，**一张一条投稿**：中途失败就停下，把已经成功的那些从列表里挪走，
       免得再点提交时重复投一遍（重复投不会出错，但会在队列里多出一条一样的）。 */
    if (field === 'gallery') {
      if (!galleryItems.length) return showError('先选图片，等它们压好之后再提交。');
      submitBtn.disabled = true;
      const ids: number[] = [];
      try {
        for (let i = 0; i < galleryItems.length; i++) {
          const item = galleryItems[i];
          submitBtn.textContent = `上传中…（${i + 1}/${galleryItems.length}）`;
          if (galleryStatus) galleryStatus.textContent = `正在上传第 ${i + 1}/${galleryItems.length} 张…`;
          const fd = new FormData();
          fd.append('map', slug);
          fd.append('image', item.blob, `gallery.${item.ext}`);
          fd.append('caption', item.caption);
          fd.append('note', note);
          fd.append('submitter', submitter);
          fd.append('contact', contact);
          const res = await fetch('/api/submit-gallery', { method: 'POST', body: fd });
          const data = (await res.json()) as { ok?: boolean; id?: number; error?: string };
          if (!data.ok) throw new Error(`第 ${i + 1} 张没成功：${data.error || '上传失败'}`);
          ids.push(Number(data.id));
        }
        showSuccess(
          ids,
          `审核通过后这些图会出现在《${mapInfo?.title}》条目底部的「图片集」里。${backLink}`
        );
      } catch (err) {
        for (let i = ids.length - 1; i >= 0; i--) {
          URL.revokeObjectURL(galleryItems[i].url);
          galleryItems.splice(i, 1);
        }
        renderGalleryList();
        updateGalleryStatus();
        showError(
          (ids.length ? `已成功的 ${ids.length} 张（编号 ${ids.join('、')}）已进审核队列；` : '') +
            (err instanceof Error && err.message ? err.message : '上传失败，请稍后再试')
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '提交';
      }
      return;
    }

    const value = collect(field);
    const checked = validateValue(field, value);
    if (!checked.ok) return showError(checked.error);

    /* 正在修订某一条已通过的社区投稿（点过「修订这条」）：带上它的 id，
       审核通过后是替换那一条的正文，而不是再加一条。 */
    const reviseOf = reviseTarget && reviseTarget.field === field ? reviseTarget.id : '';

    submitBtn.disabled = true;
    submitBtn.textContent = '提交中…';
    try {
      const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          map: slug,
          field,
          value: checked.value,
          note,
          submitter,
          contact,
          ...(reviseOf ? { reviseOf } : {}),
        }),
      });
      const data = (await res.json()) as { ok?: boolean; id?: number; error?: string };
      if (!data.ok) throw new Error(data.error || '提交失败');
      if (reviseOf) {
        /* 修订稿也进了队列，但面板上的正文要等审核通过、重建后才变 ——
           这里先退出修订状态，免得投稿人接着改同一条又投一遍。 */
        reviseTarget = null;
        renderReviseBar();
      }
      showSuccess(
        Number(data.id),
        reviseOf
          ? `这是一条<b>修订</b>稿：审核通过后会替换原来的那一条（署名不变）。${backLink}`
          : backLink
      );
    } catch (err) {
      showError(err instanceof Error && err.message ? err.message : '提交失败，请稍后再试');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '提交';
    }
  });

  /* 审核状态查询 */
  const qOut = document.getElementById('q-out') as HTMLElement;
  document.getElementById('q-go')?.addEventListener('click', async () => {
    const id = (document.getElementById('q-id') as HTMLInputElement).value.trim();
    if (!id) {
      qOut.textContent = '请先填编号。';
      return;
    }
    qOut.textContent = '查询中…';
    try {
      const res = await fetch(`/api/submission?id=${encodeURIComponent(id)}`);
      const data = (await res.json()) as {
        ok?: boolean;
        status?: string;
        field?: string;
        reject_note?: string;
        error?: string;
      };
      if (!data.ok) throw new Error(data.error || '查不到');
      const label: Record<string, string> = {
        pending: '待审核',
        applied: '已通过并上线',
        rejected: '未通过',
        approved: '已通过，等待发布',
      };
      qOut.textContent = `编号 ${id}：${label[data.status ?? ''] ?? data.status}` +
        (data.reject_note ? `　理由：${data.reject_note}` : '');
    } catch (err) {
      qOut.textContent = err instanceof Error ? err.message : '查询失败';
    }
  });

  /* ============ 下面都是纯视觉增强，逻辑仍以 select / input 为准 ============
     共同点：**不改任何提交数据**，只是让界面好点用点。任何一段挂了都不影响提交。 */

  /*
   * 字段快捷按钮：把「要提交哪一项」那个下拉框变成一排按钮。
   * 选择结果仍然写回 #f-field 并派发 change —— 后续逻辑（显示对应块、预填现值）完全不用改。
   */
  {
    const chips = document.getElementById('field-chips');
    const sel = document.getElementById('f-field') as HTMLSelectElement | null;
    if (chips && sel) {
      const sync = () => {
        for (const b of chips.querySelectorAll<HTMLButtonElement>('button')) {
          b.classList.toggle('on', b.dataset.v === sel.value);
          b.setAttribute('aria-pressed', String(b.dataset.v === sel.value));
        }
      };
      for (const opt of [...sel.options]) {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.v = opt.value;
        b.textContent = opt.textContent ?? opt.value;
        b.title = rules[opt.value]?.hint ?? '';
        b.addEventListener('click', () => {
          sel.value = opt.value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          sync();
        });
        chips.append(b);
      }
      sel.addEventListener('change', sync);
      /* 有按钮了就把原生下拉框视觉上藏起来（保留在 DOM 里：键盘可达、无 JS 时也能用） */
      sel.closest('.form-row')?.classList.add('has-chips');
      sync();
    }
  }

  /*
   * 拖拽上传：文件直接拖到虚线框里就行。
   * 靠 DataTransfer 把文件塞回原来的 file input 再派发 change ——
   * 压缩 / 预览 / 上传那套逻辑一行都不用动。
   */
  for (const zone of document.querySelectorAll<HTMLElement>('.drop-zone')) {
    const input = zone.querySelector<HTMLInputElement>('input[type="file"]');
    if (!input) continue;
    const stop = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
    };
    for (const ev of ['dragenter', 'dragover', 'dragleave', 'drop']) zone.addEventListener(ev, stop);
    zone.addEventListener('dragenter', () => zone.classList.add('is-over'));
    zone.addEventListener('dragover', () => zone.classList.add('is-over'));
    zone.addEventListener('dragleave', () => zone.classList.remove('is-over'));
    zone.addEventListener('drop', (e) => {
      zone.classList.remove('is-over');
      const files = (e as DragEvent).dataTransfer?.files;
      if (!files || !files.length) return;
      input.files = files;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
    /* 选完文件后把文件名显示在框里（**不动标题那行说明**，只更新 .dz-files） */
    input.addEventListener('change', () => {
      const names = [...(input.files ?? [])].map((f) => f.name);
      const filesEl = zone.querySelector<HTMLElement>('.dz-files');
      if (filesEl) filesEl.textContent = names.join('、');
      zone.classList.toggle('has-file', names.length > 0);
    });
  }
</script>
