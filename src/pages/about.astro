---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMaps } from '../lib/maps';
import QqGroup from '../components/QqGroup.astro';
// 构建期导入（由打包器按模块图解析，与运行时工作目录无关）
import catalog from '../../public/entity/catalog.json';
import { BAKED_SOURCE } from '../../shared/entity-source.mjs';

const maps = await getMaps();
const withEntities = maps.filter((m) => m.data.entitySlug).length;
const withSubs = maps.filter((m) => (m.data.workshopSubs ?? 0) > 0).length;
const stub = maps.filter((m) => m.data.stub).length;
const entities = maps.reduce((a, m) => a + (m.data.entityCount ?? 0), 0);

// 实体预览工具覆盖的范围。站内只收僵尸逃跑（ZE）图，预览工具的条目与地图条目一一对应。
// 数字来自 public/entity/catalog.json（与预览工具同一份数据），用 import 在构建期读入：
// 不要改成 fs.readFile('public/...')——相对路径依赖 cwd，Cloudflare 适配器预渲染时
// cwd 变成 /bundle，会直接构建失败（2026-09-23 线上部署失败的根因）。
const allMaps = catalog.count;
const bakedMaps = catalog.maps.filter((m) => m.source === BAKED_SOURCE).length;
---

<BaseLayout title="关于 | ZE 地图资料站" description="ZE 地图资料站：僵尸逃跑地图中文资料库，数据来源与说明。">
  <section class="hero" style="padding: 70px 0 30px;">
    <div class="container">
      <h1 class="hero-title" style="font-size: clamp(32px, 5vw, 52px);">
        关于<span class="gradient-text">本站</span>
      </h1>
      <p class="hero-sub">ZE 地图资料站，由社区维护。</p>
    </div>
  </section>

  <div class="container" style="padding-bottom: 60px;">
    <div class="sidebar-card" style="max-width: 780px;">
      <h3>这是什么</h3>
      <p>
        一个收录 Zombie Escape（僵尸逃跑）地图的中文资料库，包含背景故事、通关流程、神器攻略，
        以及一个可交互的<b>实体预览</b>工具（3D / 平面双视图查看传送门、可破坏物、机关、危险区等点位）。
      </p>

      <h3>本站的性质</h3>
      <p>
        由社区共同维护的兴趣项目，<b>纯粹为爱发电</b>：没有任何商业目的——不接商业推广、不做付费内容、
        不卖数据，也没有变现的打算。唯一的想法是让刚接触僵尸逃跑的萌新先看懂一张图：
        它讲什么、路怎么走、神器在哪，然后再进服务器去玩。
      </p>
      <p>
        本站目前仍在<b>初期</b>：不少条目还标注「资料待补充」，功能与数据也都在长。
        欢迎更多人来一起完善它——补一张图的资料、纠正一处错误、加一个功能，都算数。
        不会用 GitHub 也没关系，<a href="/contribute/">投稿页</a>里有不需要账号的网页投稿路径。
      </p>
      <p>
        社区补充的内容走<b>人工审核</b>：投稿先进队列，站长审核通过后写进站点仓库，
        再自动重新构建上线——所以改动不会立刻出现在页面上，通常要等几分钟。
        审核通过的内容会署上投稿人留的昵称。
      </p>

      <h3>现在收录了什么</h3>
      <ul>
        <li>地图条目 <b>{maps.length}</b> 张（僵尸逃跑），其中 <b>{withEntities}</b> 张带实体预览</li>
        <li>这些条目的实体数据合计 <b>{entities.toLocaleString('en-US')}</b> 个</li>
        <li><b>{withSubs}</b> 张关联到 Steam 创意工坊条目（含发布时间与订阅数）</li>
        <li>其中 <b>{stub}</b> 张仍标注「资料待补充」——剧情、作者、难度、攻略等欢迎社区补全</li>
        <li>
          <a href="/preview/">实体预览工具</a>覆盖其中 <b>{allMaps}</b> 张、合计
          <b>{catalog.meta.entities_all.toLocaleString('en-US')}</b> 个实体；
          没有实体数据的图（例如工坊已下架、地图包内没有实体定义）会在该图条目里写明原因。
        </li>
      </ul>

      <h3>数据来源</h3>
      <ul>
        <li>
          <b>实体数据</b>：{bakedMaps} 张从 Steam 创意工坊地图包解析；其余保留已入库的历史服务端实体快照。
          坐标为 Source 单位；有模型碰撞壳的实体使用真实包围盒，无包围盒的实体使用典型尺寸。
        </li>
        <li><b>工坊信息</b>：Steam Web API（发布时间、更新时间、订阅数、作者自述正文摘录）。</li>
        <li>
          <b>难度</b>：分档（入门 / 简单 / 普通 / 困难 / 火星 / 入土）与取值<b>源于 FYS（风云社）</b>的服务器地图列表，
          已获社区同意标注来源；不同服务器的口径可能不同，若有出入以对应服务器为准。
        </li>
        <li>
          <b>神器 / 道具、BOSS 与曲目</b>：公开的服务器配置（entwatch / bosshud / musicname）解析结果，
          逐条标注取自哪份配置，可能与其它服务器不一致。
        </li>
        <li><b>攻略资料</b>：社区检索整理，每篇尽量附来源链接；查不到的字段宁缺勿假。</li>
      </ul>

      <h3>版权</h3>
      <p>
        地图版权归原作者所有，本站仅做整理与攻略。工坊自述内容以摘录形式引用并标注出处，
        完整内容请前往对应的 Steam 创意工坊页面查看。
      </p>
      <p>
        <b>视频</b>：条目里的攻略视频都是<b>嵌入原平台的官方播放器</b>（bilibili / YouTube），
        本站<b>不转存、不下载、不剪辑、不加自己的贴片</b>；播放、弹幕、播放量与收益都留在原平台，归原 UP 主。
        点击播放之前不会向第三方发任何请求。视频只作介绍与辅助说明之用，
        版权归原 UP 主；署名以原平台的作者信息为准。
      </p>
      <p>
        <b>图片</b>：封面与图片集里的图是<b>转存的展示用图</b> —— 封面多为作者在创意工坊上传的预览图，
        图片集里是社区投稿的游戏内截图，都只用于识别地图与展示样貌，版权归原作者。
        图片以 webp 压缩后存放，不做二次创作，也不用于任何商业用途。
      </p>
      <p>
        <b>不想被本站收录？</b>地图、图片、视频都一样：<b>跟我们说一声就撤，不需要理由</b>。
        可以在 <a href="/contribute/">投稿页</a> 留话、QQ 群里说，或在 GitHub 仓库提 issue；
        撤下之后条目里不会再出现，并在
        <a href="https://github.com/hhjjdsj/ze-map-site/blob/main/docs/takedowns.md" target="_blank" rel="noopener">下架记录</a>
        里留一条说明，避免以后又被误收回来。
      </p>

      <h3>特别感谢</h3>
      <div
        style="border:1px solid var(--border); border-left:3px solid var(--accent); border-radius:10px; padding:16px 20px; margin:8px 0 20px; background:rgba(255,77,77,0.05);"
      >
        <p style="margin-top:0;">
          本站最有价值的那部分内容，几乎全靠别人铺路。这里必须单独致谢。
        </p>
        <p>
          <b>Source2Viewer（s2v）</b>——开源的 Source 2 资源解析工具。
          本站的实体预览与 3D 地形，靠它从创意工坊地图包里解出实体定义、模型与真实碰撞壳；
          没有这个工具，这两块功能都无从谈起。
        </p>
        <p style="margin-bottom:0;">
          另外，本站建站早期入库过一份第三方公开的服务端实体 dump，这部分历史数据至今原样保留，
          条目里只写中性的来源说明。再次向 <b>Source2Viewer</b> 致以诚挚谢意。
          本站只是站在别人铺好的路上，做了一点整理工作。
        </p>
      </div>

      <h3>致谢</h3>
      <ul>
        <li><b>3D 地图查看功能</b>由 <b>emmmm</b> 完成。</li>
        <li>
          <b>GitHub 贡献者</b>：
          <a href="https://github.com/SolsticeStarry" target="_blank" rel="noopener">SolsticeStarry</a>（3D 预览增强、实体 / 地形烘焙管线、内容管线重构）、
          <a href="https://github.com/trrrr-ai" target="_blank" rel="noopener">trrrr-ai</a>（SiKi，多张地图的背景故事、难度与视频资料）、
          <a href="https://github.com/xianoom" target="_blank" rel="noopener">xianoom</a>（地图难度订正）。
          名单见仓库的
          <a href="https://github.com/hhjjdsj/ze-map-site/graphs/contributors" target="_blank" rel="noopener">贡献者页面</a>。
        </li>
        <li>地图资料与攻略由社区检索整理，站点由社区共同维护。</li>
      </ul>

      <h3>联系与反馈</h3>
      <ul>
        <li><b>站长</b>：宇宙机器人（ZE 游戏 ID），QQ <b>3157410575</b>，可联系。</li>
        <li>
          <b>QQ 群</b>：<QqGroup /> —— 投稿、报错、问神器怎么用都可以在群里说；
          想直接看进度、催更也欢迎。
        </li>
        <li>
          发现错误或想补充资料，可到 <a href="/contribute/">投稿页</a> 查看投稿方式，
          或在 GitHub 仓库 <a href="https://github.com/hhjjdsj/ze-map-site" target="_blank" rel="noopener">hhjjdsj/ze-map-site</a> 提 issue / PR。
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>
