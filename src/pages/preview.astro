---
/*
 * 3D 地图预览直接使用云朵小铺的 preview3d.html 原版实现。
 *
 * 原页面自带完整的 HTML/CSS/JavaScript/WebGL 渲染器和实体数据，
 * 地形分包则从本站的 /terr/<工坊 ID>.bin 按需加载。
 * 网站的 entitySlug 形如 2001-ze_xxx-<版本 ID>，这里转换成原页面
 * 使用的地图内部名，保证地图详情页的深链仍然可以直接打开对应地图。
 */
const requested = Astro.url.searchParams.get('map') ?? '';
const map = requested
  .replace(/^\d+-/, '')
  .replace(/-\d+$/, '');
const query = new URLSearchParams(Astro.url.searchParams);
if (map) query.set('map', map);
const previewUrl = `/preview3d.html${query.toString() ? `?${query.toString()}` : ''}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>地图实体预览 · ZE 地图资料站</title>
    <style>
      html,
      body,
      iframe {
        width: 100%;
        height: 100%;
        margin: 0;
        border: 0;
        display: block;
      }

      body {
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <iframe
      src={previewUrl}
      title="地图实体预览"
      allow="fullscreen"
    ></iframe>
  </body>
</html>
