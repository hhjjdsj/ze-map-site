---
/*
 * 3D 地图预览直接使用云朵小铺的 preview3d.html 原版实现。
 *
 * 原页面自带完整的 HTML/CSS/JavaScript/WebGL 渲染器和实体数据，
 * 地形分包则从本站的 /terr/<工坊 ID>.bin 按需加载。
 *
 * 站点是 static 输出（无 adapter），Astro.url 在构建期不含查询串，
 * 因此 ?map= 的解析放到浏览器端：把 entitySlug 转成原页面认识的
 * 地图内部名后再设置给 iframe，保证地图详情页深链能打开对应地图。
 */
const site = Astro.site ?? new URL('https://ze-map.cn');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/images/hero-bg.jpg', site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>地图实体预览 · ZE 地图资料站</title>
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZE 地图资料站" />
    <meta property="og:title" content="地图实体预览 · ZE 地图资料站" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <style>
      html,
      body,
      iframe {
        width: 100%;
        height: 100%;
        margin: 0;
        border: 0;
        display: block;
      }

      body {
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <iframe id="preview-frame" src="/preview3d.html" title="地图实体预览" allow="fullscreen"></iframe>
    <script is:inline>
      (function () {
        try {
          var q = new URLSearchParams(location.search);
          var m = q.get('map') || '';
          /* entitySlug 形如 2001-ze_xxx-<工坊ID>；已传入内部名时原样保留 */
          if (/^\d+-/.test(m)) {
            m = m.replace(/^\d+-/, '').replace(/-\d+$/, '');
          }
          if (m) q.set('map', m);
          var qs = q.toString();
          var frame = document.getElementById('preview-frame');
          if (frame) frame.src = '/preview3d.html' + (qs ? '?' + qs : '');
        } catch (e) {}
      })();
    </script>
  </body>
</html>
