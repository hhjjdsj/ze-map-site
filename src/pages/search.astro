---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMaps } from '../lib/maps';
import { DIFFICULTIES, DIFFICULTY_CLASS } from '../../shared/difficulty.mjs';

const maps = await getMaps();
const researched = maps.filter((m) => !m.data.stub).length;

/*
 * 下拉框的取值必须和 src/pages/maps/[...slug].astro 里 data-pagefind-filter 的
 * **值逐字一致** —— Pagefind 的筛选是精确字符串匹配，差一个字就是 0 条结果。
 * 所以两边都从同一份定义取：难度用 shared/difficulty.mjs，游戏沿用地图库那份列表。
 */
const difficulties = DIFFICULTIES;
const games = ['CS2', 'CS:GO', 'CS:S'];
const DATA_KINDS = ['已有攻略资料', '资料待补充'];
---

<BaseLayout
  title="站内搜索 | ZE 地图资料站"
  description={`搜索 ${maps.length} 张僵尸逃跑地图的条目、攻略、神器与关卡内容。`}
>
  <section class="hero" style="padding: 70px 0 24px;">
    <div class="container">
      <h1 class="hero-title" style="font-size: clamp(32px, 5vw, 52px);">
        <span class="gradient-text">站内</span>搜索
      </h1>
      <p class="hero-sub">
        全文检索 {maps.length} 张地图条目（其中 {researched} 张含攻略资料）——地图名、剧情、神器、BOSS、关卡流程都能搜
      </p>
    </div>
  </section>

  <div class="container" style="padding-bottom: 70px;">
    <div class="filter-bar">
      <input id="pf-q" type="search" placeholder="搜索地图名、剧情、神器、BOSS、作者…" autocomplete="off" />
      <select id="pf-difficulty" title="按难度筛选">
        <option value="">全部难度</option>
        {difficulties.map((d) => <option value={d}>{d}</option>)}
      </select>
      <select id="pf-game" title="按游戏筛选">
        <option value="">全部游戏</option>
        {games.map((g) => <option value={g}>{g}</option>)}
      </select>
      <select id="pf-data" title="按资料完整度筛选">
        <option value="">全部条目</option>
        {DATA_KINDS.map((k) => <option value={k}>{k}</option>)}
      </select>
    </div>

    <p class="list-count" id="pf-count">输入关键词开始搜索，或直接选上面的难度 / 分类筛选</p>

    <div id="pf-results" class="pf-results"></div>

    <button class="load-more" id="pf-more" type="button" style="display:none">显示更多</button>

    {/*
      宽松匹配：Pagefind 把中文按字索引，搜「后室」它会连「惊魂实验室」这种
      「后」「室」分开的页面一起返回。默认**不显示**这些，只在这里折叠着，
      由用户自己决定要不要看（2026-10-07 站长的要求：搜后室就必须是连在一起的）。

      data-pagefind-ignore：这段说明文字里举了「后室」当例子，不忽略的话
      本页自己会被搜「后室」搜出来（真的发生过），跟地图抢位置。
    */}
    <div id="pf-relaxed-box" data-pagefind-ignore style="display:none; margin-top: 26px">
      <button class="load-more" id="pf-relaxed-go" type="button"></button>
      <p class="form-hint" id="pf-relaxed-note" style="margin-top:8px; display:none">
        下面这些页面里<strong>并没有连着出现</strong>你搜的词，只是这些字分别出现过
        （比如搜某个词时，命中的其实是「实验<u>室</u>」和「最<u>后</u>」两个字）。列在这里仅供参考。
      </p>
      <div id="pf-relaxed" class="pf-results" data-pagefind-ignore style="display:none"></div>
    </div>

    <div id="pf-empty" class="empty-state" style="display:none; margin-top: 24px;">
      <p><b id="pf-empty-text">没有找到相关内容。</b></p>
      <p style="font-size: 13px">换个关键词试试，或者放宽上面的筛选条件。</p>
      <p><button class="load-more" id="pf-reset" type="button">清空全部条件</button></p>
    </div>

    <div id="pf-fallback" class="empty-state" style="display:none; margin-top: 24px;">
      <p><b>搜索索引尚未生成。</b></p>
      <p style="font-size: 13px">
        开发模式（<code>npm run dev</code>）下没有索引，这是正常的；跑一次 <code>npm run build</code> 就会在
        <code>dist/pagefind/</code> 生成索引，再用 <code>npm run preview</code> 打开本页即可搜索。
      </p>
    </div>

    <div id="pf-config" hidden data-diff-class={JSON.stringify(DIFFICULTY_CLASS)}></div>

    {/* data-pagefind-ignore：这张提示卡里写着「魔晄炉」「米纳斯」等示例词，
        不忽略的话本页自己会跑进这些词的搜索结果里，跟真正的地图抢位置。 */}
    <div class="sidebar-card" style="max-width: 780px; margin-top: 26px;" data-pagefind-ignore>
      <h3>搜索小提示</h3>
      <ul class="sidebar-hint" style="list-style: none; padding: 0">
        <li>· 搜地图名：<code>魔晄炉</code>、<code>米纳斯</code>、<code>ze_mako</code></li>
        <li>· 搜题材：<code>最终幻想</code>、<code>黑暗之魂</code>、<code>我的世界</code></li>
        <li>· 搜玩法：<code>神器</code>、<code>BOSS</code>、<code>长征</code>、<code>滑翔</code></li>
        <li>· 搜作者：<code>Hannibal</code>、<code>Ayano</code>、<code>气流</code></li>
        <li>· 只想按难度 / 分类翻：关键词留空，直接选上面的筛选就行</li>
      </ul>
    </div>
  </div>
</BaseLayout>

{/*
  为什么不用 Pagefind 自带的默认 UI（pagefind-ui.js）：
  它在「关键词为空」时不出任何结果，所以「只想按难度翻地图」做不到 —— 而这正是
  大家在地图库里习惯的用法。改成直接调 Pagefind 的 JS API（pagefind.search(null, {filters})），
  空关键词也能按筛选列出结果。

  另：这里是 is:inline，Astro 不会编译也不做变量替换，写的是原样的浏览器 JS（不要写 TS 语法）。
*/}
<script is:inline>
  (function () {
    var PER_PAGE = 20;

    var byId = function (id) {
      return document.getElementById(id);
    };
    var input = byId('pf-q');
    var selDiff = byId('pf-difficulty');
    var selGame = byId('pf-game');
    var selData = byId('pf-data');
    var listEl = byId('pf-results');
    var countEl = byId('pf-count');
    var emptyEl = byId('pf-empty');
    var emptyTextEl = byId('pf-empty-text');
    var fbEl = byId('pf-fallback');
    var moreBtn = byId('pf-more');
    var resetBtn = byId('pf-reset');
    var cfgEl = byId('pf-config');
    var relaxedBox = byId('pf-relaxed-box');
    var relaxedBtn = byId('pf-relaxed-go');
    var relaxedEl = byId('pf-relaxed');
    var relaxedNote = byId('pf-relaxed-note');

    var diffClass = {};
    try {
      diffClass = JSON.parse(cfgEl.getAttribute('data-diff-class') || '{}');
    } catch (e) {
      diffClass = {};
    }

    var pf = null;
    var timer = null;
    var seq = 0; // 防止慢的旧搜索覆盖快的新结果
    var shown = PER_PAGE;
    /** 一次最多核对多少条 Pagefind 结果（每条要取一次分片，中文单字查询可能几百条） */
    var MAX_SCAN = 100;

    /* 三类结果分开存：图名/标签命中、正文连续命中（这两个才算"搜到"）、宽松命中（折叠） */
    var idxMaps = [];
    var idxTags = [];
    var exactRows = [];
    var relaxedRows = [];

    function currentFilters() {
      var f = {};
      if (selDiff.value) f['难度'] = selDiff.value;
      if (selGame.value) f['游戏'] = selGame.value;
      if (selData.value) f['资料'] = selData.value;
      return f;
    }

    function filterText() {
      var parts = [];
      if (selDiff.value) parts.push('难度 ' + selDiff.value);
      if (selGame.value) parts.push('游戏 ' + selGame.value);
      if (selData.value) parts.push(selData.value);
      return parts.join(' · ');
    }

    function anyCondition() {
      return input.value.trim() !== '' || Object.keys(currentFilters()).length > 0;
    }

    /* 把当前条件写进地址栏：这样「火星难度的地图」这类筛选结果可以直接分享 / 收藏 */
    function syncUrl() {
      var p = new URLSearchParams();
      var term = input.value.trim();
      if (term) p.set('q', term);
      if (selDiff.value) p.set('d', selDiff.value);
      if (selGame.value) p.set('g', selGame.value);
      if (selData.value) p.set('t', selData.value);
      var s = p.toString();
      history.replaceState(null, '', s ? location.pathname + '?' + s : location.pathname);
    }

    function clearAll() {
      input.value = '';
      selDiff.value = '';
      selGame.value = '';
      selData.value = '';
      run();
      input.focus();
    }

    function makeRow(d) {
      var row = document.createElement('div');
      row.className = 'pf-result';

      var a = document.createElement('a');
      a.className = 'pf-result-title';
      a.href = d.url;
      a.textContent = (d.meta && d.meta.title) || d.url;
      row.appendChild(a);

      var path = document.createElement('div');
      path.className = 'pf-result-path';
      path.textContent = d.url;
      row.appendChild(path);

      if (d.excerpt) {
        var ex = document.createElement('p');
        ex.className = 'pf-result-excerpt';
        ex.innerHTML = d.excerpt; // Pagefind 生成的摘录，只额外带 <mark>
        row.appendChild(ex);
      }

      var badges = document.createElement('div');
      badges.className = 'pf-result-badges';
      var diff = d.filters && d.filters['难度'] && d.filters['难度'][0];
      if (diff) {
        var b = document.createElement('span');
        b.className = 'badge ' + (diffClass[diff] || '');
        b.textContent = diff;
        badges.appendChild(b);
      }
      var game = d.filters && d.filters['游戏'] && d.filters['游戏'][0];
      if (game) {
        var g = document.createElement('span');
        g.className = 'badge';
        g.textContent = game;
        badges.appendChild(g);
      }
      if (badges.childNodes.length) row.appendChild(badges);

      return row;
    }

    /* ===== 图名 / 标签索引 + 连续词（短语）匹配 =====
     *
     * 两个问题，一个方案（都靠构建期生成的 /search/maps.json，几十 KB，第一次搜索时拉）：
     *
     * 1. Pagefind 的中文分词对短词组不可靠。实测（2026-09-24）：
     *    · 搜「指环王」→ 7 条，**标题就叫《指环王：米那斯提力斯》的那张图一条都不在**，
     *      返回的是正文里出现过「指」的页面（摘要里高亮的是「指挥」「指引」）
     *    · 但那一页正文里「指环王」出现 9 次、h1 就是它；单搜「指」它排第 1，「王」排第 5
     *    换排序参数救不了（因为问题出在「匹不匹配」，不是「排第几」），所以自己兜一层：
     *    中文名 / 英文名 / 标签里**连续包含**查询词的地图直接置顶并标出命中原因。
     *
     * 2. **连续词匹配只能自己算**。Pagefind 不支持引号短语（产物里没有任何 phrase 相关代码），
     *    中文按字索引，于是搜「后室」会把「惊魂实验室」这种「后」「室」分开的页面也算命中：
     *    2026-10-07 实测 20 条结果里只有 8 条真的连着。data() 带整页正文（content），
     *    所以这里逐个核对，不连续的丢进「宽松匹配」折叠区。
     */
    var indexPromise = null;
    var MAP_INDEX = [];
    var TAG_INDEX = [];

    function loadIndex() {
      if (!indexPromise) {
        indexPromise = fetch('/search/maps.json')
          .then(function (r) {
            return r.json();
          })
          .then(function (d) {
            MAP_INDEX = (d && d.maps) || [];
            TAG_INDEX = (d && d.tags) || [];
          })
          .catch(function () {
            MAP_INDEX = [];
            TAG_INDEX = [];
          });
      }
      return indexPromise;
    }

    /** 归一化：全角转半角 + 小写 + 去掉零宽空格（Pagefind 的正文里可能残留） */
    function normalize(s) {
      return String(s == null ? '' : s)
        .normalize('NFKC')
        .replace(/\u200B/g, '')
        .toLowerCase();
    }

    /** 查询分词：按空白切开（地图内部名里的下划线在 run() 里已经换成空格） */
    function queryTokens(term) {
      return normalize(term)
        .split(/\s+/)
        .filter(function (t) {
          return t.length > 0;
        });
    }

    /** 每个词都必须在正文里**连着**出现一次（多词 = AND，不是"字都在就行"） */
    function phraseHit(content, tokens) {
      var hay = normalize(content);
      for (var i = 0; i < tokens.length; i++) {
        if (hay.indexOf(tokens[i]) === -1) return false;
      }
      return true;
    }

    /**
     * 连续子串打分：完全相同 3 / 以它开头 2 / 中间包含 1，**没命中 -1**。
     * ⚠️ **没命中必须返回 -1**（不能返回 0）：调用方只判 `> 0`，
     * 拿 0 当"没命中"会把整站地图都算成命中（2026-10-07 实测：搜「后室」多出
     * 2021圣诞世界 / 阿波罗 这类按拼音排的假条目）。
     */
    function scoreOf(value, q) {
      var at = value.indexOf(q);
      if (at === -1) return -1;
      return value === q ? 3 : at === 0 ? 2 : 1;
    }

    /**
     * 命中排名：**先看命中在哪个字段（中文名 3 > 英文名 2 > 标签 1），再看命中方式**
     * （完全相同 3 > 开头 2 > 包含 1）。返回 null = 三处都没连续命中。
     *
     * 为什么用两层而不是加权总分：单值打分容易倒挂 —— 试过「标签完全相同 60 分」压过
     * 「标题包含 52 分」，于是搜「后室」时「池塘」（只是打了标签）排在「逃离后室」前面。
     * 层级的规则一句话说得清，也不会再出现这种意外。
     */
    function hitRank(m, q) {
      var best = null;
      var consider = function (rank, value, tag) {
        var match = scoreOf(value, q);
        if (match <= 0) return;
        if (!best || rank > best.rank || (rank === best.rank && match > best.match)) {
          best = { rank: rank, match: match, tag: tag || '' };
        }
      };
      consider(3, normalize(m.t));
      consider(2, normalize(m.e));
      var g = m.g || [];
      for (var i = 0; i < g.length; i++) consider(1, normalize(g[i]), g[i]);
      return best;
    }

    /** 在索引里找图名 / 标签命中（同样只认连续子串） */
    function indexHits(q) {
      var nq = normalize(q);
      var maps = [];
      var tags = [];
      if (!nq) return { maps: maps, tags: tags };

      for (var i = 0; i < MAP_INDEX.length; i++) {
        var m = MAP_INDEX[i];
        var hit = hitRank(m, nq);
        if (hit) maps.push({ m: m, rank: hit.rank, match: hit.match, tag: hit.tag });
      }
      maps.sort(function (a, b) {
        return (
          b.rank - a.rank ||
          b.match - a.match ||
          String(a.m.t).localeCompare(String(b.m.t), 'zh')
        );
      });

      for (var k = 0; k < TAG_INDEX.length; k++) {
        var t = TAG_INDEX[k];
        var s = scoreOf(normalize(t.n), nq);
        if (s > 0) tags.push({ t: t, score: s });
      }
      tags.sort(function (a, b) {
        return b.score - a.score || b.t.c - a.t.c;
      });

      return { maps: maps.slice(0, 10), tags: tags.slice(0, 4) };
    }

    var TAG_CHIPS = 12; // 标签行里最多列几张地图（更多的去标签页看）

    /** 置顶那一行：数据来自索引，带「图名匹配」/「#标签」标记 */
    function makeIndexRow(hit) {
      var it = hit.m;
      var url = '/maps/' + it.s + '/';
      var row = document.createElement('div');
      row.className = 'pf-result pf-result-exact';

      var a = document.createElement('a');
      a.className = 'pf-result-title';
      a.href = url;
      a.textContent = it.t;
      row.appendChild(a);

      var path = document.createElement('div');
      path.className = 'pf-result-path';
      path.textContent = url + (it.e ? '　·　' + it.e : '');
      row.appendChild(path);

      var badges = document.createElement('div');
      badges.className = 'pf-result-badges';
      var mark = document.createElement('span');
      mark.className = 'badge exact';
      mark.textContent = hit.tag ? '标签「' + hit.tag + '」' : '图名匹配';
      badges.appendChild(mark);
      if (it.d) {
        var b = document.createElement('span');
        b.className = 'badge ' + (diffClass[it.d] || '');
        b.textContent = it.d;
        badges.appendChild(b);
      }
      row.appendChild(badges);

      return row;
    }

    /** 标签命中：一行说明「这个标签有几张图」，再跟一排地图链接（连续匹配，天然精确） */
    function makeTagRow(hit) {
      var row = document.createElement('div');
      row.className = 'pf-result pf-result-exact';

      var a = document.createElement('a');
      a.className = 'pf-result-title';
      a.href = '/tags/' + encodeURIComponent(hit.t.n) + '/';
      a.textContent = '🏷️ ' + hit.t.n;
      row.appendChild(a);

      var path = document.createElement('div');
      path.className = 'pf-result-path';
      path.textContent = '/tags/' + hit.t.n + '/　·　共 ' + hit.t.c + ' 张地图';
      row.appendChild(path);

      var chips = document.createElement('div');
      chips.className = 'pf-result-badges';
      var n = 0;
      for (var i = 0; i < MAP_INDEX.length && n < TAG_CHIPS; i++) {
        var m = MAP_INDEX[i];
        if (!m.g || m.g.indexOf(hit.t.n) === -1) continue;
        var c = document.createElement('a');
        c.className = 'badge pf-tagchip';
        c.href = '/maps/' + m.s + '/';
        c.textContent = m.t;
        chips.appendChild(c);
        n++;
      }
      if (n < hit.t.c) {
        var more = document.createElement('span');
        more.className = 'badge';
        more.textContent = '还有 ' + (hit.t.c - n) + ' 张 →';
        chips.appendChild(more);
      }
      row.appendChild(chips);

      return row;
    }

    async function run() {
      var mine = ++seq;
      try {
        if (!anyCondition()) {
          listEl.innerHTML = '';
          emptyEl.style.display = 'none';
          moreBtn.style.display = 'none';
          relaxedBox.style.display = 'none';
          countEl.textContent = '输入关键词开始搜索，或直接选上面的难度 / 分类筛选';
          syncUrl();
          return;
        }

        // ⚠️ 下划线必须换成空格再送去搜。
        // 实测（2026-09-24，Pagefind 1.5.2，中文索引）：查询里出现下划线时，
        // Pagefind 会把下划线**后面的词整段丢掉** ——
        //     ze_mako            → 806 条（等于是只搜了 ze，全站几乎全中）
        //     ze_ffvii_mako_reactor → 806 条（输完整地图名照样废）
        //     ze mako            →   9 条，目标地图排第 1 ✅
        // 而站内所有地图的内部名都是 ze_xxx 这种写法，正是最主流的搜法。
        // 连字符 / 点 / 冒号都正常（ze-mako、ze.mako 都是 9 条），所以只换下划线。
        var typed = input.value.trim();
        var term = typed.replace(/_/g, ' ');
        var tokens = queryTokens(term);
        // 单个字不做连续判定：一个字的"连续"没有意义，只会白白削弱召回
        var strict = tokens.join('').length >= 2;
        syncUrl();
        shown = PER_PAGE;
        countEl.textContent = '搜索中…';
        relaxedBox.style.display = 'none';
        relaxedEl.style.display = 'none';
        relaxedEl.innerHTML = '';

        // 关键词为空时传 null：Pagefind 会只按筛选条件列出全部匹配页
        var res = await pf.search(term || null, { filters: currentFilters() });
        if (mine !== seq) return;

        // 图名 / 标签命中（连续匹配，天然精确）
        await loadIndex();
        if (mine !== seq) return;
        var hits = typed ? indexHits(typed) : { maps: [], tags: [] };
        idxMaps = hits.maps;
        idxTags = hits.tags;

        var indexUrls = {};
        for (var ti = 0; ti < idxMaps.length; ti++) indexUrls['/maps/' + idxMaps[ti].m.s + '/'] = 1;
        /* 标签行已经把它列出来了，Pagefind 那边同一条（标签页本身）就别再出现一次 */
        var tagUrls = {};
        for (var tj = 0; tj < idxTags.length; tj++) {
          var tn = idxTags[tj].t.n;
          tagUrls['/tags/' + tn + '/'] = 1;
          tagUrls['/tags/' + encodeURIComponent(tn) + '/'] = 1;
        }

        /*
         * 逐条核对 Pagefind 的结果是不是**真的连着**出现了查询词。
         * 为什么要自己核：Pagefind 中文按字索引，也不支持引号短语（产物里没有 phrase 代码），
         * 搜「后室」会把「惊魂实验室」这类页面也返回（2026-10-07 实测 20 条里 12 条是假的）。
         * data() 里带整页正文（content），不用额外请求；中文单字查询可能有几百条结果，
         * 所以只核对前 MAX_SCAN 条（排序靠前的那些），够填满一页还有富余。
         */
        var total = res.results.length;
        var scan = res.results.slice(0, MAX_SCAN);
        var datas = await Promise.all(
          scan.map(function (r) {
            return r.data();
          })
        );
        if (mine !== seq) return;

        exactRows = [];
        relaxedRows = [];
        for (var i = 0; i < datas.length; i++) {
          var d = datas[i];
          if (indexUrls[d.url] || tagUrls[d.url]) continue; // 已经在图名 / 标签那一组里了
          if (!strict || phraseHit(d.content || d.excerpt || '', tokens)) exactRows.push(d);
          else relaxedRows.push(d);
        }
        var unscanned = Math.max(0, total - MAX_SCAN);

        var ft = filterText();
        var exactTotal = idxMaps.length + exactRows.length;
        var msg;
        if (typed) {
          if (exactTotal === 0) {
            msg =
              '没有页面连着出现「' +
              typed +
              '」这些字' +
              (relaxedRows.length ? '　下方有 ' + relaxedRows.length + ' 条相近结果（这些字分别出现过）' : '');
          } else {
            var bits = [];
            if (idxTags.length) bits.push('标签 ' + idxTags.length + ' 个');
            if (idxMaps.length) bits.push('图名匹配 ' + idxMaps.length + ' 张');
            bits.push('正文连续命中 ' + exactRows.length + ' 条');
            msg = '找到 ' + exactTotal + ' 条与「' + typed + '」相关的结果（' + bits.join(' · ') + '）';
            if (relaxedRows.length) msg += '　另有 ' + relaxedRows.length + ' 条只是字分别出现';
            if (unscanned) msg += '　（' + unscanned + ' 条未核对）';
          }
        } else {
          msg = '符合条件的有 ' + (exactRows.length || total) + ' 条';
        }
        if (ft) msg += '（' + ft + '）';
        countEl.textContent = msg;

        var nothing = exactTotal === 0;
        if (nothing && relaxedRows.length === 0) {
          listEl.innerHTML = '';
          moreBtn.style.display = 'none';
          emptyTextEl.textContent = typed ? '没有找到「' + typed + '」相关的内容' : '没有符合这些条件的内容';
          emptyEl.style.display = '';
          return;
        }
        emptyEl.style.display = 'none';

        listEl.innerHTML = '';
        for (var a1 = 0; a1 < idxTags.length; a1++) listEl.appendChild(makeTagRow(idxTags[a1]));
        for (var a2 = 0; a2 < idxMaps.length; a2++) listEl.appendChild(makeIndexRow(idxMaps[a2]));
        var body = exactRows.slice(0, shown);
        for (var a3 = 0; a3 < body.length; a3++) listEl.appendChild(makeRow(body[a3]));

        /* 精确结果一条都没有时说明白点，别让人以为搜索坏了 */
        if (nothing) {
          var tip = document.createElement('p');
          tip.className = 'list-count';
          tip.textContent = typed
            ? '没有页面连着出现「' + typed + '」这些字 —— 下面是分别出现的相近结果。'
            : '没有符合这些条件的内容。';
          listEl.appendChild(tip);
        }

        moreBtn.style.display = exactRows.length > shown ? '' : 'none';

        /*
         * 宽松匹配折叠区：默认收起。这是「后」「室」分别出现的那批 ——
         * 不是用户要的结果，但直接扔掉会让「拼错一个字母」的搜索变成 0 条，
         * 所以留着，让人自己决定看不看。
         */
        if (relaxedRows.length) {
          relaxedBtn.textContent = '显示 ' + relaxedRows.length + ' 条「字分别出现」的相近结果 ▾';
          relaxedBox.style.display = '';
          relaxedNote.style.display = 'none';
          relaxedBtn.setAttribute('aria-expanded', 'false');
        } else {
          relaxedBox.style.display = 'none';
        }
      } catch (e) {
        if (mine === seq) {
          listEl.innerHTML = '';
          moreBtn.style.display = 'none';
          relaxedBox.style.display = 'none';
          emptyTextEl.textContent = '搜索出错了：' + (e && e.message ? e.message : e);
          emptyEl.style.display = '';
        }
      }
    }

    /** 展开 / 收起「宽松匹配」那一批 */
    function toggleRelaxed() {
      var open = relaxedEl.style.display === 'none';
      if (open && !relaxedEl.childNodes.length) {
        for (var i = 0; i < relaxedRows.length; i++) relaxedEl.appendChild(makeRow(relaxedRows[i]));
      }
      relaxedEl.style.display = open ? '' : 'none';
      relaxedNote.style.display = open ? '' : 'none';
      relaxedBtn.textContent =
        (open ? '收起这 ' : '显示 ') + relaxedRows.length + ' 条「字分别出现」的相近结果 ' + (open ? '▴' : '▾');
      relaxedBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function loadMore() {
      if (!pf) return;
      shown += PER_PAGE;
      run();
    }

    input.addEventListener('input', function () {
      if (!pf) return;
      if (timer) clearTimeout(timer);
      timer = setTimeout(run, 250); // 跟手，但别一个字一次搜索
    });
    [selDiff, selGame, selData].forEach(function (s) {
      s.addEventListener('change', run);
    });
    moreBtn.addEventListener('click', loadMore);
    resetBtn.addEventListener('click', clearAll);
    relaxedBtn.addEventListener('click', toggleRelaxed);

    async function boot() {
      try {
        pf = await import('/pagefind/pagefind.js');
      } catch (e) {
        pf = null;
      }
      if (!pf || typeof pf.search !== 'function') {
        fbEl.style.display = '';
        input.disabled = true;
        selDiff.disabled = true;
        selGame.disabled = true;
        selData.disabled = true;
        return;
      }
      // 提前把图名 / 标签索引拉起来（第一次搜索时就不用等它了）
      loadIndex();

      var sp = new URLSearchParams(location.search);
      if (sp.get('q')) input.value = sp.get('q');
      if (sp.get('d')) selDiff.value = sp.get('d');
      if (sp.get('g')) selGame.value = sp.get('g');
      if (sp.get('t')) selData.value = sp.get('t');
      run();
    }

    boot();
  })();
</script>
