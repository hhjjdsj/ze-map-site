---
/**
 * 「新增地图 / 最新更新 / 工坊热门」三个页面共用的标签栏。
 * 三个页面各自是独立 URL（可以单独分享、被搜索收录），但看起来是一组标签。
 *
 * 三个链接写 target="_self"：全站默认 `<base target="_blank">`（站内跳转一律新开标签页），
 * 但**标签栏**要是也新开标签就荒谬了 —— 点一下多一个标签、旧的还停在那儿，
 * 完全不像「切换」。2026-10-08 站长要求改成同标签页丝滑切换，
 * 页面之间的转场由 global.css 的跨文档 View Transitions 负责（那一段有注释）。
 */
interface Props {
  active: 'new' | 'updates' | 'hot';
}

const { active } = Astro.props;

const tabs = [
  { key: 'new', href: '/new/', label: '新增地图', hint: '最近 30 天工坊发布的图' },
  { key: 'updates', href: '/updates/', label: '最新更新', hint: '最近 30 天资料被补充过的图' },
  { key: 'hot', href: '/hot/', label: '工坊热门', hint: '按工坊订阅数排行' },
];
---

<nav class="list-tabs" aria-label="地图动态">
  {
    tabs.map((t) => (
      <a
        class={`list-tab${active === t.key ? ' is-active' : ''}`}
        href={t.href}
        target="_self"
        title={t.hint}
        aria-current={active === t.key ? 'page' : undefined}
      >
        {t.label}
      </a>
    ))
  }
</nav>
