---
/**
 * 左图右文的图文块（教程 / 攻略里用）。
 *
 * 作者不写这个组件 —— 写的是纯文本约定 `:::figure 2 right`：
 *   · 原稿 guides[] 里 → 生成器（shared/guide-blocks.mjs）转成这个组件；
 *   · 社区投稿正文 → GuideNote 组件解析后渲染这个组件。
 * 图来源是这张图的**图片集**（data/gallery/<slug>.json，图片在 R2），序号从 1 开始。
 *
 * 序号越界（作者写错、图还没传）时**不报错**：只渲染文字 + 一句提示，
 * 免得一篇教程因为一张图没传就整页渲染不出来。
 */
import { galleryFor } from '../lib/gallery';

interface Props {
  slug: string;
  n: number;
  side?: 'left' | 'right';
}

const { slug, n, side = 'left' } = Astro.props;
const images = galleryFor(String(slug));
const img = Number.isFinite(n) && n >= 1 ? images[n - 1] : undefined;
const cls = `guide-figure${side === 'right' ? ' is-right' : ''}`;
---

{
  img ? (
    <figure class={cls}>
      <div class="gf-media">
        <img src={img.src} alt={img.caption || `${slug} 第 ${n} 张图`} loading="lazy" decoding="async" />
        {img.caption && (
          <figcaption class="gf-cap">
            {img.caption}
            {img.by ? ` · 由 ${img.by} 提供` : ''}
          </figcaption>
        )}
      </div>
      <div class="gf-body">
        <slot />
      </div>
    </figure>
  ) : (
    <div class="gf-missing">
      <slot />
      <p class="gf-warn">
        ⚠ 教程里引用了图片集第 <b>{n}</b> 张图，但这张图还没有（当前共 {images.length} 张）。
        到 <a href={`/submit/?map=${slug}`}>投稿页</a>传图后，序号按图片集里的顺序从 1 数。
      </p>
    </div>
  )
}
