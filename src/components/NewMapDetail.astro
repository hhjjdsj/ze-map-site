<script>
  function initNewToc() {
    const toc = document.querySelector('[data-new-toc]');
    const toggle = document.getElementById('new-toc-toggle');
    if (!toc || !toggle) return;
    const label = toggle.querySelector('.new-toc-toggle-text');
    const apply = (collapsed) => {
      toc.dataset.collapsed = collapsed ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', String(!collapsed));
      if (label) label.textContent = collapsed ? '展开' : '收起';
    };
    let collapsed = false;
    try {
      collapsed = localStorage.getItem('ze-new-toc-collapsed') === '1';
    } catch {
      /* 隐私模式 / 禁用 localStorage：默认展开即可 */
    }
    apply(collapsed);
    toggle.addEventListener('click', () => {
      collapsed = !collapsed;
      apply(collapsed);
      try {
        localStorage.setItem('ze-new-toc-collapsed', collapsed ? '1' : '0');
      } catch {
        /* 存不了就只在本次页面生效 */
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNewToc);
  else initNewToc();
</script>
