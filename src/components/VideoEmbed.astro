---
/**
 * 视频嵌入 —— **点击才加载播放器**（门面 / facade 模式）。
 *
 * 为什么不直接把 iframe 放上去：
 *   1. B 站播放器会自己开始播 —— 一张挂了 5~9 个视频的条目，打开就是好几个同时在响；
 *   2. 每个 iframe 都是几百 KB 的第三方播放器脚本，9 个视频的首屏要多拉好几 MB；
 *   3. 还没看就先给 B 站 / YouTube 发请求、留 cookie，没必要。
 * 所以先渲染一块「播放键」门面，点击才把 iframe 插进来，并带 `autoplay=1` ——
 * 这一次点击本身就是明确的播放意图，不会再出现「莫名其妙自己响」。
 *
 * 门面本身是 `<a href=原视频>`：
 *   - 没 JS 时点它 = 在原站打开，不会变成点不动的死按钮；
 *   - 中键 / Ctrl / Cmd / Shift / Alt + 点击照常开新标签（脚本只接管普通左键）。
 *
 * 只有 B 站和 YouTube 能嵌播放器（这是它们提供的 iframe 播放器接口决定的）。
 * 其它站点的链接**不再硬塞进 iframe** —— 那会渲染出一个加载失败的空框，
 * 看起来像站坏了。改成渲染一张可点的链接卡。
 *
 * 这个 fallback 是给社区投稿兜底的：投稿表单只校验「是合法的 https 链接」，
 * 不限制站点，所以一定会有人投来别的站。宁可显示成链接，也不要显示成坏框。
 */
interface Props {
  url: string;
  title?: string;
}

const { url, title = '' } = Astro.props;

let embedUrl: string | null = null;
let platform = 'other';

if (url.includes('bilibili.com')) {
  platform = 'bilibili';
  const bvMatch = url.match(/BV[\w]+/);
  const avMatch = url.match(/av(\d+)/i);
  if (bvMatch) {
    embedUrl = `https://player.bilibili.com/player.html?bvid=${bvMatch[0]}&high_quality=1&danmaku=0`;
  } else if (avMatch) {
    embedUrl = `https://player.bilibili.com/player.html?aid=${avMatch[1]}&high_quality=1&danmaku=0`;
  }
} else if (url.includes('youtube.com') || url.includes('youtu.be')) {
  platform = 'youtube';
  const idMatch = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  if (idMatch) {
    embedUrl = `https://www.youtube.com/embed/${idMatch[1]}`;
  }
}

/* 拿不到播放器地址就退化成链接（例如 B 站短链、或别的视频站） */
const canEmbed = Boolean(embedUrl);
const platformLabel = platform === 'bilibili' ? 'bilibili' : platform === 'youtube' ? 'YouTube' : '外部站点';
const label = title || '视频';
/*
 * 视频编号：交给页面上那段脚本去 /api/video-meta 换标题与 UP 主名。
 * 为什么不在构建期写死：UP 主信息按站长要求不进仓库（2026-10-10 的决定），
 * 而线上构建不联网 —— 只能由浏览器问我们自己的 Worker（见 worker/videos.ts）。
 */
const vid = (() => {
  if (platform === 'bilibili') {
    return url.match(/BV[\w]+/)?.[0] ?? (url.match(/av(\d+)/i) ? `av${url.match(/av(\d+)/i)![1]}` : '');
  }
  if (platform === 'youtube') return url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/)?.[1] ?? '';
  return '';
})();
---

{
  canEmbed ? (
    <figure
      class="video-embed"
      data-platform={platform}
      data-embed={embedUrl}
      data-title={label}
      data-vid={vid || undefined}
    >
      <div class="video-frame">
        <a class="video-play" href={url} target="_blank" rel="noopener" aria-label={`点击播放：${label}`}>
          <span class="vp-btn" aria-hidden="true">
            ▶
          </span>
          <span class="vp-label">点击播放</span>
          <span class="vp-meta">
            {platformLabel} · 播放器在点击后才加载
          </span>
          {/* 加载成功后填「UP 主：xxx」；拿不到就一直是空的，不留占位 */}
          <span class="vp-up" data-vp-up hidden />
        </a>
      </div>
      {/* 手写资料给了标题就直接显示；没给的等接口回来填（填不上就空着） */}
      <figcaption data-vp-title hidden={!title}>{title}</figcaption>
      <a class="video-source" href={url} target="_blank" rel="noopener">
        在原站打开 ↗
      </a>
    </figure>
  ) : (
    <p class="video-plain">
      <a href={url} target="_blank" rel="noopener">
        ▶ {title || `打开视频（${platform === 'other' ? '外部站点' : platform}）`} ↗
      </a>
    </p>
  )
}

<script>
  /*
   * 点击门面 → 把 iframe 插进 .video-frame。
   * 用事件委托：整页只装一个监听器，多个视频共用；Astro 会把这段脚本按页去重打包一次。
   */
  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('.video-play') : null;
    if (!link) return;
    /* 只接管普通左键：修饰键 / 中键仍走浏览器默认行为（新标签打开原视频） */
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const fig = link.closest('.video-embed');
    const src = fig && fig.dataset ? fig.dataset.embed : null;
    if (!fig || !src) return;
    event.preventDefault();
    const frame = fig.querySelector('.video-frame');
    if (!frame || frame.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = src + (src.indexOf('?') >= 0 ? '&' : '?') + 'autoplay=1';
    iframe.title = fig.dataset.title || '视频';
    iframe.allowFullscreen = true;
    /*
     * 关键尺寸在这里也写一份（对应样式里的 :global(iframe)）。
     * 原因：Astro 的 scoped CSS 只作用于模板里的元素，JS 新建的 iframe 不带
     * data-astro-cid-* 属性 —— 一旦上面那条样式被改回带作用域的形式，iframe 会
     * 静默缩成默认的 300×150，看着就像「视频只有一小块」。行内样式不会被作用域影响，
     * 相当于给这条样式上了一道保险；两处都改才可能失效。
     */
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
    iframe.setAttribute(
      'allow',
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
    );
    frame.replaceChildren(iframe);
    fig.classList.add('playing');
  });

  /*
   * ===== 补标题与 UP 主名 =====
   *
   * 数据来自我们自己的 Worker（/api/video-meta → B 站公开接口 + KV 缓存 30 天），
   * 不是 B 站直连：B 站的接口没有 CORS 也不支持 JSONP，浏览器根本取不到；
   * 走自己的域名还顺带避免了「看一眼页面就把你的 IP 交给 B 站」。
   *
   * 三条原则：
   *   1. **一页只发一次请求**（把这一页所有视频编号拼起来），拿不到就静默保持现状；
   *   2. 手写资料里已经写了标题的**不覆盖**；
   *   3. 绝不显示占位假数据 —— 没拿到就什么都不填。
   */
  const figures = [...document.querySelectorAll<HTMLElement>('.video-embed[data-vid]')];
  if (figures.length) {
    const ids = [...new Set(figures.map((f) => f.dataset.vid).filter(Boolean))];
    if (ids.length) {
      fetch(`/api/video-meta?bvs=${encodeURIComponent(ids.join(','))}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((data: { items?: Record<string, { t?: string; u?: string; m?: string }> } | null) => {
          const items = data?.items;
          if (!items) return;
          for (const fig of figures) {
            const meta = items[fig.dataset.vid ?? ''];
            if (!meta) continue;
            const titleEl = fig.querySelector<HTMLElement>('[data-vp-title]');
            const upEl = fig.querySelector<HTMLElement>('[data-vp-up]');
            if (titleEl && !titleEl.textContent?.trim() && meta.t) {
              titleEl.textContent = meta.t;
              titleEl.hidden = false;
              /* 无障碍与播放器标题也跟上（iframes 的 title 属性） */
              fig.dataset.title = meta.t;
            }
            if (upEl && meta.u) {
              /* 有 UID 就做成回他主页的链接：署名不只是写个名字，也把流量还给他 */
              upEl.textContent = '';
              const label = document.createTextNode(`UP 主：${meta.u}`);
              if (meta.m) {
                const a = document.createElement('a');
                a.href = `https://space.bilibili.com/${meta.m}`;
                a.target = '_blank';
                a.rel = 'noopener';
                a.textContent = meta.u;
                upEl.append(document.createTextNode('UP 主：'), a);
              } else {
                upEl.append(label);
              }
              upEl.hidden = false;
            }
          }
        })
        .catch(() => {
          /* 接口挂了 / 离线：保持原样，不打扰读者 */
        });
    }
  }
</script>

<style>
  .video-embed {
    margin: 20px 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .video-embed:hover {
    border-color: var(--border-2);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  /*
   * ⚠️ 这里必须用 :global(iframe)。
   * Astro 的 scoped CSS 会把选择器变成 `.video-frame[data-astro-cid-x] iframe[data-astro-cid-x]`，
   * 要求 iframe **自己也带那个属性** —— 而点击后插进来的 iframe 是 JS 新建的、拿不到属性，
   * 这条规则就整条不匹配，iframe 退回浏览器默认的 300×150 缩在左上角
   * （2026-09-25 上线后被抓到：「点开以后视频只有屏幕的十分之一」）。
   * JS 那边还写了一份关键尺寸兜底，见脚本里的注释。
   */
  .video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* 门面：点击前显示的那一块（点击后整块被 iframe 替换掉） */
  .video-play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    text-align: center;
    text-decoration: none;
    color: #dde2ee;
    background:
      radial-gradient(120% 130% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 62%),
      linear-gradient(180deg, #171a24, #0b0d14);
    transition: background 0.25s;
  }

  .video-play:hover {
    background:
      radial-gradient(120% 130% at 50% 0%, rgba(255, 255, 255, 0.12), transparent 62%),
      linear-gradient(180deg, #1c2029, #0d1017);
  }

  .vp-btn {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    padding-left: 4px;
    border-radius: 50%;
    font-size: 22px;
    color: #fff;
    background: var(--accent, #ff4d4d);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s;
  }

  .video-play:hover .vp-btn {
    transform: scale(1.07);
  }

  .vp-label {
    font-size: 15px;
    font-weight: 600;
  }

  .vp-meta {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* 「UP 主：xxx」：接口回来才有（拿不到就不显示，不留空行） */
  .vp-up {
    padding: 2px 10px;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    font-size: 12px;
    color: #dde2ee;
    background: rgba(255, 255, 255, 0.06);
  }

  /* 署名做成回 UP 主主页的链接：点一下就把人送回他那儿 */
  .vp-up a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px dotted rgba(255, 255, 255, 0.45);
  }

  .vp-up a:hover {
    color: var(--accent-2);
    border-bottom-color: var(--accent-2);
  }

  /* 兜底：万一脚本没走到 replaceChildren，也别让门面盖在播放器上 */
  .video-embed.playing .video-play {
    display: none;
  }

  figcaption {
    padding: 12px 16px 0;
    font-size: 14px;
    color: #dde2ee;
  }

  .video-source {
    display: inline-block;
    padding: 8px 16px 14px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }

  .video-source:hover {
    color: var(--accent-2);
  }

  /* 不能嵌入时的链接卡 */
  .video-plain {
    margin: 10px 0;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .video-plain a {
    color: var(--accent-2);
  }
</style>
