---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';
import QqGroup from '../components/QqGroup.astro';

interface Props {
  title?: string;
  description?: string;
  /** 分享预览图（相对路径或绝对 URL） */
  image?: string;
}

const {
  title = 'ZE 地图资料站',
  description = '僵尸逃跑地图中文资料库 · 背景故事 · 通关流程 · 神器攻略',
  image,
} = Astro.props;

const site = Astro.site ?? new URL('https://ze-map.cn');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = image ? new URL(image, site).href : new URL('/images/hero-bg.jpg', site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      「站内跳转一律新开标签页」——2026-10-07 站长的要求：可以连着点好几张地图，
      每张都留在自己的标签里，方便来回对照，不用一路按返回。
      一行覆盖全站所有 <a>：页头导航、地图卡片、标签、搜索结果（Pagefind 的链接是 JS 建的，
      也一样吃这套）、分页、页脚，以及以后新加的链接 —— 不用在每个组件里记得写 target。

      ⚠️ 三个必须知道的点：
      1. **不含 href**：只写 target。带上 href 会把相对 URL 的基准改掉，全站链接会一起错。
         （所以相对路径仍然按页面地址解析，行为不变。）
      2. **同一个页面的锚点要豁免**：`<a href="#form">` 这类目录跳转会被它变成「新开一个
         同样的页面」而不是滚动，所以那种链接逐个写了 target="_self"（见 contribute.astro、
         index.astro 的「向下滚动」、preview.astro 的诊断链接）。
      3. **noopener**：`<base>` 没法给链接加 rel，而 target="_blank" 的 noopener 早就是
         浏览器的默认行为（Chrome 88 / Firefox 79 / Safari 12.1 起），所以新标签拿不到
         window.opener，没有安全缺口；已有的外链仍显式写着 rel="noopener"。

      另外：`<base target>` 也会作用于**没有 target 属性的原生 <form>**提交，本站唯一的
      `<form>`（投稿表单）是 JS 接管 + fetch 提交的，不走原生提交，所以不受影响。
    */}
    <base target="_blank" />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZE 地图资料站" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <div class="bg-grid"></div>
    <div class="bg-glow"></div>

    <header class="site-header" data-pagefind-ignore>
      <div class="container header-inner">
        {/*
          logo 是唯一的例外之一：它**同标签页**回主页（2026-10-08 站长的要求）——
          「点站标 = 回首页/刷新」，开新标签反而会攒出一堆首页。
          例外之二是三个列表标签栏（见 components/MapListTabs.astro）。
        */}
        <a href="/" class="logo" target="_self">
          <span class="logo-mark">ZE</span>
          <span class="logo-text">地图资料站</span>
        </a>

        <SearchBox />

        <button id="menu-toggle" class="menu-toggle" aria-label="菜单">
          <span></span><span></span><span></span>
        </button>

        <nav class="main-nav" id="main-nav">
          <a href="/maps/">地图库</a>
          <a href="/preview/">实体预览</a>
          {/*
            这里原本还有一个「搜索」导航项 —— 2026-10-07 撤掉：页头已经有常驻搜索框
            （components/SearchBox.astro），再留一个跳 /search/ 的入口就是重复。
            结果页依然可达：在搜索框里打字回车 / 直接回车（空关键词会进带筛选的搜索页），
            另外 404 页也留了一个「🔍 站内搜索」的入口。
          */}
          <a href="/tags/">标签</a>
          <a href="/contribute/">投稿</a>
          <a href="/about/">关于</a>
        </nav>

        <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
          <span class="theme-icon-dark">🌙</span>
          <span class="theme-icon-light">☀️</span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer" data-pagefind-ignore>
      <div class="container">
        <p>ZE 地图资料站 · 由社区维护 · 地图版权归原作者所有</p>
        <p class="footer-qq"><QqGroup /></p>
      </div>
    </footer>

    {/*
      这段脚本**不要**改回 is:inline。
      is:inline 会让 Astro 把脚本原样输出、不做 TypeScript 转译：只要里面混进 TS 语法
      （例如 `e.target as HTMLElement`），浏览器会因语法错误让**整段脚本都不执行**——
      曾经因此导致「太阳/月亮」主题按钮与移动端「三条横杠」菜单同时点击无反应。
      交给 Astro 处理（默认行为）则会剥掉类型，且语法错误会在构建期就报出来。
      上面 head 里的主题预置脚本必须保留 is:inline（要在首屏绘制前跑，避免闪白），所以它只写纯 JS。
    */}
    <script>
      // 主题切换
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      // 移动端菜单
      const menuToggle = document.getElementById('menu-toggle');
      const mainNav = document.getElementById('main-nav');

      menuToggle?.addEventListener('click', () => {
        mainNav?.classList.toggle('open');
      });

      // 点击导航链接后自动关闭菜单
      mainNav?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => mainNav.classList.remove('open'));
      });

      // 点击页面其他区域关闭菜单
      document.addEventListener('click', (e) => {
        if (!mainNav || !mainNav.classList.contains('open')) return;
        const target = e.target instanceof Node ? e.target : null;
        if (!target || mainNav.contains(target)) return;
        if (menuToggle?.contains(target)) return;
        mainNav.classList.remove('open');
      });
    </script>
  </body>
</html>