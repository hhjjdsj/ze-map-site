// Cloudflare Workers 部署配置（站点由 Astro 构建到 ./dist，Worker 脚本只处理 /api/*）
//
// 这个文件有几个作用，都别删：
//
// 1) 关掉 wrangler 的「自动配置」（autoconfig）。
//    仓库里没有 wrangler 配置文件时，`npx wrangler deploy` 会自作主张地执行
//    `astro add cloudflare`：装 @astrojs/cloudflare 适配器、改 astro.config.mjs、
//    再重跑一次 npm run build。适配器的预渲染工作目录是 /bundle，
//    任何依赖 cwd 的构建期读文件都会失败。
//    2026-09-23 的线上部署失败（Build #e80f3333）就是这么来的。
//    官方说明：https://developers.cloudflare.com/workers/framework-guides/automatic-configuration/
//
// 2) 让静态资源用 dist/404.html 兜底。
//    not_found_handling 默认是 none（未命中的路径返回空 body 的 404）。
//
// 3) previews 空块：给「Worker Previews」用的占位。
//    Cloudflare 的 Worker Previews（预览环境，走 `npx wrangler preview`）要求配置里
//    有 previews 段，纯顶层设置的项目留空即可。见
//    https://developers.cloudflare.com/workers/configuration/previews/
//
// 4) 社区难度投票（P1）—— main / binding / run_worker_first / d1_databases
//    main              Worker 脚本入口（wrangler 原生支持 TS，无需额外构建步骤）
//    assets.binding    让脚本能 env.ASSETS.fetch()，把非 /api/* 的请求**原样交回**
//                      静态资源。⚠️ 少了它就没法把未知路径交回 resources 层，
//                      站内那个 404 页会被顶掉。
//    run_worker_first  只有 /api/* 与 /terr/* 先走脚本。其余请求仍是官方的「静态资源优先」，
//                      所以 800 多个页面照旧由边缘直接发出，速度不受影响，
//                      脚本出问题也只是接口 500，站点照常访问。
//                      ⚠️ /terr/* 必须列在这里：资源层对未命中的路径会**直接吐 404 页**、
//                      不会再把请求交给 Worker（2026-10-05 实测：线上 /terr/xxx.bin 返回的是
//                      站内 404 页，同源回退因此形同虚设）。
//    d1_databases      投票数据（库名 ze-map-community）
//    设计与分期：docs/community-editing-plan.md
//
// 5) 投稿封面（B 方案）—— kv_namespaces
//    待审的封面图片先放 Workers KV 的 pending/ 前缀下（不公开可访问，只有审核台用鉴权接口能取），
//    审核台点「写回仓库」时由 Worker 把图提交进仓库 public/images/covers/custom/ 并删掉 KV 里的副本
//    （2026-10-05 起与文档改动合成同一个 commit，见 docs/community-editing-plan.md 的「攒批写回」）。
//    ⚠️ 选 KV 而不是 R2 的原因：KV 免费额度**不需要绑卡**（1 GB 存储 / 每天 1000 次写入），
//       而且 put 时能直接设 expirationTtl=30 天，传了没人审的图会自己过期。
//    ⚠️ id 必须填你在控制台建的 namespace id（KV 绑定不认名字，只认 id）：
//       Workers & Pages → KV → Create instance，名字随便（建议 ze-map-uploads），建完把 ID 贴到这里。
//    ⚠️ 没配这个绑定时，只有封面相关接口返回 503，站点和其它投稿不受影响。
//
// ⚠️ name 必须与线上 Worker 同名（ze-map-site），否则会新建一个 Worker，
//    自定义域名 ze-map.cn 不会跟过去。
// ⚠️ assets.directory 必须指向 ./dist，写错会导致整站没有静态资源。
// ⚠️ 部署前必须设置 secret：npx wrangler secret put IP_SALT
//    没设置时 /api/* 会返回 503 —— 这是故意的：盐写在公开仓库里等于没有盐，
//    别人可以拿它暴力枚举 IPv4 反查出投票者 IP。
{
  "name": "ze-map-site",
  "compatibility_date": "2026-09-23",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/terr/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ze-map-community",
      "database_id": "314ae078-618f-463d-b0e5-798b35386dbf"
    }
  ],
  "kv_namespaces": [
    {
      // 待审封面图（pending/<uuid>.<ext>，put 时设了 30 天过期）。
      // id 是控制台里那个 namespace 的 ID（KV 绑定只认 id，不认名字）。
      "binding": "UPLOADS",
      "id": "384e8441523d4da4bcc660f330f1bc2e"
    }
  ],
  // 地形分片的 R2 桶：只给 /terr/<id>.bin 这条**同源回退**用（见 worker/terr.ts）。
  // 正常情况下预览页直连 terr.ze-map.cn，不走这里；那个域不通的网络才落到这条路上。
  "r2_buckets": [
    {
      "binding": "TERR",
      "bucket_name": "ze-map-terr"
    }
  ],
  "previews": {}
}
