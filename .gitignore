**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# data/ 下：只入库「可审计、体积小」的中间数据；原始单文件与临时产物不入库
data/*
!data/research/
!data/workshop/
!data/creators.json
!data/gfl/
!data/gfl-parsed/
# 社区投稿落盘目录（P2）—— 审核通过后由 Worker 写入，必须入库，
# 否则构建期读不到，而且 git 也失去「内容变更史」的作用。
# ⚠️ 上面那条 data/* 会连它一起忽略，所以这行不能删。
!data/community/
# 检索代理留下的临时抓取目录（_ws / _imgs 等）
data/research/_*/
# 每张地图的「进站 / 最近改动」日期，由 scripts/content/build-map-dates.mjs 从 git 历史生成。
# 必须入库：线上构建若是浅克隆就读不到历史，页面要退回用这份清单，否则「最新更新」会一片空白。
!data/map-dates.json
# 地形分片清单（有哪些图在 R2 上有真实碰撞地形），由 npm run terr:upload 写。
# 必须入库：preview 页面要数「N 张带真实碰撞地形」，而分片本身已不在仓库里。
!data/terr-manifest.json
# 地图图片集清单（data/gallery/<slug>.json）—— 图片本身在 R2（gallery/ 前缀），
# 入库的只有这份几 KB 的清单；页面靠它渲染「图片集」。
# ⚠️ 上面那条 data/* 会连它一起忽略，所以这行不能删（community 踩过同一个坑）。
!data/gallery/
# 地图体积（MB，详情页侧栏那行「体积 ~194 MB」），由 npm run data:sizes 从 s2ze 的公开数据抓来。
# 必须入库：构建不联网（第三方接口挂掉不该让整站构建变红），运行时只读这份文件。
!data/map-sizes.json
# 哪些图**拿不到**实体数据、原因是什么（详情页据此解释「为什么没有实体预览」）。
# 必须入库：详情页直接 import 这个文件 —— 2026-10-09 忘了加这条白名单，
# 本机有文件、仓库里没有，Cloudflare 构建挂在 [UNRESOLVED_IMPORT]，
# 所以现在 npm run build 第一步会跑 scripts/content/check-build-inputs.mjs 拦这类错误。
!data/entity-status.json

# Astro 生成的类型与缓存（不要入库）
.astro/

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# wrangler：只忽略本地状态与密钥；wrangler.jsonc 必须入库
# （它负责关掉 deploy 时的 autoconfig，并配置 dist/404.html 兜底）
.wrangler/
.dev.vars*
!.dev.vars.example

# R2（地形分片搬到对象存储，见 docs/r2-migration.md）
# 凭证与本地同步状态绝不入库；data/terr-manifest.json 是给页面数张数用的，必须入库。
.env.r2
.r2-terr-state.json
# 图片集上传的本地同步状态（同 .r2-terr-state.json）
.r2-gallery-state.json
# 迁移完成后烘焙产物写到仓库外（不再进 dist、不再进 git 历史）
bake/
# 兜底：万一有机器还在往旧位置烘，也别再让它进仓库
public/terr/

# terr-bake：本地工具链与运行时产物，由 setup.ps1 生成，不入库
scripts/terr-bake/.tools/
scripts/terr-bake/bounds/
scripts/terr-bake/work/
# data/ 下的 capped/done/failed/bake-manifest 是入库的烘焙记录，由各机器共享，故意不忽略
scripts/terr-bake/incremental.txt
scripts/terr-bake/incremental-chunk.txt
scripts/terr-bake/baked-this-run.txt
scripts/terr-bake/engine.pid
