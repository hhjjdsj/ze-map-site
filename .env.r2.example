# 复制成 .env.r2 再填（.env.r2 已在 .gitignore 里，不会入库）
#
# 用法：npm run terr:upload -- --dry     先看要传什么
#       npm run terr:upload              增量上传
#
# Cloudflare 控制台 → 右上角头像 → My Profile → API Tokens → Create Token
#   用模板「Edit Cloudflare Workers」也可以，或自定义：
#     权限：Account · Workers R2 Storage · Edit
#     账户资源：你的账户
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 可选，默认就是 ze-map-terr
R2_BUCKET=ze-map-terr
